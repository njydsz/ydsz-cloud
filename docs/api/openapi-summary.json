{
  "openapi": "3.0.3",
  "info": {
    "title": "PMIS API 端点摘要",
    "version": "1.0.0",
    "description": "南京云顶 PMIS 后端 14 个微服务的端点摘要，供契约测试与文档检索使用\n每个服务通过 /v3/api-docs 暴露完整 OpenAPI 3 规范",
    "contact": {
      "name": "PMIS API Team",
      "email": "api-team@ydsz-pmis.cn"
    }
  },
  "servers": [
    { "url": "http://localhost:9000", "description": "API 网关（推荐）" },
    { "url": "http://localhost:9001", "description": "auth 直连" }
  ],
  "tags": [
    { "name": "gateway",   "description": "API 网关路由表" },
    { "name": "auth",      "description": "认证授权（ydsz-pmis-auth :9001）" },
    { "name": "user",      "description": "用户/权限/部门/资源池（ydsz-pmis-user :9002）" },
    { "name": "project",   "description": "商机/立项/合同/变更（ydsz-pmis-project :9005）" },
    { "name": "execution", "description": "执行/成本/财务/报表（ydsz-pmis-execution :9006）" },
    { "name": "agent",     "description": "AI 智能体（ydsz-pmis-agent :9007）" },
    { "name": "notification", "description": "通知中心（ydsz-pmis-notification :9003）" },
    { "name": "workflow",  "description": "工作流（ydsz-pmis-workflow :9004）" },
    { "name": "audit",     "description": "审计日志（ydsz-pmis-audit :9010）" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "R": {
        "type": "object",
        "properties": {
          "code":      { "type": "integer", "example": 0 },
          "message":   { "type": "string",  "example": "ok" },
          "data":      { "type": "object" },
          "traceId":   { "type": "string",  "example": "0a1b2c3d4e5f6789" },
          "timestamp": { "type": "integer", "example": 1735689600000 }
        }
      },
      "PageResult": {
        "type": "object",
        "properties": {
          "records": { "type": "array", "items": { "type": "object" } },
          "total":   { "type": "integer" },
          "current": { "type": "integer" },
          "size":    { "type": "integer" }
        }
      }
    }
  },
  "security": [ { "bearerAuth": [] } ],
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": ["auth"],
        "summary": "账号密码登录（5 QPS/IP/min 限流）",
        "security": [],
        "responses": { "200": { "description": "成功，返回 access_token + refresh_token" } }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "tags": ["auth"],
        "summary": "刷新 access_token（用 refresh_token）",
        "security": [],
        "responses": { "200": { "description": "成功" } }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": ["auth"],
        "summary": "登出（吊销当前 token）",
        "responses": { "200": { "description": "成功" } }
      }
    },
    "/api/v1/auth/2fa/bind": {
      "post": {
        "tags": ["auth"],
        "summary": "绑定 TOTP 双因素认证",
        "responses": { "200": { "description": "成功，返回 secret + qrcodeUrl + backupCodes" } }
      }
    },
    "/api/v1/auth/2fa/verify": {
      "post": {
        "tags": ["auth"],
        "summary": "校验 TOTP 动态口令（6 位）",
        "responses": { "200": { "description": "验证通过" } }
      }
    },
    "/api/v1/user/users": {
      "get": {
        "tags": ["user"],
        "summary": "用户分页查询",
        "parameters": [
          { "name": "page",     "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "size",     "in": "query", "schema": { "type": "integer", "default": 20 } },
          { "name": "deptId",   "in": "query", "schema": { "type": "integer" } },
          { "name": "status",   "in": "query", "schema": { "type": "string",  "enum": ["ACTIVE", "LOCKED", "DISABLED"] } }
        ],
        "responses": { "200": { "description": "PageResult<UserDO>" } }
      }
    },
    "/api/v1/user/roles": {
      "get": {
        "tags": ["user"],
        "summary": "角色分页查询",
        "responses": { "200": { "description": "PageResult<RoleDO>" } }
      },
      "post": {
        "tags": ["user"],
        "summary": "创建角色",
        "responses": { "200": { "description": "新角色 ID" } }
      }
    },
    "/api/v1/resource/pool": {
      "get": {
        "tags": ["user"],
        "summary": "资源池分页查询",
        "responses": { "200": { "description": "PageResult<ResourcePoolDO>" } }
      }
    },
    "/api/v1/resource/bench": {
      "get": {
        "tags": ["user"],
        "summary": "Bench 闲置人员分页",
        "responses": { "200": { "description": "PageResult<BenchRecordDO>" } }
      }
    },
    "/api/v1/project/opportunities": {
      "get": {
        "tags": ["project"],
        "summary": "商机分页查询",
        "responses": { "200": { "description": "PageResult<OpportunityDO>" } }
      },
      "post": {
        "tags": ["project"],
        "summary": "新建商机（A/B/C 级）",
        "responses": { "200": { "description": "新商机 ID" } }
      }
    },
    "/api/v1/project/opportunities/{id}/convert": {
      "post": {
        "tags": ["project"],
        "summary": "商机转立项（WON → Initiation）",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "立项 ID + 商机状态推进到 CONVERTED" } }
      }
    },
    "/api/v1/project/contracts": {
      "get": {
        "tags": ["project"],
        "summary": "合同分页查询",
        "responses": { "200": { "description": "PageResult<ContractDO>" } }
      },
      "post": {
        "tags": ["project"],
        "summary": "新建合同",
        "responses": { "200": { "description": "新合同 ID" } }
      }
    },
    "/api/v1/project/contracts/{id}/approve": {
      "post": {
        "tags": ["project"],
        "summary": "合同审批通过",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "成功" } }
      }
    },
    "/api/v1/project/changes/{id}/approve": {
      "post": {
        "tags": ["project"],
        "summary": "项目变更审批通过（5 因子权重 + 触发 EVM 基线重算）",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "成功 + EvmMeasureService.recalculateBaseline 异步触发" } }
      }
    },
    "/api/v1/execution/wbs-tasks": {
      "get": {
        "tags": ["execution"],
        "summary": "WBS 任务分页查询",
        "responses": { "200": { "description": "PageResult<WbsTaskDO>" } }
      },
      "post": {
        "tags": ["execution"],
        "summary": "新建 WBS 任务",
        "responses": { "200": { "description": "新任务 ID" } }
      }
    },
    "/api/v1/execution/time-entries/{id}/approve": {
      "post": {
        "tags": ["execution"],
        "summary": "工时审批（自动归集 8h/人天 × 800 元 人力成本）",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "成功 + cost_allocation 落库" } }
      }
    },
    "/api/v1/execution/invoices": {
      "get": {
        "tags": ["execution"],
        "summary": "开票分页查询",
        "responses": { "200": { "description": "PageResult<InvoiceDO>" } }
      },
      "post": {
        "tags": ["execution"],
        "summary": "新建开票申请（按 invoice_basis 自动校验：MILESTONE 需验收报告，OUTSOURCING 需人天单）",
        "responses": { "200": { "description": "新开票 ID" } }
      }
    },
    "/api/v1/execution/payments/{id}/allocate": {
      "post": {
        "tags": ["execution"],
        "summary": "回款核销（按 invoice_id 分摊，> unallocatedAmount 拒绝，自动 ALLOCATED 转换）",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "核销详情" } }
      }
    },
    "/api/v1/execution/import/template/{bizType}": {
      "get": {
        "tags": ["execution"],
        "summary": "下载空白导入模板（rate-card / rate-internal / time-entry）",
        "parameters": [
          { "name": "bizType", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "xlsx 字节流" } }
      }
    },
    "/api/v1/execution/import/{bizType}": {
      "post": {
        "tags": ["execution"],
        "summary": "批量导入（1 QPS/用户 限流，失败行明细返回）",
        "parameters": [
          { "name": "bizType", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "ImportResult{totalCount, successCount, failedCount, failures[]}" } }
      }
    },
    "/api/v1/execution/report-export/download": {
      "get": {
        "tags": ["execution"],
        "summary": "报表导出（XLSX / CSV，6 类报表通用）",
        "parameters": [
          { "name": "type",   "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "format", "in": "query", "schema": { "type": "string", "default": "XLSX", "enum": ["XLSX", "CSV"] } }
        ],
        "responses": { "200": { "description": "xlsx / csv 字节流" } }
      }
    },
    "/api/v1/execution/cockpit/overview": {
      "get": {
        "tags": ["execution"],
        "summary": "经营驾驶舱 6 KPI（activeProjects / totalContractAmount / confirmedRevenue / totalCost / grossProfit / grossMargin）",
        "responses": { "200": { "description": "CockpitKpiVO + EVM 健康分布 + Bench 闲置成本" } }
      }
    },
    "/api/v1/execution/cockpit/drill-down": {
      "get": {
        "tags": ["execution"],
        "summary": "驾驶舱下钻（department / projectType / customer 三维）",
        "responses": { "200": { "description": "CockpitDrillDownDTO" } }
      }
    },
    "/api/v1/execution/advanced/evm": {
      "get": {
        "tags": ["execution"],
        "summary": "EVM 挣值管理报表（项目健康仪表盘）",
        "responses": { "200": { "description": "EVM 6 大指标" } }
      }
    },
    "/api/v1/agent/run": {
      "post": {
        "tags": ["agent"],
        "summary": "执行 AI 智能体（RiskWarning / ResourceRecommend / ProfitForecast / WinRatePredict / TimesheetAnomaly）",
        "responses": { "200": { "description": "AgentResult{score, confidence, alertLevel, suggestion, matchedRules, payload}" } }
      }
    },
    "/api/v1/agent/orchestration/coordinate": {
      "post": {
        "tags": ["agent"],
        "summary": "AgentScope 多智能体编排（SEQUENTIAL / PARALLEL / VOTING / CASCADE）",
        "responses": { "200": { "description": "OrchestrationResult{finalResult, blackboard.trace}" } }
      }
    },
    "/api/v1/notification/messages": {
      "get": {
        "tags": ["notification"],
        "summary": "我的消息分页（按已读/未读过滤）",
        "responses": { "200": { "description": "PageResult<MessageDO>" } }
      }
    },
    "/api/v1/notification/messages/{id}/read": {
      "post": {
        "tags": ["notification"],
        "summary": "标记已读",
        "responses": { "200": { "description": "成功" } }
      }
    },
    "/api/v1/workflow/processes/start": {
      "post": {
        "tags": ["workflow"],
        "summary": "发起工作流流程实例",
        "responses": { "200": { "description": "processInstanceId" } }
      }
    },
    "/api/v1/audit/login-audit/page": {
      "get": {
        "tags": ["audit"],
        "summary": "登录审计分页（10 种 LoginStatus）",
        "responses": { "200": { "description": "PageResult<LoginAuditDO>" } }
      }
    },
    "/api/v1/audit/operation-log/page": {
      "get": {
        "tags": ["audit"],
        "summary": "操作日志分页（异步落库，90 天自动清理）",
        "responses": { "200": { "description": "PageResult<OperationLogDO>" } }
      }
    }
  }
}
