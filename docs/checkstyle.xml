<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
    云顶编码规范 - Checkstyle 检查配置
    Ydsz Cloud Coding Standards - Checkstyle Configuration

    规范版本：v2.0
    基线规范：阿里巴巴 Java 开发手册（泰山版） + Google Java Style Guide + Effective Java + 美团编码规约

    检查维度：
    1. Import 导入规范（禁止行内全限定名、禁止通配符、排序、禁止非法 import）
    2. 命名规范（类名、方法名、变量名、常量名、包名）
    3. 代码复杂度（方法行数、圈复杂度、嵌套层级、参数个数）
    4. 格式检查（行宽、Tab、大括号、空格）
    5. OOP 规约（禁止过时方法、Finalizer、equals/hashCode）
    6. 日期时间（禁止 SimpleDateFormat 作为字段）
    7. 文件级检查（UTF-8、行尾换行）

    使用方式：
    - Maven: mvn checkstyle:check
    - IDE: 安装 Checkstyle 插件并导入本配置文件
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- ============================================ -->
    <!-- 1. 文件级检查（File-level Checks）            -->
    <!-- ============================================ -->

    <!-- 单行最大宽度：120 字符 -->
    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^package.*|^import.*|a href|href|http://|https://|ftp://"/>
    </module>

    <!-- 源文件最大行数：2000 行 -->
    <module name="FileLength">
        <property name="max" value="2000"/>
    </module>

    <!-- 禁止使用 Tab 字符，必须使用空格缩进 -->
    <module name="FileTabCharacter"/>

    <!-- 文件末尾必须保留一个空行 -->
    <module name="NewlineAtEndOfFile">
        <property name="lineSeparator" value="lf"/>
    </module>

    <!-- ============================================ -->
    <!-- 2. Import 导入规范（Import Conventions）      -->
    <!-- ============================================ -->

    <module name="TreeWalker">
        <!-- 禁止通配符 import（import xxx.*） -->
        <module name="AvoidStarImport"/>

        <!-- 禁止未使用的 import -->
        <module name="UnusedImports"/>

        <!-- 禁止冗余的 import -->
        <module name="RedundantImport"/>

        <!-- import 分组与排序：
             第 1 组：java.*
             第 2 组：javax.*
             第 3 组：第三方库（org.* / com.*，按字母序）
             第 4 组：公司内部包（com.njydsz.*）
             组间以空行分隔 -->
        <module name="CustomImportOrder">
            <property name="customImportOrderRules"
                      value="STANDARD_JAVA_PACKAGE###THIRD_PARTY_PACKAGE"/>
            <property name="sortImportsInGroupAlphabetically" value="true"/>
            <property name="separateLineBetweenGroups" value="true"/>
        </module>

        <!-- 禁止 import 第三方 JSON 库（统一使用 ydsz-common-json） -->
        <module name="IllegalImport">
            <property name="illegalPkgs"
                      value="com.fasterxml.jackson,com.alibaba.fastjson,com.alibaba.fastjson2,com.google.gson,org.json"/>
        </module>

        <!-- 禁止 import SimpleDateFormat（线程不安全，推荐 DateTimeFormatter） -->
        <module name="IllegalImport">
            <property name="illegalClasses"
                      value="java.text.SimpleDateFormat"/>
            <message key="import.illegal"
                     value="SimpleDateFormat 线程不安全，请使用 java.time.format.DateTimeFormatter 替代。参考：云顶编码规范 7.1 节"/>
        </module>

        <!-- 禁止 import Executors（推荐 ThreadPoolExecutor 显式创建） -->
        <module name="IllegalImport">
            <property name="illegalClasses"
                      value="java.util.concurrent.Executors"/>
            <message key="import.illegal"
                     value="禁止直接使用 Executors 创建线程池（无界队列风险），请使用 ThreadPoolExecutor 显式创建。参考：云顶编码规范 8.1 节"/>
        </module>

        <!-- ============================================ -->
        <!-- 3. 命名规范（Naming Conventions）            -->
        <!-- ============================================ -->

        <!-- 类名：UpperCamelCase，必须遵从驼峰形式 -->
        <module name="TypeName">
            <property name="format" value="^[A-Z][a-zA-Z0-9]*$"/>
        </module>

        <!-- 方法名：lowerCamelCase -->
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <!-- 成员变量名：lowerCamelCase -->
        <module name="MemberName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <!-- 局部变量名：lowerCamelCase -->
        <module name="LocalVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
            <property name="tokens" value="VARIABLE_DEF"/>
        </module>

        <!-- 静态非 final 变量名：lowerCamelCase -->
        <module name="StaticVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <!-- 常量名：UPPER_SNAKE_CASE -->
        <module name="ConstantName">
            <property name="format" value="^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
        </module>

        <!-- 参数名：lowerCamelCase -->
        <module name="ParameterName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <!-- 包名：全小写，点分隔 -->
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>

        <!-- 抽象类：Abstract 或 Base 开头 -->
        <module name="AbstractClassName">
            <property name="ignoreName" value="true"/>
            <property name="format" value="^Abstract.*$|^Base.*$"/>
        </module>

        <!-- ============================================ -->
        <!-- 4. 代码复杂度（Complexity）                   -->
        <!-- ============================================ -->

        <!-- 方法最大行数：80 行 -->
        <module name="MethodLength">
            <property name="max" value="80"/>
        </module>

        <!-- 单方法最大参数个数：5 个 -->
        <module name="ParameterNumber">
            <property name="max" value="5"/>
            <property name="tokens" value="METHOD_DEF"/>
        </module>

        <!-- 圈复杂度：10 -->
        <module name="CyclomaticComplexity">
            <property name="max" value="10"/>
            <property name="switchBlockAsSingleDecisionPoint" value="true"/>
        </module>

        <!-- if-else 嵌套最大深度：3 层 -->
        <module name="NestedIfDepth">
            <property name="max" value="3"/>
        </module>

        <!-- for 循环嵌套最大深度：3 层 -->
        <module name="NestedForDepth">
            <property name="max" value="3"/>
        </module>

        <!-- try 嵌套最大深度：3 层 -->
        <module name="NestedTryDepth">
            <property name="max" value="3"/>
        </module>

        <!-- 单行只能有一条语句 -->
        <module name="OneStatementPerLine"/>

        <!-- 禁止多变量声明（每行只声明一个变量） -->
        <module name="MultipleVariableDeclarations"/>

        <!-- ============================================ -->
        <!-- 5. 格式与空格（Formatting & Whitespace）      -->
        <!-- ============================================ -->

        <!-- 左大括号必须在方法/类声明后同一行（K&R 风格） -->
        <module name="LeftCurly">
            <property name="option" value="eol"/>
            <property name="tokens"
                      value="CLASS_DEF, INTERFACE_DEF, METHOD_DEF, CTOR_DEF,
                             LITERAL_IF, LITERAL_ELSE, LITERAL_FOR, LITERAL_WHILE,
                             LITERAL_DO, LITERAL_SWITCH, LITERAL_TRY, LITERAL_CATCH,
                             STATIC_INIT, ANNOTATION_DEF, ENUM_DEF"/>
        </module>

        <!-- 右大括号必须单独成行（除非后面紧跟 else/catch/finally），使用默认 token 集合 -->
        <module name="RightCurly">
            <property name="option" value="alone"/>
        </module>

        <!-- 必须使用大括号（即使只有一行语句） -->
        <module name="NeedBraces"/>

        <!-- 保留字（if/for/while/switch/do）与括号之间必须有空格 -->
        <module name="WhitespaceAfter">
            <property name="tokens" value="COMMA, SEMI, TYPECAST"/>
        </module>

        <!-- 运算符、括号、分号周围空格规范（使用 checkstyle 默认 token 集合） -->
        <module name="WhitespaceAround">
            <property name="allowEmptyConstructors" value="true"/>
            <property name="allowEmptyMethods" value="true"/>
            <property name="allowEmptyTypes" value="true"/>
            <property name="allowEmptyLoops" value="true"/>
            <property name="allowEmptyLambdas" value="true"/>
            <property name="ignoreEnhancedForColon" value="false"/>
        </module>

        <!-- 注释双斜线与内容之间有且仅有一个空格 -->
        <module name="SingleSpaceSeparator"/>

        <!-- ============================================ -->
        <!-- 6. OOP 规约（OOP Conventions）               -->
        <!-- ============================================ -->

        <!-- 禁止覆盖 finalize() 方法 -->
        <module name="FinalLocalVariable">
            <property name="tokens" value="VARIABLE_DEF,PARAMETER_DEF"/>
            <property name="validateEnhancedForLoopVariable" value="true"/>
        </module>

        <!-- 禁止抛出 RuntimeException / Exception / Throwable -->
        <module name="IllegalThrows">
            <property name="illegalClassNames"
                      value="java.lang.RuntimeException, java.lang.Exception, java.lang.Throwable"/>
            <message key="illegal.throw"
                     value="禁止直接抛出 RuntimeException/Exception/Throwable，请使用自定义业务异常。参考：云顶编码规范 11 章"/>
        </module>

        <!-- 禁止 new BigDecimal(double) 构造方式（精度丢失） -->
        <module name="IllegalType">
            <property name="illegalClassNames" value="java.math.BigDecimal"/>
            <message key="illegal.type"
                     value="禁止 new BigDecimal(double/Float) 构造方法，推荐 new BigDecimal(String) 或 BigDecimal.valueOf()。参考：云顶编码规范 6.6 节"/>
        </module>

        <!-- 禁止实例化工具类（私有构造方法） -->
        <module name="HideUtilityClassConstructor"/>

        <!-- 覆盖 equals 必须同时覆盖 hashCode -->
        <module name="EqualsHashCode"/>

        <!-- ============================================ -->
        <!-- 7. 日期时间（Date & Time）                   -->
        <!-- ============================================ -->

        <!-- 禁止 SimpleDateFormat 作为实例字段或静态字段（线程不安全） -->
        <module name="IllegalType">
            <property name="illegalClassNames" value="java.text.SimpleDateFormat"/>
            <message key="illegal.type"
                     value="SimpleDateFormat 线程不安全，请使用 java.time.format.DateTimeFormatter 替代。参考：云顶编码规范 7.1 节"/>
        </module>

        <!-- ============================================ -->
        <!-- 8. 其他规范（Miscellaneous）                 -->
        <!-- ============================================ -->

        <!-- 禁止在 switch 中缺少 default 分支 -->
        <module name="MissingSwitchDefault"/>

        <!-- switch case fall-through 禁止（必须 break/return/throw/continue） -->
        <module name="FallThrough">
            <property name="reliefPattern" value="继续执行到下一个 case|fall through|no break"/>
        </module>

        <!-- 禁止在 for 循环中修改循环变量 -->
        <module name="ModifiedControlVariable"/>

        <!-- 禁止多线程下使用非线程安全的随机数（推荐 ThreadLocalRandom） -->
        <module name="RegexpSinglelineJava">
            <property name="format" value="new\s+Random\s*\(\s*\)"/>
            <property name="ignoreComments" value="true"/>
            <message key="illegal.regex"
                     value="推荐使用 ThreadLocalRandom.current() 替代 new Random() 以提高并发性能。参考：云顶编码规范 15 章"/>
        </module>

        <!-- long 赋值必须使用大写 L -->
        <module name="UpperEll">
            <message key="upperEll"
                     value="long/Long 赋值必须使用大写 L（如 2L），小写 l 易与数字 1 混淆。参考：云顶编码规范 3.2 节"/>
        </module>

        <!-- 魔法数检查（局部变量中出现的数字常量，排除 0, 1, -1, 2, 100 等常用值） -->
        <module name="MagicNumber">
            <property name="ignoreNumbers" value="-1, 0, 1, 2, 10, 100, 1000, 10000, 0.1, 0.01"/>
            <property name="ignoreAnnotation" value="true"/>
            <property name="ignoreHashCodeMethod" value="true"/>
            <message key="magic.number"
                     value="魔法值（Magic Number）必须定义为常量。参考：云顶编码规范 3.1 节"/>
        </module>

        <!-- ============================================ -->
        <!-- 9. Javadoc 注释规范（Javadoc Conventions）    -->
        <!-- ============================================ -->

        <!-- 类和接口必须有 Javadoc -->
        <module name="JavadocType">
            <property name="scope" value="public"/>
            <property name="authorFormat" value="\S+"/>
            <property name="versionFormat" value="\S+"/>
        </module>

        <!-- 公共方法必须有 Javadoc（checkstyle 9.x 使用 accessModifiers 替代已移除的 scope） -->
        <module name="JavadocMethod">
            <property name="accessModifiers" value="public"/>
            <property name="allowedAnnotations" value="Override, Test, BeforeEach, AfterEach, BeforeAll, AfterAll, Bean, MockitoBean"/>
            <property name="allowMissingParamTags" value="false"/>
            <property name="allowMissingReturnTag" value="false"/>
        </module>

        <!-- Javadoc 格式和段落规范 -->
        <module name="JavadocStyle">
            <property name="scope" value="public"/>
            <property name="checkEmptyJavadoc" value="true"/>
        </module>

        <!-- 首句必须以 . 结束 -->
        <module name="SummaryJavadoc">
            <property name="forbiddenSummaryFragments" value="^@return the *|^This method returns |^A [{]@code [a-zA-Z0-9]+[}]( is a )"/>
        </module>

    </module>
</module>
