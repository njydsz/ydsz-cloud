<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<!--
    云顶编码规范 - Checkstyle 豁免清单
    Ydsz Cloud Coding Standards - Checkstyle Suppressions

    说明：能力提供者模块（common-excel / common-docs / common-file / common-netty / common-seata）
    本身负责封装第三方 SDK（POI / Tika / PDFBox / Minio / OSS / Netty / Seata），
    允许直接 import 对应 SDK；业务模块必须通过它们的能力抽象使用，禁止直接 import。
    本清单与 pom.xml Enforcer bannedImports 的 excludeModules 语义保持一致。
-->
<suppressions>
    <!-- Excel 能力提供者：POI -->
    <suppress files=".*[\\/]ydsz-common-excel[\\/].*" checks="IllegalImport"/>

    <!-- 文档解析能力提供者：POI / Tika / PDFBox -->
    <suppress files=".*[\\/]ydsz-common-docs[\\/].*" checks="IllegalImport"/>

    <!-- 对象存储能力提供者：Minio / OSS / COS / OBS / S3 SDK -->
    <suppress files=".*[\\/]ydsz-common-file[\\/].*" checks="IllegalImport"/>

    <!-- 网络通信能力提供者：Netty -->
    <suppress files=".*[\\/]ydsz-common-netty[\\/].*" checks="IllegalImport"/>

    <!-- 分布式事务能力提供者：Seata -->
    <suppress files=".*[\\/]ydsz-common-seata[\\/].*" checks="IllegalImport"/>

    <!-- Spring Boot 启动类与 CLI 工具：含 main 入口，非纯工具类，HideUtilityClassConstructor 误报 -->
    <suppress files=".*[\\/][A-Za-z]+Application\.java" checks="HideUtilityClassConstructor"/>
    <suppress files=".*[\\/]ConfigCliTool\.java" checks="HideUtilityClassConstructor"/>

    <!-- 工具类已通过 @NoArgsConstructor(access=PRIVATE) 隐藏构造器，checkstyle 不解析 Lombok 注解，HideUtilityClassConstructor 误报 -->
    <suppress files=".*[\\/]SqlAuditJsonLogger\.java" checks="HideUtilityClassConstructor"/>

    <!-- ============================================ -->
    <!-- 2. 自研引擎模块：算法类规则豁免               -->
    <!--    依据：引擎为位运算/状态机等算法密集型实现， -->
    <!--    魔法数提取与复杂度重构列入专项技术债        -->
    <!-- ============================================ -->

    <!-- common-json：自研 JSON 引擎（零第三方依赖） -->
    <suppress files="ydsz-common-json[\\/]src[\\/]main[\\/]"
              checks="MagicNumber|CyclomaticComplexity|MethodLength|NestedIfDepth|ParameterNumber|IllegalThrows"/>

    <!-- common-excel：自研 Excel 引擎 -->
    <suppress files="ydsz-common-excel[\\/]src[\\/]main[\\/]"
              checks="MagicNumber|CyclomaticComplexity|MethodLength|NestedIfDepth|ParameterNumber|IllegalThrows"/>

    <!-- common-util：L1 工具模块（位运算/编码/算法密集型实现） -->
    <suppress files="ydsz-common-util[\\/]src[\\/]main[\\/]"
              checks="MagicNumber|CyclomaticComplexity|MethodLength|NestedIfDepth|ParameterNumber|IllegalThrows"/>

    <!-- common-core：L2 基础设施（算法密集型实现） -->
    <suppress files="ydsz-common-core[\\/]src[\\/]main[\\/]"
              checks="MagicNumber|CyclomaticComplexity|MethodLength|NestedIfDepth|ParameterNumber|IllegalThrows"/>

    <!-- common-cache：自研缓存引擎（LRU/LFU/TinyLFU 等算法密集型实现） -->
    <suppress files="ydsz-common-cache[\\/]src[\\/]main[\\/]"
              checks="MagicNumber|CyclomaticComplexity|MethodLength|NestedIfDepth|ParameterNumber|IllegalThrows"/>

    <!-- common-redis：基础数据层（序列化/连接池等算法密集型实现） -->
    <suppress files="ydsz-common-redis[\\/]src[\\/]main[\\/]"
              checks="MagicNumber|CyclomaticComplexity|MethodLength|NestedIfDepth|ParameterNumber|IllegalThrows"/>

    <!-- common-thread：线程池能力提供者（Executors / new ThreadPoolExecutor 为封装层内部实现，云顶规范 15.4 授权层） -->
    <suppress files="ydsz-common-thread[\\/]src[\\/]main[\\/]"
              checks="IllegalImport"
              message=".*Executors.*"/>
    <suppress files="ydsz-common-thread[\\/]src[\\/]main[\\/]"
              checks="RegexpSinglelineJava"
              message=".*禁止直接创建线程池实例.*"/>

    <!-- common-safe：安全事件聚合器内部单线程消费（Executors.newSingleThreadExecutor，代码内已含 OFF 豁免注释；
         import 语句在文件顶部无法注释豁免，此处文件级豁免 IllegalImport） -->
    <suppress files="SecurityEventAggregator\.java" checks="IllegalImport" message=".*Executors.*"/>

    <!-- common-safe：SafeMetricsDoc 为纯度量文档类（Javadoc 表格行承载 PromQL，不可拆行） -->
    <suppress files="SafeMetricsDoc\.java" checks="LineLength"/>

    <!-- common-queue：内部单线程调度器（Executors.newSingleThreadScheduledExecutor 兜底实现，代码内已含 OFF 注释；
         import 语句在文件顶部无法注释豁免，此处文件级豁免 IllegalImport） -->
    <suppress files="TimerBasedDelayedMessageSender\.java|RebalanceMonitor\.java"
              checks="IllegalImport"
              message=".*Executors.*"/>

    <!-- gateway：网络/校验密集型实现（IP 校验、健康检查、过滤器配置），算法类规则豁免，红线规则保留 -->
    <suppress files="ydsz-gateway[\\/]src[\\/]main[\\/]"
              checks="MagicNumber|CyclomaticComplexity|ParameterNumber|MethodLength|NestedIfDepth|IllegalThrows"/>

    <!-- gateway：ApiKeyAuthFilter 的 @Value SpEL 表达式为单行字符串（Spring EL 语法限制，不可拆行） -->
    <suppress files="ApiKeyAuthFilter\.java" checks="LineLength"/>

    <!-- 业务模块（system/userinfo/cronjob/message/workflow/literule/nextwiki/agent）：
         批量处理/配额计算等业务逻辑的算法类规则豁免，红线规则（IllegalImport/FQN/NeedBraces/Javadoc 强制）保留 -->
    <suppress files="ydsz-system[\\/]src[\\/]main[\\/]"
              checks="CyclomaticComplexity|ParameterNumber|MethodLength|NestedIfDepth"/>
    <suppress files="ydsz-userinfo[\\/](ydsz-userinfo-[a-z]+[\\/])?src[\\/]main[\\/]|ydsz-cronjob[\\/](ydsz-cronjob-[a-z]+[\\/])?src[\\/]main[\\/]|ydsz-message[\\/](ydsz-message-[a-z]+[\\/])?src[\\/]main[\\/]|ydsz-workflow[\\/](ydsz-workflow-[a-z]+[\\/])?src[\\/]main[\\/]|ydsz-literule[\\/](ydsz-literule-[a-z]+[\\/])?src[\\/]main[\\/]|ydsz-nextwiki[\\/](ydsz-nextwiki-[a-z]+[\\/])?src[\\/]main[\\/]|ydsz-agent[\\/](ydsz-agent-[a-z]+[\\/])?src[\\/]main[\\/]"
              checks="CyclomaticComplexity|ParameterNumber|MethodLength|NestedIfDepth"/>

    <!-- cronjob 核心调度器：集中承载触发/重试/恢复/Misfire 等 102 个方法，文件级长度豁免 -->
    <suppress files="DefaultTaskDispatcher\.java" checks="FileLength"/>

    <!-- message TcpPushChannel：继承 common-netty AbstractNettyServer，必须实现
         initChannelPipeline(SocketChannel) 契约并处理 Netty 原生事件（Handler/ByteBuf/IdleStateEvent），
         属能力提供者抽象类的必要边界暴露，红线规则其余项保留 -->
    <suppress files="TcpPushChannel\.java" checks="IllegalImport"/>

    <!-- workflow 算法密集/示例字符串密集文件：条件表达式引擎（JSON 示例）、委托授权/模板/效率分析
         等业务实现包含不可拆行的长字符串字面量与规则表，LineLength 豁免，其余红线规则保留 -->
    <suppress files="FlowConditionExprServiceImpl\.java|FlowDelegateAuthServiceImpl\.java|FlowTemplateServiceImpl\.java|FlowTaskCoreService\.java|FlowInstanceMigrationServiceImpl\.java|FlowEfficiencyServiceImpl\.java|DefaultFlowRoutingService\.java|FlowEmbeddedApprovalServiceImpl\.java|ProjectInitiationFlowListener\.java|FlowTaskPassService\.java|FlowTaskOperateService\.java|FlowTaskCreateService\.java|FlowSlaServiceImpl\.java|FlowExportServiceImpl\.java|FlowEventSubscriptionServiceImpl\.java|FlowDefinitionDesignManager\.java"
              checks="LineLength"/>

    <!-- literule ScriptRule：危险类黑名单为不可拆行的正则字面量（拆行会改变语义），LineLength 豁免 -->
    <suppress files="ScriptRule\.java" checks="LineLength"/>

    <!-- literule：反射/脚本/SPI 场景允许 throws Exception（反射创建 Nacos/Zookeeper 监听器、表达式函数 SPI
         契约、生命周期回调 init/destroy、超时评估包装），IllegalThrows 豁免，其余红线规则保留 -->
    <suppress files="DefaultRuleEngine\.java|LiteExprFunction\.java|NacosRuleSource\.java|ZookeeperRuleSource\.java|RuleConfigProvider\.java"
              checks="IllegalThrows"/>

    <!-- literule：配置类注解字符串（@ConditionalOnClass 类名字符串）与类型名工具
         （java.lang./java.util. 前缀剔除）中的包名属于字符串字面量语义而非代码体 FQN，RegexpSinglelineJava 豁免 -->
    <suppress files="LiteRuleAutoConfiguration\.java|VariableDefinition\.java" checks="RegexpSinglelineJava"/>

    <!-- literule RuleDebugger：ThreadLocal CURRENT_RULE_CODE 在 finally 块中已 remove（调试会话结束清理），
         声明行被 RegexpSinglelineJava 正则匹配属规则误报，豁免 ThreadLocal 检测 -->
    <suppress files="RuleDebugger\.java" checks="RegexpSinglelineJava" message=".*ThreadLocal.*"/>

    <!-- ============================================ -->
    <!-- 3. 全部 common 子模块：算法类规则通用豁免     -->
    <!--    自研基础库（引擎/工具/配置/异常/领域模型） -->
    <!--    为算法密集型实现，魔法数提取与复杂度重构   -->
    <!--    列入专项技术债；IllegalImport 等红线保留   -->
    <!--    IllegalThrows 已移出通用豁免：自 v3.4 起    -->
    <!--    各 common 模块须使用业务异常（如            -->
    <!--    TransactionException/CircuitBreakerExecutionException）， -->
    <!--    仅 json/excel/util/core/cache/redis/thread  -->
    <!--    算法模块保留上方点豁免                     -->
    <!-- ============================================ -->
    <suppress files="ydsz-common-[a-z]+[\\/]src[\\/]main[\\/]"
              checks="MagicNumber|CyclomaticComplexity|MethodLength|NestedIfDepth|ParameterNumber"/>

    <!-- ============================================ -->
    <!-- 4. Logger 字段命名豁免                        -->
    <!--    Logger 声明为 static final，但内部状态可变  -->
    <!--    （日志级别/输出目标可动态调整），非真正常量，-->
    <!--    业界惯例使用小写 log，豁免 ConstantName 检查 -->
    <!-- ============================================ -->
    <suppress checks="ConstantName" message="名称 'log' 必须匹配表达式"/>

</suppressions>
