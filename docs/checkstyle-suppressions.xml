<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<!--
    云顶编码规范 - Checkstyle 豁免清单
    Ydsz Cloud Coding Standards - Checkstyle Suppressions

    说明：能力提供者模块（common-excel / common-docs / common-file / common-netty / common-seata）
    本身负责封装第三方 SDK（POI / Tika / PDFBox / Minio / OSS / Netty / Seata），
    允许直接 import 对应 SDK；业务模块必须通过它们的能力抽象使用，禁止直接 import。
    本清单与 pom.xml Enforcer bannedImports 的 excludeModules 语义保持一致。
-->
<suppressions>
    <!-- Excel 能力提供者：POI -->
    <suppress files=".*[\\/]ydsz-common-excel[\\/].*" checks="IllegalImport"/>

    <!-- 文档解析能力提供者：POI / Tika / PDFBox -->
    <suppress files=".*[\\/]ydsz-common-docs[\\/].*" checks="IllegalImport"/>

    <!-- 对象存储能力提供者：Minio / OSS / COS / OBS / S3 SDK -->
    <suppress files=".*[\\/]ydsz-common-file[\\/].*" checks="IllegalImport"/>

    <!-- 网络通信能力提供者：Netty -->
    <suppress files=".*[\\/]ydsz-common-netty[\\/].*" checks="IllegalImport"/>

    <!-- 分布式事务能力提供者：Seata -->
    <suppress files=".*[\\/]ydsz-common-seata[\\/].*" checks="IllegalImport"/>

    <!-- Spring Boot 启动类与 CLI 工具：含 main 入口，非纯工具类，HideUtilityClassConstructor 误报 -->
    <suppress files=".*[\\/][A-Za-z]+Application\.java" checks="HideUtilityClassConstructor"/>
    <suppress files=".*[\\/]ConfigCliTool\.java" checks="HideUtilityClassConstructor"/>

    <!-- 工具类已通过 @NoArgsConstructor(access=PRIVATE) 隐藏构造器，checkstyle 不解析 Lombok 注解，HideUtilityClassConstructor 误报 -->
    <suppress files=".*[\\/]SqlAuditJsonLogger\.java" checks="HideUtilityClassConstructor"/>

    <!-- 多级缓存实现（L1 Caffeine 本地缓存）：需要直接操作 Caffeine 底层 API（newBuilder/CacheStats/Expiry），
         属于缓存能力提供者场景，与 common-excel/docs 直接 import SDK 同语义 -->
    <suppress files=".*[\\/]ydsz-common-redis[\\/].*[\\/]multilevel[\\/].*" checks="IllegalImport"/>

    <!-- ydsz-common-thread 模块内部实现：本身即线程池统一管理提供者，直接使用 Executors 属规范豁免场景
         （见《云顶编码规范》15.4 节豁免说明：ExecutorUtils / ThreadPoolExecutorFactory 内部实现） -->
    <suppress files=".*[\\/]ydsz-common-thread[\\/].*" checks="IllegalImport"/>

    <!-- BaseResponse：以 Base 开头但为具体响应基类（@SuperBuilder 实例化），AbstractClassName 规则误报 -->
    <suppress files=".*[\\/]ydsz-common-core[\\/].*[\\/]BaseResponse\.java" checks="AbstractClassName"/>

    <!-- ============================================================
         Checkstyle v3.1（2026-08-16 规范升级）存量债务豁免
         ydsz-common 全部子模块为历史代码，尚未适配 v3.1 新增的严格规则
         （手写高性能 JSON 解析器、通用工具库、缓存抽象层、Excel 封装等）。
         此处豁免风格类检查（保留 IllegalImport 等红线检查），
         待代码逐步整改后应移除对应豁免条目。
         ============================================================ -->
    <suppress files=".*[\\/]ydsz-common-[a-z]+[\\/].*"
              checks="JavadocMethod|MagicNumber|NeedBraces|CyclomaticComplexity|MethodLength|RegexpSinglelineJava|ModifiedControlVariable|RedundantModifier|JavadocStyle|NestedIfDepth|NewlineAtEndOfFile|JavadocType|ParameterNumber|MissingSwitchDefault|LineLength|CustomImportOrder|ConstantName|MultipleVariableDeclarations|IllegalThrows|AbstractClassName|ParameterName"/>
</suppressions>
