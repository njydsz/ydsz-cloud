# =====================================================================
#  YDSZ · 本地开发凭据 override 模板
#  --------------------------------------------------------------------
#  用法：复制为同目录下的 ydsz-config.local.yml（已被 .gitignore 的
#        *.local.* 规则排除），填入你自己的本地凭据后重启服务即可。
#
#        cp docs/nacos-config/ydsz-config.local.yml.example \
#           docs/nacos-config/ydsz-config.local.yml
#
#  原理：仓库内所有配置只写占位符（如 ${YDSZ_JWT_SECRET:}），不带默认值。
#        占位符按"环境变量优先、其次配置文件属性"的顺序解析，因此本文件
#        里这些大写的根级 key 与 OS 环境变量等价，无需关心 import 顺序。
#
#  注意：本模板文件本身会入库，请勿把真实凭据写进 .example。
# =====================================================================

# ---------------------------------------------------------------------
#  PostgreSQL（ydsz-common.yml 中 spring.datasource.password）
# ---------------------------------------------------------------------
NACOS_DB_PASSWORD: ""

# ---------------------------------------------------------------------
#  PostgreSQL — 代码生成器独立库（ydsz-generator-web）
# ---------------------------------------------------------------------
NACOS_GEN_DB_PASSWORD: ""

# ---------------------------------------------------------------------
#  JWT 签名密钥（网关与所有签发/校验方必须一致，>= 32 字节）
#  生成：openssl rand -base64 32
#  或代码调用 com.njydsz.common.auth.token.TokenProperties#generateSecureSecret()
#  留空将导致服务启动失败（fail-closed），这是刻意为之。
# ---------------------------------------------------------------------
YDSZ_JWT_SECRET: ""

# ---------------------------------------------------------------------
#  网关内部头签名密钥（与下游 ydsz.security.internal-sign.secret 一致，
#  >= 32 字节；禁止与 YDSZ_JWT_SECRET 复用同一个值）
# ---------------------------------------------------------------------
YDSZ_GATEWAY_INTERNAL_SIGN_SECRET: ""

# ---------------------------------------------------------------------
#  可选覆盖项（默认值见 ydsz-common.yml，本地端口/实例不同时才需要）
# ---------------------------------------------------------------------
# NACOS_DB_URL: "jdbc:postgresql://127.0.0.1:5432/ydsz_cloud?currentSchema=public&stringtype=unspecified"
# NACOS_DB_USERNAME: "postgres"
# REDIS_PASSWORD: ""
