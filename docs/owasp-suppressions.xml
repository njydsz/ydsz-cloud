<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!--
        OWASP DependencyCheck Suppressions（已知误报 / 可控风险）
        用途：对扫描出但确认无实际风险的 CVE 进行抑制，避免误报导致构建失败。
        规则：每项需注明 CVE 编号、影响组件、抑制原因（例如：仅内部使用 / 未触及代码路径 / 等待上游修复）。
        新增抑制时请团队 two-eye review（CR 时至少一位 reviewer 确认）。

        示例（请按实际组件替换）：
        <suppress>
            <notes><![CDATA[
                某某组件 XML XXE 漏洞（CVE-YYYY-NNNN）：当前仅用于内网配置文件解析，
                不受外部输入影响，风险可控。
            ]]></notes>
            <packageUrl regex="true">^pkg:maven/.*\.jar$</packageUrl>
            <vulnerabilityName>CVE-YYYY-NNNN</vulnerabilityName>
        </suppress>
    -->
</suppressions>
