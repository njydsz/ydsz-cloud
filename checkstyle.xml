<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    remi-cloud Checkstyle 配置（精简版）

    原则：只检查项目能轻松遵守、修复成本低、价值高的规则。
    下列项目排除是因为历史代码量大、或项目自有风格冲突：
    - 行尾空白 (RegexpSingleline)               -> 有几百处历史问题
    - 导入排序 (ImportOrder)                    -> 项目有自定义顺序
    - 星号导入 (AvoidStarImport)                -> 项目大量使用
    - 大括号位置 (LeftCurly/RightCurly)         -> 项目使用行尾 {
    - 一行一语句 (OneStatementPerLine)          -> 项目风格允许
    - 操作符空格 (WhitespaceAround)             -> 大量冲突
    - 圈复杂度/NCSS                             -> 项目含算法代码，阈值不可控
    - 布尔表达式复杂度                           -> 同上

    修复建议（如需渐进式收紧）：
    1. 在新代码中避免引入上述问题
    2. 修改文件时顺手清理该行空白
    3. 之后逐步打开对应规则
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java, properties, xml"/>

    <!-- 排除自动生成的文件 -->
    <module name="BeforeExecutionExclusionFileFilter">
        <property name="fileNamePattern" value="(module\-info|package\-info|.*Generated.*)\.java$"/>
    </module>

    <!--
        ========== 1. 缩进与 Tab ==========
        项目统一使用 4 空格缩进，禁止 Tab。
        这是最基本的规则，无历史包袱。
    -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <!--
        ========== 2. 行长度 ==========
        项目实际代码存在 130-180 字符的行（ASM 算法代码、长注释）。
        设置为 160 作为过渡值，后续可逐步收紧到 120。
    -->
    <module name="LineLength">
        <property name="fileExtensions" value="java"/>
        <property name="max" value="160"/>
        <property name="ignorePattern" value="^(package|import) .*$|^\s*//.*\{@code.*|^\s*\*\s+(https?://|@see|@link|@throws\s|@\w+\s)"/>
    </module>

    <module name="TreeWalker">
        <!--
            ========== 3. 导入 ==========
            只检查未使用的导入（价值高、容易修复）。
            星号导入、导入排序均关闭，因为项目自有风格。
        -->
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>

        <!--
            ========== 4. 命名规范 ==========
            检查公共 API 的命名，但不强制 Lombok 生成的 log 字段为大写。
        -->
        <module name="TypeName">
            <property name="format" value="^[A-Z][a-zA-Z0-9]*$"/>
        </module>
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="LocalVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
            <property name="tokens" value="VARIABLE_DEF"/>
        </module>
        <module name="ParameterName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="ConstantName">
            <property name="format" value="^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
        </module>
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>
        <module name="MemberName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <!--
            ========== 5. 代码安全 ==========
        -->
        <!-- 字符串比较应使用 equals -->
        <module name="EqualsAvoidNull"/>
        <!-- 禁止 == 比较字符串 -->
        <module name="StringLiteralEquality"/>
        <!-- switch 必须有 default -->
        <module name="MissingSwitchDefault"/>
        <!-- default 分支必须放在最后 -->
        <module name="DefaultComesLast">
            <property name="skipIfLastAndSharedWithCase" value="true"/>
        </module>
        <!-- 防止 case 穿透 -->
        <module name="FallThrough"/>
        <!-- 隐藏字段 -->
        <module name="HiddenField">
            <property name="ignoreConstructorParameter" value="true"/>
            <property name="ignoreSetter" value="true"/>
            <property name="ignoreAbstractMethods" value="true"/>
        </module>

        <!--
            ========== 6. 修饰符 ==========
        -->
        <module name="ModifierOrder"/>
        <module name="RedundantModifier"/>

        <!-- 必须有 @Override 注解 -->
        <module name="MissingOverride"/>

        <!--
            ========== 7. 大括号 ==========
            只检查需要大括号的情况，不强制换行位置（项目使用行尾 {）。
        -->
        <module name="NeedBraces">
            <property name="allowSingleLineStatement" value="true"/>
        </module>
        <module name="EmptyBlock"/>

        <!--
            ========== 8. 最佳实践 ==========
        -->
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="OneTopLevelClass"/>
        <module name="OuterTypeFilename"/>
        <module name="EqualsHashCode"/>

        <!--
            ========== 9. 错误处理 ==========
            禁止捕获 NullPointerException，禁止抛出 RuntimeException。
            但允许 Lombok 生成的 toString 等方法中的 RuntimeException。
        -->
        <module name="IllegalCatch">
            <property name="illegalClassNames" value="java.lang.NullPointerException"/>
        </module>
        <module name="IllegalThrows">
            <property name="illegalClassNames" value="java.lang.RuntimeException, java.lang.Error"/>
        </module>

        <!--
            ========== 10. 反模式检查 ==========
            禁止 System.out.println / System.err.println / printStackTrace。
            日志字段由 Lombok 生成，不强制大写。
        -->
        <module name="RegexpSinglelineJava">
            <property name="format" value="System\.(out|err)\.print"/>
            <property name="message" value="Use SLF4J Logger instead of System.out/err"/>
        </module>
        <module name="RegexpSinglelineJava">
            <property name="format" value="\.printStackTrace\(\s*\)"/>
            <property name="message" value="Use SLF4J Logger instead of printStackTrace()"/>
        </module>
    </module>

    <!--
        ========== 11. 文件级检查 ==========
    -->
    <!-- 单个文件最大行数 -->
    <module name="FileLength">
        <property name="max" value="3000"/>
    </module>
</module>
