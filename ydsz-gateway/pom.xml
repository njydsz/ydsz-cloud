<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.njydsz</groupId>
        <artifactId>ydsz-cloud</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>ydsz-gateway</artifactId>
    <name>ydsz-gateway</name>
    <description>DDD Module</description>

    <dependencies>
        <!--
            P0-1: gateway 为 reactive 栈（WebFlux + Netty），禁止依赖 ydsz-common-web
            （servlet 栈，会引入 spring-boot-starter-web/Tomcat 与 jakarta.servlet-api，造成双栈冲突）。
            按需挑选细粒度子模块：
              - common-core:    YdszResponse
              - common-util:    SnowflakeUtils/RandomUtils（ID 生成）
              - common-exception: WebFluxExceptionHandler / ProblemDetail
              - common-auth:    UserInfo / TokenService / JwtTokenProvider（JWT 鉴权）
        -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-util</artifactId>
        </dependency>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-exception</artifactId>
        </dependency>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-auth</artifactId>
        </dependency>
        <!--
            P0-3 / P0-5 / P0-6: 复用 ydsz-common-safe 的安全能力
              - ClientIpResolver.isTrustedProxy(): 网关 IP 解析时校验可信代理链
              - SensitiveUtil.defaultDesensitize(): JWT Token 日志脱敏统一
              - NonceCache: 内部头签名防重放（gateway 端生成 nonce，下游服务消费）
            注意：ydsz-common-safe 已声明 jakarta.servlet-api 为 provided，
                  本模块（WebFlux）不引入 servlet 实现，仅复用 servlet 无关的工具类。
        -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-safe</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bootstrap</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- P2-1 依赖收敛：jjwt-orgjson 已废弃，统一使用 jjwt-jackson（与全仓一致） -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis-reactive</artifactId>
        </dependency>
        <!-- P1-7: 本地缓存（JWT 校验结果缓存，替代 Caffeine） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-cache</artifactId>
        </dependency>

        <!--
            P0-A2: 网关熔断 — Resilience4j (resilience4j-circuitbreaker)。
            替代 2026-09-01 之前的平台自研弹性引擎（ydsz-common-safe resilience 包）；
            响应式集成采用 Mono.defer + 许可获取 + doOnSuccess/doOnError 三段式手动记录。
            直接使用 resilience4j-circuitbreaker（而非 spring-cloud-starter），
            避免离线环境无法解析 spring-cloud-starter-circuitbreaker-resilience4j 导致构建中断。
        -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-circuitbreaker</artifactId>
        </dependency>

        <!-- Actuator 健康检查 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- P0-阶段二-1: Prometheus 指标导出（GatewayMetrics 依赖 MeterRegistry） -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!--
            GAP-P1-1: 接入 ydsz-common-sentry 统一监控/告警/日志上报
              - AlertConverger: 告警收敛降噪（时间窗口+去重+静默期）
              - DefaultAlertPublisher: 告警事件分发
              - LokiLogPublisher / ElkLogPublisher: 结构化日志推送
              - MicrometerMetricsCollector: 统一指标采集框架
        -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-sentry</artifactId>
        </dependency>
        <!-- P1-C: 审计日志集成（EventBridge 桥接 Reactive → Servlet-AOP 审计链路） -->
        <!-- provided 作用域避免传递 servlet 依赖（gateway 为 WebFlux 栈） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-audit</artifactId>
            <scope>provided</scope>
        </dependency>
        <!--
            P1-1: 接入 ydsz-common-thread 统一线程池管理
              - Nacos 路由配置变更监听器线程池改为声明式配置（ydsz.thread.pools.nacosRouteListener）
              - 移除 NacosRouteDefinitionRepository 中自建 new ThreadPoolExecutor（违反规范 15.4.1）
        -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-thread</artifactId>
        </dependency>
</dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
