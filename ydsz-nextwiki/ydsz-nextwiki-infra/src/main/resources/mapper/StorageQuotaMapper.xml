<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.njydsz.nextwiki.infra.mapper.StorageQuotaMapper">

    <resultMap id="StorageQuotaResult" type="com.njydsz.nextwiki.infra.entity.StorageQuota">
        <id column="id" property="id"/>
        <result column="scope_type" property="scopeType"/>
        <result column="scope_id" property="scopeId"/>
        <result column="quota_limit" property="quotaLimit"/>
        <result column="quota_used" property="quotaUsed"/>
        <result column="file_count_limit" property="fileCountLimit"/>
        <result column="file_count_used" property="fileCountUsed"/>
        <result column="status" property="status"/>
        <result column="created_by" property="createdBy"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_by" property="updatedBy"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="revision" property="revision"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <select id="selectByScope" resultMap="StorageQuotaResult">
        SELECT * FROM ydsz_nw_storage_quota
        WHERE scope_type = #{scopeType} AND scope_id = #{scopeId} AND deleted = 0
        LIMIT 1
    </select>

    <update id="updateWithRevision">
        UPDATE ydsz_nw_storage_quota
        SET
            scope_type = #{quota.scopeType},
            scope_id = #{quota.scopeId},
            quota_limit = #{quota.quotaLimit},
            quota_used = #{quota.quotaUsed},
            file_count_limit = #{quota.fileCountLimit},
            file_count_used = #{quota.fileCountUsed},
            status = #{quota.status},
            updated_by = #{quota.updatedBy},
            updated_at = #{quota.updatedAt},
            revision = revision + 1
        WHERE id = #{quota.id}
          AND deleted = 0
          AND revision = #{quota.revision}
    </update>

</mapper>
