<?xml version="1.0" encoding="UTF-8"?>
<!--
  REMI · 统一 Logback 默认配置（可被业务服务 include）

  使用方式：业务服务在自身的 logback-spring.xml 中通过以下方式引入本文件，
  引入后即获得 dev / sit / uat / prod 四种 profile 的开箱即用配置：

    <configuration>
        <include resource="logback-spring-default.xml"/>
        <!-- 业务服务可在此追加自身的 appender 或覆盖 property -->
    </configuration>

  设计要点：
    1. dev     —— 控制台输出，DEBUG 级别，非 JSON 格式（pattern 内嵌 traceId/userId/tenantId）
    2. sit/uat —— 控制台 + 文件，INFO 级别，JSON 结构化（SentryLogbackLayout）
    3. prod    —— 文件 + 滚动归档，WARN 级别，JSON 结构化，单文件 100MB，保留 30 天
    4. JSON 输出统一走 com.remisoft.common.sentry.logging.SentryLogbackLayout，
       通过 mdcFields 显式声明 tenantId 以纳入 extra 字段。
-->
<included>

    <!-- ============================== 公共属性 ============================== -->
    <!-- 应用名（取自 spring.application.name，兜底 remi） -->
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="remi"/>
    <!-- 当前 profile（取自 spring.profiles.active，兜底 dev） -->
    <springProperty scope="context" name="PROFILE" source="spring.profiles.active" defaultValue="dev"/>
    <!-- 日志根目录（容器内固定 /app/logs，本地可通过系统属性覆盖） -->
    <property name="LOG_HOME" value="${LOG_HOME:-/app/logs}"/>
    <!-- 归档日志目录 -->
    <property name="LOG_ARCHIVE" value="${LOG_HOME}/archive"/>

    <!-- ============================== 非 JSON Pattern ============================== -->
    <!-- dev 环境使用：内嵌 MDC traceId/userId/tenantId，便于人工阅读 -->
    <property name="CONSOLE_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - [traceId=%X{traceId:-},userId=%X{userId:-},tenantId=%X{tenantId:-}] %msg%n%ex"/>

    <!-- ============================== JSON Appender（sit/uat/prod 通用） ============================== -->
    <!--
      SentryLogbackLayout 为 LayoutBase<ILoggingEvent>，自动注入 traceId/userId/username。
      通过 mdcFields 显式追加 tenantId，使其落入 JSON 的 extra 字段。
    -->
    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <layout class="com.remisoft.common.sentry.logging.SentryLogbackLayout">
            <appName>${APP_NAME}</appName>
            <profile>${PROFILE}</profile>
            <mdcFields>traceId,userId,username,tenantId</mdcFields>
        </layout>
    </appender>

    <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/${APP_NAME}.json</file>
        <append>true</append>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_ARCHIVE}/${APP_NAME}.%d{yyyy-MM-dd}.%i.json.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>10GB</totalSizeCap>
        </rollingPolicy>
        <layout class="com.remisoft.common.sentry.logging.SentryLogbackLayout">
            <appName>${APP_NAME}</appName>
            <profile>${PROFILE}</profile>
            <mdcFields>traceId,userId,username,tenantId</mdcFields>
        </layout>
    </appender>

    <!-- ============================== dev profile ============================== -->
    <!-- 控制台输出，DEBUG 级别，非 JSON 格式（pattern 含 traceId/userId/tenantId） -->
    <springProfile name="dev">
        <appender name="DEV_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>${CONSOLE_PATTERN}</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>

        <root level="DEBUG">
            <appender-ref ref="DEV_CONSOLE"/>
        </root>

        <!-- 框架级别噪声抑制（dev 仍保留足够信息） -->
        <logger name="org.springframework" level="INFO"/>
        <logger name="org.springframework.boot.web.embedded" level="INFO"/>
        <logger name="org.hibernate" level="INFO"/>
        <logger name="com.zaxxer.hikari" level="INFO"/>
        <logger name="io.netty" level="INFO"/>
    </springProfile>

    <!-- ============================== sit / uat profile ============================== -->
    <!-- 控制台 + 文件，INFO 级别，JSON 格式 -->
    <springProfile name="sit,uat">
        <root level="INFO">
            <appender-ref ref="JSON_CONSOLE"/>
            <appender-ref ref="JSON_FILE"/>
        </root>

        <!-- 测试环境适度抑制框架日志 -->
        <logger name="org.springframework" level="WARN"/>
        <logger name="org.hibernate" level="WARN"/>
        <logger name="com.zaxxer.hikari" level="WARN"/>
        <logger name="io.netty" level="WARN"/>
    </springProfile>

    <!-- ============================== prod profile ============================== -->
    <!-- 文件 + 滚动归档，WARN 级别，JSON 格式，单文件 100MB，保留 30 天 -->
    <springProfile name="prod">
        <!-- prod 默认不输出控制台，仅写文件；如需控制台可通过覆盖追加 JSON_CONSOLE -->
        <root level="WARN">
            <appender-ref ref="JSON_FILE"/>
        </root>

        <!-- 生产环境严格抑制框架噪声 -->
        <logger name="org.springframework" level="WARN"/>
        <logger name="org.hibernate" level="WARN"/>
        <logger name="com.zaxxer.hikari" level="WARN"/>
        <logger name="io.netty" level="WARN"/>
        <!-- 业务安全相关 logger 保留 INFO 便于审计 -->
        <logger name="com.remisoft.common.safe" level="INFO"/>
        <logger name="com.remisoft.common.audit" level="INFO"/>
    </springProfile>

</included>
