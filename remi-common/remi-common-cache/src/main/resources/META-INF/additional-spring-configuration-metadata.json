{
  "properties": [
    {
      "name": "remi.cache.type",
      "type": "java.lang.String",
      "description": "缓存类型。可选值：CONCURRENT、LRU、LFU、TINYLFU、REFERENCE、WEIGHTED、TTL、LOADING。默认 TINYLFU。"
    },
    {
      "name": "remi.cache.cache-names",
      "type": "java.util.List",
      "description": "缓存名称列表。"
    },
    {
      "name": "remi.cache.maximum-size",
      "type": "java.lang.Long",
      "description": "缓存最大容量（默认 1000）。"
    },
    {
      "name": "remi.cache.expire-after-write",
      "type": "java.lang.Long",
      "description": "写入后过期时间（默认 30）。"
    },
    {
      "name": "remi.cache.expire-time-unit",
      "type": "java.lang.String",
      "description": "过期时间单位（SECONDS、MINUTES、HOURS、DAYS）。默认 MINUTES。"
    },
    {
      "name": "remi.cache.allow-null-values",
      "type": "java.lang.Boolean",
      "description": "是否允许缓存 null 值（默认 true）。"
    },
    {
      "name": "remi.cache.caches",
      "type": "java.util.Map",
      "description": "per-cache 配置（覆盖全局默认），key 为缓存名称。"
    }
  ]
}
