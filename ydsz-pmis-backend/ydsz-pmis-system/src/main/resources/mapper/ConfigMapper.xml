<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.njydsz.pmis.config.mapper.ConfigMapper">

    <!-- 通用结果映射 -->
    <resultMap id="BaseResultMap" type="com.njydsz.pmis.config.entity.ConfigDO">
        <id     column="id"            property="id"/>
        <result column="config_group"  property="configGroup"/>
        <result column="config_key"    property="configKey"/>
        <result column="config_value"  property="configValue"/>
        <result column="default_value" property="defaultValue"/>
        <result column="value_type"    property="valueType"/>
        <result column="description"   property="description"/>
        <result column="is_public"     property="isPublic"/>
        <result column="sort_order"    property="sortOrder"/>
        <result column="status"        property="status"/>
        <result column="created_by"    property="createdBy"/>
        <result column="created_at"    property="createdAt"/>
        <result column="updated_by"    property="updatedBy"/>
        <result column="updated_at"    property="updatedAt"/>
        <result column="deleted"       property="deleted"/>
    </resultMap>

    <!-- 通用列 -->
    <sql id="Base_Column_List">
        id, config_group, config_key, config_value, default_value,
        value_type, description, is_public, sort_order, status,
        created_by, created_at, updated_by, updated_at, deleted
    </sql>

    <!-- 按 group 查询全部配置（XML 版,与 @Select 注解保持一致) -->
    <select id="selectByGroup" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM pmis_config
        WHERE config_group = #{group}
          AND deleted = 0
        ORDER BY sort_order ASC, id ASC
    </select>

    <!-- 按 group + key 唯一查询 -->
    <select id="selectByGroupAndKey" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM pmis_config
        WHERE config_group = #{group}
          AND config_key   = #{key}
          AND deleted = 0
        LIMIT 1
    </select>

    <!-- 公开配置(前端可见) -->
    <select id="selectPublic" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM pmis_config
        WHERE is_public = 1
          AND deleted = 0
        ORDER BY sort_order ASC, id ASC
    </select>

    <!-- 按 group 删除所有配置(级联清理用) -->
    <update id="deleteByGroup">
        UPDATE pmis_config
        SET deleted = 1, updated_at = CURRENT_TIMESTAMP
        WHERE config_group = #{group}
          AND deleted = 0
    </update>

    <!-- 按 group 启用/停用批量 -->
    <update id="updateStatusByGroup">
        UPDATE pmis_config
        SET status = #{status}, updated_at = CURRENT_TIMESTAMP
        WHERE config_group = #{group}
          AND deleted = 0
    </update>

</mapper>
