<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.njydsz.pmis.system.mapper.MessageTemplateMapper">

    <resultMap id="BaseResultMap" type="com.njydsz.pmis.system.entity.MessageTemplateDO">
        <id column="id" property="id"/>
        <result column="template_code" property="templateCode"/>
        <result column="channel" property="channel"/>
        <result column="subject" property="subject"/>
        <result column="content" property="content"/>
        <result column="provider" property="provider"/>
        <result column="provider_key" property="providerKey"/>
        <result column="sign_name" property="signName"/>
        <result column="status" property="status"/>
        <result column="description" property="description"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="create_by" property="createdBy"/>
        <result column="create_time" property="createdAt"/>
        <result column="update_by" property="updatedBy"/>
        <result column="update_time" property="updatedAt"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, template_code, channel, subject, content, provider, provider_key, sign_name,
        status, description, tenant_id, create_by, create_time, update_by, update_time, deleted
    </sql>

    <select id="selectByCodeAndChannel" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM pmis_message_template
        WHERE template_code = #{code}
          AND channel = #{channel}
          AND tenant_id = #{tenantId}
          AND deleted = 0
        LIMIT 1
    </select>

    <select id="selectByChannel" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM pmis_message_template
        WHERE channel = #{channel} AND tenant_id = #{tenantId} AND deleted = 0
        ORDER BY id DESC
    </select>

</mapper>
