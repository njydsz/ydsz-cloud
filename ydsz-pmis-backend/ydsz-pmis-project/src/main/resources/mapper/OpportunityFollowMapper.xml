<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.njydsz.pmis.project.mapper.OpportunityFollowMapper">

    <resultMap id="BaseResultMap" type="com.njydsz.pmis.project.entity.OpportunityFollowDO">
        <id column="id" property="id"/>
        <result column="opportunity_id" property="opportunityId"/>
        <result column="follow_type" property="followType"/>
        <result column="follow_at" property="followAt"/>
        <result column="follower_id" property="followerId"/>
        <result column="follower_name" property="followerName"/>
        <result column="content" property="content"/>
        <result column="next_step" property="nextStep"/>
        <result column="next_follow_date" property="nextFollowDate"/>
        <result column="created_at" property="createdAt"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <select id="selectByOpportunityId" resultMap="BaseResultMap">
        SELECT id, opportunity_id, follow_type, follow_at, follower_id, follower_name, content, next_step, next_follow_date, created_at, deleted FROM pmis_project_opportunity_follow
        WHERE opportunity_id = #{opportunityId} AND deleted = 0
        ORDER BY follow_at DESC
    </select>

</mapper>
