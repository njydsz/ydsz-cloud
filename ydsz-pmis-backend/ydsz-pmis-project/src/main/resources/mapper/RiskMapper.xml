<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.njydsz.pmis.project.mapper.RiskMapper">

    <resultMap id="BaseResultMap" type="com.njydsz.pmis.project.entity.RiskDO">
        <id column="id" property="id"/>
        <result column="risk_code" property="riskCode"/>
        <result column="initiation_id" property="initiationId"/>
        <result column="risk_title" property="riskTitle"/>
        <result column="risk_type" property="riskType"/>
        <result column="description" property="description"/>
        <result column="probability" property="probability"/>
        <result column="impact" property="impact"/>
        <result column="risk_level" property="riskLevel"/>
        <result column="mitigation" property="mitigation"/>
        <result column="contingency" property="contingency"/>
        <result column="owner_id" property="ownerId"/>
        <result column="owner_name" property="ownerName"/>
        <result column="status" property="status"/>
        <result column="occurred_at" property="occurredAt"/>
        <result column="closed_at" property="closedAt"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="provider_trace_id" property="providerTraceId"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <select id="selectByCode" resultMap="BaseResultMap">
        SELECT * FROM pmis_execution_risk
        WHERE risk_code = #{code} AND deleted = 0 LIMIT 1
    </select>

    <update id="updateStatus">
        UPDATE pmis_execution_risk
        SET status = #{status}, updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id} AND deleted = 0
    </update>

    <select id="selectByInitiation" resultMap="BaseResultMap">
        SELECT * FROM pmis_execution_risk
        WHERE initiation_id = #{initiationId} AND deleted = 0
        ORDER BY created_at DESC
    </select>

    <select id="aggregateByLevel" resultType="java.util.Map">
        SELECT risk_level, COUNT(1) AS cnt
        FROM pmis_execution_risk
        WHERE initiation_id = #{initiationId} AND deleted = 0
        GROUP BY risk_level
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT * FROM pmis_execution_risk
        WHERE deleted = 0
        ORDER BY created_at DESC
    </select>

    <!--
      批次18 增量：按风险等级统计未结风险数量
      仅统计 status != 'CLOSED' 的活跃风险
    -->
    <select id="countByRiskLevel" resultType="java.util.Map">
        SELECT COALESCE(NULLIF(risk_level, ''), 'UNKNOWN') AS risk_level,
               COUNT(1)                                  AS cnt
        FROM pmis_execution_risk
        WHERE deleted = 0
          AND (status IS NULL OR status &lt;&gt; 'CLOSED')
        GROUP BY COALESCE(NULLIF(risk_level, ''), 'UNKNOWN')
    </select>
</mapper>
