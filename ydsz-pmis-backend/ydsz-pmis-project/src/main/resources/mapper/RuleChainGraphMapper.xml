<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.njydsz.pmis.project.mapper.RuleChainGraphMapper">

    <select id="selectByRuleCode" resultType="com.njydsz.pmis.project.entity.RuleChainGraphDO">
        SELECT * FROM pmis_rule_chain_graph WHERE rule_code = #{ruleCode} LIMIT 1
    </select>

    <delete id="deleteByRuleCode">
        DELETE FROM pmis_rule_chain_graph WHERE rule_code = #{ruleCode}
    </delete>

</mapper>
