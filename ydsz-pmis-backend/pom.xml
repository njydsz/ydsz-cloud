<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.njydsz.pmis</groupId>
    <artifactId>ydsz-pmis-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>ydsz-pmis-parent</name>
    <description>南京云顶 PMIS 后端父工程</description>

    <modules>
        <module>ydsz-pmis-common</module>
        <module>ydsz-pmis-gateway</module>
        <module>ydsz-pmis-system</module>
        <module>ydsz-pmis-userinfo</module>
        <module>ydsz-pmis-literule</module>
        <module>ydsz-pmis-project</module>
        <module>ydsz-pmis-cronjob</module>
        <module>ydsz-pmis-workflow</module>
        <module>ydsz-pmis-agent</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.encoding>UTF-8</maven.compiler.encoding>

        <!-- 框架版本 -->
        <spring-cloud.version>2025.1.2</spring-cloud.version>
        <spring-cloud-alibaba.version>2025.1.0.0</spring-cloud-alibaba.version>

        <!-- 组件版本 -->
        <mybatis-plus.version>3.5.16</mybatis-plus.version>
        <postgresql.version>42.7.4</postgresql.version>
        <druid.version>1.2.28</druid.version>
        <hutool.version>5.8.46</hutool.version>
        <resilience4j.version>2.2.0</resilience4j.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok.version>1.18.42</lombok.version>
        <fastjson2.version>2.0.62</fastjson2.version>
        <jjwt.version>0.12.6</jjwt.version>
        <bcprov.version>1.78.1</bcprov.version>
        <knife4j.version>4.5.0</knife4j.version>
        <easyexcel.version>4.0.3</easyexcel.version>
        <commons-csv.version>1.11.0</commons-csv.version>
        <commons-io.version>2.16.1</commons-io.version>
        <logstash.encoder.version>7.4</logstash.encoder.version>
        <minio.version>8.5.11</minio.version>
        <redisson.version>4.6.1</redisson.version>
        <easycaptcha.version>1.6.2</easycaptcha.version>
        <poi.version>5.5.1</poi.version>
        <openpdf.version>1.3.30</openpdf.version>
        <rocketmq.spring.version>2.3.1</rocketmq.spring.version>
        <seata.version>2.5.0</seata.version>

        <!-- 测试 -->
        <springdoc.version>2.8.13</springdoc.version>
        <testcontainers.version>1.20.2</testcontainers.version>

        <!-- 质量与安全扫描（P0-3：CI 质量门禁） -->
        <skipDependencyCheck>true</skipDependencyCheck>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Cloud BOM -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring Cloud Alibaba BOM -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 内部模块 -->
            <dependency>
                <groupId>com.njydsz.pmis</groupId>
                <artifactId>ydsz-pmis-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.njydsz.pmis</groupId>
                <artifactId>ydsz-pmis-userinfo</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.njydsz.pmis</groupId>
                <artifactId>ydsz-pmis-project</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.njydsz.pmis</groupId>
                <artifactId>ydsz-pmis-cronjob</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.njydsz.pmis</groupId>
                <artifactId>ydsz-pmis-system</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.njydsz.pmis</groupId>
                <artifactId>ydsz-pmis-literule</artifactId>
                <version>${project.version}</version>
