{
  "properties": [
    {
      "name": "pmis.event.outbox.enabled",
      "type": "java.lang.Boolean",
      "description": "是否启用 Outbox 模式。",
      "defaultValue": true
    },
    {
      "name": "pmis.event.outbox.table-name",
      "type": "java.lang.String",
      "description": "Outbox 表名。",
      "defaultValue": "pmis_outbox"
    },
    {
      "name": "pmis.event.outbox.poll-interval-seconds",
      "type": "java.lang.Long",
      "description": "轮询间隔（秒）。",
      "defaultValue": 5
    },
    {
      "name": "pmis.event.outbox.batch-size",
      "type": "java.lang.Integer",
      "description": "每批最大条数。",
      "defaultValue": 100
    },
    {
      "name": "pmis.event.outbox.max-retries",
      "type": "java.lang.Integer",
      "description": "默认最大重试次数。",
      "defaultValue": 5
    },
    {
      "name": "pmis.event.outbox.base-backoff-seconds",
      "type": "java.lang.Long",
      "description": "基础退避秒数。",
      "defaultValue": 10
    },
    {
      "name": "pmis.event.outbox.max-backoff-seconds",
      "type": "java.lang.Long",
      "description": "最大退避秒数。",
      "defaultValue": 3600
    },
    {
      "name": "pmis.event.outbox.sent-retention-days",
      "type": "java.lang.Integer",
      "description": "已投递消息保留天数（0=不清理）。",
      "defaultValue": 7
    },
    {
      "name": "pmis.event.outbox.auto-cleanup",
      "type": "java.lang.Boolean",
      "description": "是否启用自动清理。",
      "defaultValue": true
    },
    {
      "name": "pmis.event.outbox.cleanup-interval-hours",
      "type": "java.lang.Long",
      "description": "清理间隔（小时）。",
      "defaultValue": 6
    },
    {
      "name": "pmis.event.outbox.max-payload-size-bytes",
      "type": "java.lang.Integer",
      "description": "消息 payload 最大字节数。",
      "defaultValue": 4194304
    },
    {
      "name": "pmis.event.outbox.default-priority",
      "type": "java.lang.Integer",
      "description": "默认优先级（0-9，9 最高）。",
      "defaultValue": 5
    },
    {
      "name": "pmis.event.outbox.default-schema-version",
      "type": "java.lang.String",
      "description": "默认 Schema 版本号。",
      "defaultValue": "v1.0.0"
    },
    {
      "name": "pmis.event.outbox.stale-processing-threshold-minutes",
      "type": "java.lang.Integer",
      "description": "PROCESSING 状态超时阈值（分钟），超时后回收为 PENDING。",
      "defaultValue": 5
    },
    {
      "name": "pmis.event.outbox.pending-alert-threshold",
      "type": "java.lang.Long",
      "description": "PENDING 积压告警阈值。",
      "defaultValue": 10000
    },
    {
      "name": "pmis.event.outbox.dead-letter-alert-threshold",
      "type": "java.lang.Long",
      "description": "DEAD_LETTER 告警阈值。",
      "defaultValue": 10
    },
    {
      "name": "pmis.event.outbox.enable-tenant-isolation",
      "type": "java.lang.Boolean",
      "description": "是否启用租户隔离。",
      "defaultValue": true
    },
    {
      "name": "pmis.event.outbox.enable-sync-publish",
      "type": "java.lang.Boolean",
      "description": "是否启用同步投递模式（事务提交后立即投递）。",
      "defaultValue": false
    }
  ]
}
