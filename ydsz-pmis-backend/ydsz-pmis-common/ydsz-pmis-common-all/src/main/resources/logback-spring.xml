<?xml version="1.0" encoding="UTF-8"?>
<!-- PMIS 统一日志配置（ELK 友好）: 控制台/FILE_ALL/FILE_ERROR/JSON_FILE/LOGSTASH/ASYNC -->
<configuration>

    <!-- 通用属性 -->
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{traceId:-}] [%thread] %logger{36} - %msg%n"/>
    <property name="LOG_HOME" value="${LOG_HOME:-./logs}"/>
    <!-- Logstash TCP 接入点（默认关闭；生产通过 ENV 启用） -->
    <property name="LOGSTASH_HOST" value="${LOGSTASH_HOST:-}"/>
    <property name="LOGSTASH_PORT" value="${LOGSTASH_PORT:-5044}"/>
    <property name="LOGSTASH_ENABLED" value="${LOGSTASH_ENABLED:-false}"/>

    <!-- Spring 上下文属性: 用于 LOGSTASH_JSON appender 注入 context 字段 -->
    <!-- appName: 从 spring.application.name 读取,默认 pmis -->
    <springProperty name="APP_NAME" source="spring.application.name" defaultValue="pmis"/>
    <!-- profile: 从 spring.profiles.active 读取,默认空(dev 模式) -->
    <springProperty name="ACTIVE_PROFILE" source="spring.profiles.active" defaultValue="dev"/>
    <!-- hostname: 优先用 ENV HOSTNAME,回退到系统属性 -->
    <springProperty name="HOST_NAME" source="HOSTNAME" defaultValue="${COMPUTERNAME:-unknown}"/>

    <!-- 控制台输出（开发期可读） -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 全部日志文件（人类可读） -->
    <appender name="FILE_ALL" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/${APP_NAME}/all.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/${APP_NAME}/all.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>50GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 错误日志文件（仅 ERROR） -->
    <appender name="FILE_ERROR" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/${APP_NAME}/error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/${APP_NAME}/error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>90</maxHistory>
            <totalSizeCap>20GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- JSON 文件（Filebeat 直采） -->
    <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/${APP_NAME}/app.json.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/${APP_NAME}/app.json.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>50GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <!-- 静态字段：注入 ELK 检索维度 -->
            <customFields>{"app":"${APP_NAME}","host":"${HOST_NAME}"}</customFields>
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
            <includeMdcKeyName>requestUri</includeMdcKeyName>
            <fieldNames>
                <timestamp>@timestamp</timestamp>
                <message>message</message>
                <thread>thread</thread>
                <logger>logger</logger>
                <level>level</level>
            </fieldNames>
        </encoder>
    </appender>

    <!-- LOGSTASH_JSON - 生产环境控制台 JSON 结构化输出(Promtail / Filebeat 直采 stdout)
         与 JSON_FILE 区别:
           - 输出到 ConsoleAppender(stdout),适配容器环境(docker logs / kubectl logs)
           - MDC 增加 username,context 增加 appName/hostname/profile
           - @timestamp 使用 logback 原生时间戳(fieldNames.timestamp=@timestamp) -->
    <appender name="LOGSTASH_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <!-- 上下文静态字段: appName / hostname / profile(供 Loki/Prometheus 标签提取) -->
            <customFields>{"appName":"${APP_NAME}","hostname":"${HOST_NAME}","profile":"${ACTIVE_PROFILE}"}</customFields>
            <!-- MDC 字段: traceId(链路追踪) / userId(用户标识) / username(用户名) -->
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
            <includeMdcKeyName>username</includeMdcKeyName>
            <!-- 自定义 fieldNames: @timestamp 用 logback 原生时间戳(不覆盖) -->
            <fieldNames>
                <timestamp>@timestamp</timestamp>
                <message>message</message>
                <thread>thread</thread>
                <logger>logger</logger>
                <level>level</level>
                <stackTrace>stack_trace</stackTrace>
            </fieldNames>
        </encoder>
    </appender>

    <!-- Logstash TCP 发送（生产环境 LOGSTASH_ENABLED=true 时启用） -->
    <if condition='property("LOGSTASH_ENABLED").equals("true")'>
        <then>
            <appender name="LOGSTASH" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
                <destination>${LOGSTASH_HOST}:${LOGSTASH_PORT}</destination>
                <reconnectionDelay>5 seconds</reconnectionDelay>
                <writeTimeout>10 seconds</writeTimeout>
                <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                    <customFields>{"app":"${APP_NAME}","host":"${HOST_NAME}"}</customFields>
                    <includeMdcKeyName>traceId</includeMdcKeyName>
                    <includeMdcKeyName>userId</includeMdcKeyName>
                </encoder>
            </appender>
        </then>
    </if>

    <!-- 异步写入：解耦业务线程与磁盘 IO/网络发送 -->
    <appender name="ASYNC_ALL" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="FILE_ALL"/>
        <queueSize>2048</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
    </appender>

    <appender name="ASYNC_ERROR" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="FILE_ERROR"/>
        <queueSize>1024</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
    </appender>

    <appender name="ASYNC_JSON" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="JSON_FILE"/>
        <queueSize>4096</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
    </appender>

    <!-- LOGSTASH_JSON 异步包装: 解耦业务线程与 stdout IO -->
    <appender name="ASYNC_LOGSTASH_JSON" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="LOGSTASH_JSON"/>
        <queueSize>4096</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
    </appender>

    <if condition='property("LOGSTASH_ENABLED").equals("true")'>
        <then>
            <appender name="ASYNC_LOGSTASH" class="ch.qos.logback.classic.AsyncAppender">
                <appender-ref ref="LOGSTASH"/>
                <queueSize>2048</queueSize>
                <discardingThreshold>0</discardingThreshold>
                <neverBlock>true</neverBlock>
            </appender>
        </then>
    </if>

    <!-- 框架日志级别控制 -->
    <logger name="com.njydsz.pmis" level="DEBUG"/>
    <logger name="org.springframework" level="INFO"/>
    <logger name="org.apache.ibatis" level="INFO"/>
    <logger name="com.baomidou.mybatisplus" level="INFO"/>
    <!-- P2-1: MyBatis SQL 日志（慢SQL监控，DEBUG级别输出完整SQL及参数） -->
    <logger name="com.njydsz.pmis.project.mapper" level="DEBUG"/>
    <logger name="com.njydsz.pmis.workflow.mapper" level="DEBUG"/>
    <logger name="com.njydsz.pmis.system.mapper" level="DEBUG"/>
    <logger name="com.njydsz.pmis.userinfo.mapper" level="DEBUG"/>
    <logger name="com.alibaba.nacos" level="WARN"/>
    <logger name="org.apache.dubbo" level="WARN"/>

    <!-- 审计日志补偿文件：当落库失败且重试仍失败时，将事件 JSON 写入此文件供运维/对账补录 -->
    <appender name="AUDIT_FALLBACK_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/${APP_NAME}/audit-fallback.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/${APP_NAME}/audit-fallback.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>180</maxHistory>
            <totalSizeCap>10GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <!-- 仅输出 message（JSON 行格式），便于 Filebeat/logstash 直接采集回灌 -->
            <pattern>%msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- audit-fallback logger：additivity=false 避免重复打印到主日志 -->
    <logger name="audit-fallback" level="INFO" additivity="false">
        <appender-ref ref="AUDIT_FALLBACK_FILE"/>
    </logger>

    <!-- Root - 按 Spring Profile 切换日志输出策略
         dev  : STDOUT(pattern 可读) + FILE_ALL + FILE_ERROR,便于本地调试
         prod : LOGSTASH_JSON(控制台 JSON,Promtail/Filebeat 直采) + FILE_ERROR,适配容器化日志聚合
         默认 : 兼容旧行为(STDOUT + FILE_ALL + FILE_ERROR + JSON_FILE),用于 sit/uat 等中间环境 -->
    <springProfile name="dev">
        <root level="INFO">
            <appender-ref ref="STDOUT"/>
            <appender-ref ref="ASYNC_ALL"/>
            <appender-ref ref="ASYNC_ERROR"/>
            <if condition='property("LOGSTASH_ENABLED").equals("true")'>
                <then>
                    <appender-ref ref="ASYNC_LOGSTASH"/>
                </then>
            </if>
        </root>
    </springProfile>

    <springProfile name="prod">
        <!-- 生产环境: JSON 结构化输出为主,保留 FILE_ERROR 兜底 -->
        <root level="INFO">
            <appender-ref ref="ASYNC_LOGSTASH_JSON"/>
            <appender-ref ref="ASYNC_ERROR"/>
            <if condition='property("LOGSTASH_ENABLED").equals("true")'>
                <then>
                    <appender-ref ref="ASYNC_LOGSTASH"/>
                </then>
            </if>
        </root>
    </springProfile>

    <!-- 非 dev/prod 的环境(sit/uat/test 等): 保持旧行为,兼容既有部署 -->
    <springProfile name="!dev &amp; !prod">
        <root level="INFO">
            <appender-ref ref="STDOUT"/>
            <appender-ref ref="ASYNC_ALL"/>
            <appender-ref ref="ASYNC_ERROR"/>
            <appender-ref ref="ASYNC_JSON"/>
            <if condition='property("LOGSTASH_ENABLED").equals("true")'>
                <then>
                    <appender-ref ref="ASYNC_LOGSTASH"/>
                </then>
            </if>
        </root>
    </springProfile>

</configuration>
