<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.njydsz.pmis</groupId>
        <artifactId>ydsz-pmis-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>ydsz-pmis-common</artifactId>
    <packaging>pom</packaging>
    <name>ydsz-pmis-common</name>
    <description>PMIS Common - 公共依赖聚合模块</description>

    <modules>
        <!-- L1 基础设施层 -->
        <module>ydsz-pmis-common-core</module>
        <!-- L2 工具模块层 -->
        <module>ydsz-pmis-common-util</module>
        <!-- L3 基础服务层 -->
        <module>ydsz-pmis-common-domain</module>
        <module>ydsz-pmis-common-exception</module>
        <!-- L4 基础数据层 -->
        <module>ydsz-pmis-common-jdbc</module>
        <module>ydsz-pmis-common-redis</module>
        <module>ydsz-pmis-common-lock</module>
        <!-- L5 业务服务层 -->
        <module>ydsz-pmis-common-auth</module>
        <module>ydsz-pmis-common-safe</module>
        <module>ydsz-pmis-common-feign</module>
        <module>ydsz-pmis-common-audit</module>
        <module>ydsz-pmis-common-file</module>
        <module>ydsz-pmis-common-notify</module>
        <module>ydsz-pmis-common-queue</module>
        <module>ydsz-pmis-common-doc</module>
        <module>ydsz-pmis-common-infra</module>
        <!-- L6 应用层 -->
        <module>ydsz-pmis-common-base</module>
        <module>ydsz-pmis-common-web</module>
        <module>ydsz-pmis-common-app</module>
        <!-- 聚合 -->
        <module>ydsz-pmis-common-all</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- L1 -->
            <dependency>
                <groupId>com.njydsz.pmis</groupId>
                <artifactId>ydsz-pmis-common-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- L2 -->
            <dependency>
                <groupId>com.njydsz.pmis</groupId>
                <artifactId>ydsz-pmis-common-util</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- L3 -->
            <dependency>
                <groupId>com.njydsz.pmis</groupId>
                <artifactId>ydsz-pmis-common-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.njydsz.pmis</groupId>
                <artifactId>ydsz-pmis-common-exception</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- L4 -->
            <dependency>
                <groupId>com.njydsz.pmis</groupId>
                <artifactId>ydsz-pmis-common-jdbc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.njydsz.pmis</groupId>
                <artifactId>ydsz-pmis-common-redis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.njydsz.pmis</groupId>
                <artifactId>ydsz-pmis-common-lock</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- L5 -->
            <dependency>
                <groupId>com.njydsz.pmis</groupId>
                <artifactId>ydsz-pmis-common-auth</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.njydsz.pmis</groupId>
                <artifactId>ydsz-pmis-common-safe</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.njydsz.pmis</groupId>
                <artifactId>ydsz-pmis-common-feign</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.njydsz.pmis</groupId>
                <artifactId>ydsz-pmis-common-audit</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.njydsz.pmis</groupId>
                <artifactId>ydsz-pmis-common-file</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.njydsz.pmis</groupId>
                <artifactId>ydsz-pmis-common-notify</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.njydsz.pmis</groupId>
                <artifactId>ydsz-pmis-common-queue</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.njydsz.pmis</groupId>
                <artifactId>ydsz-pmis-common-doc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.njydsz.pmis</groupId>
                <artifactId>ydsz-pmis-common-infra</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- L6 -->
            <dependency>
                <groupId>com.njydsz.pmis</groupId>
                <artifactId>ydsz-pmis-common-base</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.njydsz.pmis</groupId>
                <artifactId>ydsz-pmis-common-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.njydsz.pmis</groupId>
                <artifactId>ydsz-pmis-common-app</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- 所有子模块继承的公共依赖 -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <version>${caffeine.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
