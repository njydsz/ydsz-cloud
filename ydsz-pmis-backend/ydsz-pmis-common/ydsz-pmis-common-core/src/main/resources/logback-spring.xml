<?xml version="1.0" encoding="UTF-8"?>
<!--
  PMIS 共享 Logback 配置（所有微服务通过依赖 ydsz-pmis-common-core 自动继承）

  Profile 切换：
    dev / sit（默认）→ CONSOLE  人类可读彩色输出
    prod / uat       → JSON     结构化 JSON（供 Loki / ELK 采集）+ 文件滚动归档

  MDC 字段（由各模块 Filter / Interceptor 填充）：
    traceId   → SkyWalking Agent 自动注入（需开启 plugin.toolkit.log.logback_1_x）
    userId    → AuthInterceptor 填充
    tenantId  → TenantInterceptor 填充

  覆盖方式：
    在业务服务的 src/main/resources/ 下放置自己的 logback-spring.xml 即可覆盖本配置
-->
<configuration>

    <!-- 引入 Spring Boot 默认日志级别和彩色方案 -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- 从 Spring Environment 读取应用名和 Profile -->
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="unknown"/>
    <springProperty scope="context" name="activeProfile" source="spring.profiles.active" defaultValue="dev"/>

    <!-- ======================== Appender 定义 ======================== -->

    <!-- 控制台 Appender（dev/sit/默认，人类可读） -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [%thread] [%X{traceId:-}] %cyan(%logger{40}) - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- JSON 控制台 Appender（prod/uat，结构化 JSON 供 Loki 采集） -->
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
            <includeMdcKeyName>tenantId</includeMdcKeyName>
            <customFields>{"app":"${appName}","profile":"${activeProfile}"}</customFields>
            <fieldNames>
                <timestamp>@timestamp</timestamp>
                <version>[ignore]</version>
                <levelValue>[ignore]</levelValue>
                <logger>logger</logger>
            </fieldNames>
            <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                <maxDepthPerThrowable>30</maxDepthPerThrowable>
                <maxLength>4096</maxLength>
                <shortenedClassNameLength>20</shortenedClassNameLength>
            </throwableConverter>
        </encoder>
    </appender>

    <!-- JSON 文件 Appender（prod/uat，滚动归档） -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/${appName}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/${appName}-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
            <includeMdcKeyName>tenantId</includeMdcKeyName>
            <customFields>{"app":"${appName}","profile":"${activeProfile}"}</customFields>
        </encoder>
    </appender>

    <!-- ======================== 噪声日志抑制 ======================== -->

    <logger name="org.hibernate.SQL" level="WARN"/>
    <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="WARN"/>
    <logger name="org.hibernate.engine.transaction" level="WARN"/>
    <logger name="com.alibaba.nacos" level="WARN"/>
    <logger name="com.alibaba.cloud" level="WARN"/>
    <logger name="com.alibaba.druid" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="io.lettuce" level="WARN"/>
    <logger name="io.lettuce.core" level="WARN"/>
    <logger name="org.springframework.cloud" level="INFO"/>
    <logger name="org.springframework.security" level="INFO"/>
    <logger name="org.apache.ibatis" level="INFO"/>
    <logger name="com.baomidou.mybatisplus" level="INFO"/>
    <logger name="org.reflections" level="WARN"/>
    <logger name="io.swagger" level="WARN"/>
    <logger name="org.springdoc" level="WARN"/>

    <!-- ======================== Profile 路由 ======================== -->

    <!-- dev / sit / 默认：控制台人类可读 -->
    <springProfile name="!prod &amp; !uat">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- prod / uat：JSON 控制台 + 文件归档 -->
    <springProfile name="prod,uat">
        <root level="INFO">
            <appender-ref ref="JSON"/>
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>

</configuration>
