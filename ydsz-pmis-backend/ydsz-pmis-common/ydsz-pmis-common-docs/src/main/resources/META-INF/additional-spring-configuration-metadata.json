{
  "properties": [
    {
      "name": "ydsz.docs.enabled",
      "type": "java.lang.Boolean",
      "description": "是否启用文档处理模块",
      "defaultValue": true
    },
    {
      "name": "ydsz.docs.max-file-size-mb",
      "type": "java.lang.Integer",
      "description": "最大文件大小(MB)",
      "defaultValue": 50
    },
    {
      "name": "ydsz.docs.parse-timeout-seconds",
      "type": "java.lang.Integer",
      "description": "解析超时时间(秒)",
      "defaultValue": 60
    },
    {
      "name": "ydsz.docs.security-scan-enabled",
      "type": "java.lang.Boolean",
      "description": "是否启用安全扫描",
      "defaultValue": true
    },
    {
      "name": "ydsz.docs.pii-detection-enabled",
      "type": "java.lang.Boolean",
      "description": "是否启用PII检测",
      "defaultValue": true
    },
    {
      "name": "ydsz.docs.preprocess-enabled",
      "type": "java.lang.Boolean",
      "description": "是否启用预处理",
      "defaultValue": true
    },
    {
      "name": "ydsz.docs.watermark-enabled",
      "type": "java.lang.Boolean",
      "description": "是否启用水印",
      "defaultValue": true
    },
    {
      "name": "ydsz.docs.redact-enabled",
      "type": "java.lang.Boolean",
      "description": "是否启用脱敏",
      "defaultValue": true
    },
    {
      "name": "ydsz.docs.async-pool-size",
      "type": "java.lang.Integer",
      "description": "异步线程池大小",
      "defaultValue": 4
    },
    {
      "name": "ydsz.docs.async-queue-capacity",
      "type": "java.lang.Integer",
      "description": "异步队列容量",
      "defaultValue": 100
    },
    {
      "name": "ydsz.docs.max-chunk-size",
      "type": "java.lang.Integer",
      "description": "文本分块最大字符数",
      "defaultValue": 2000
    },
    {
      "name": "ydsz.docs.chunk-overlap",
      "type": "java.lang.Integer",
      "description": "文本分块重叠字符数",
      "defaultValue": 200
    },
    {
      "name": "ydsz.docs.security-max-scan-pages",
      "type": "java.lang.Integer",
      "description": "安全扫描最大页数",
      "defaultValue": 50
    },
    {
      "name": "ydsz.docs.block-on-high-risk",
      "type": "java.lang.Boolean",
      "description": "高风险时阻止返回内容",
      "defaultValue": false
    }
  ]
}
