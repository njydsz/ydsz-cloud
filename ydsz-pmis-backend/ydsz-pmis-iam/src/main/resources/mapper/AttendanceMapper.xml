<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.njydsz.user.mapper.AttendanceMapper">

    <resultMap id="BaseResultMap" type="com.njydsz.user.entity.AttendanceDO">
        <id property="id" column="id"/>
        <result property="employeeId" column="employee_id"/>
        <result property="employeeName" column="employee_name"/>
        <result property="attendanceDate" column="attendance_date"/>
        <result property="checkInTime" column="check_in_time"/>
        <result property="checkOutTime" column="check_out_time"/>
        <result property="workHours" column="work_hours"/>
        <result property="overtimeHours" column="overtime_hours"/>
        <result property="status" column="status"/>
        <result property="workType" column="work_type"/>
        <result property="remark" column="remark"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="providerTraceId" column="provider_trace_id"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="deleted" column="deleted"/>
    </resultMap>

    <select id="selectByEmployeeAndDateRange" resultMap="BaseResultMap">
        SELECT * FROM pmis_attendance
        WHERE deleted = 0
        <if test="employeeId != null">AND employee_id = #{employeeId}</if>
        <if test="startDate != null">AND attendance_date &gt;= #{startDate}</if>
        <if test="endDate != null">AND attendance_date &lt;= #{endDate}</if>
        ORDER BY attendance_date DESC
    </select>

    <select id="statByStatus" resultType="java.util.Map">
        SELECT status,
               COUNT(*) AS count,
               COALESCE(SUM(work_hours), 0) AS total_hours
        FROM pmis_attendance
        WHERE deleted = 0
        <if test="employeeId != null">AND employee_id = #{employeeId}</if>
        <if test="startDate != null">AND attendance_date &gt;= #{startDate}</if>
        <if test="endDate != null">AND attendance_date &lt;= #{endDate}</if>
        GROUP BY status
    </select>
</mapper>
