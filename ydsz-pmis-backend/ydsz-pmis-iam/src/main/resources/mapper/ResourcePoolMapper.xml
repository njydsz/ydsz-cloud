<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.njydsz.pmis.iam.mapper.ResourcePoolMapper">

    <resultMap id="BaseResultMap" type="com.njydsz.pmis.iam.entity.ResourcePoolDO">
        <id column="id" property="id"/>
        <result column="pool_code" property="poolCode"/>
        <result column="pool_name" property="poolName"/>
        <result column="pool_type" property="poolType"/>
        <result column="department_id" property="departmentId"/>
        <result column="department_name" property="departmentName"/>
        <result column="level_range" property="levelRange"/>
        <result column="headcount" property="headcount"/>
        <result column="billable_target" property="billableTarget"/>
        <result column="description" property="description"/>
        <result column="status" property="status"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="provider_trace_id" property="providerTraceId"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <select id="selectByCode" resultMap="BaseResultMap">
        SELECT * FROM pmis_resource_pool
        WHERE pool_code = #{code} AND deleted = 0 LIMIT 1
    </select>

    <select id="selectByType" resultMap="BaseResultMap">
        SELECT * FROM pmis_resource_pool
        WHERE pool_type = #{poolType} AND deleted = 0
        ORDER BY headcount DESC
    </select>

    <select id="selectByDept" resultMap="BaseResultMap">
        SELECT * FROM pmis_resource_pool
        WHERE department_id = #{departmentId} AND deleted = 0
        ORDER BY created_at DESC
    </select>
</mapper>
