<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.njydsz.pmis.nextwiki.infra.mapper.FileVersionMapper">

    <resultMap id="FileVersionResult" type="com.njydsz.pmis.nextwiki.domain.entity.FileVersion">
        <id column="id" property="id"/>
        <result column="file_node_id" property="fileNodeId"/>
        <result column="version_number" property="versionNumber"/>
        <result column="storage_key" property="storageKey"/>
        <result column="size" property="size"/>
        <result column="file_hash" property="fileHash"/>
        <result column="mime_type" property="mimeType"/>
        <result column="remark" property="remark"/>
        <result column="change_type" property="changeType"/>
        <result column="is_active" property="isActive"/>
        <result column="status" property="status"/>
        <result column="created_by" property="createdBy"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_by" property="updatedBy"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="revision" property="revision"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <select id="selectByFileNodeId" resultMap="FileVersionResult">
        SELECT * FROM nw_file_version
        WHERE file_node_id = #{fileNodeId} AND deleted = 0
        ORDER BY version_number DESC
    </select>

    <select id="selectByVersion" resultMap="FileVersionResult">
        SELECT * FROM nw_file_version
        WHERE file_node_id = #{fileNodeId} AND version_number = #{versionNumber} AND deleted = 0
    </select>

    <select id="selectActiveVersion" resultMap="FileVersionResult">
        SELECT * FROM nw_file_version
        WHERE file_node_id = #{fileNodeId} AND is_active = TRUE AND deleted = 0
        LIMIT 1
    </select>

    <select id="countByFileNodeId" resultType="int">
        SELECT COUNT(*) FROM nw_file_version
        WHERE file_node_id = #{fileNodeId} AND deleted = 0
    </select>

    <select id="selectOldestVersions" resultMap="FileVersionResult">
        SELECT * FROM nw_file_version
        WHERE file_node_id = #{fileNodeId} AND deleted = 0
        ORDER BY version_number ASC
        LIMIT #{limit}
    </select>

</mapper>
