<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.njydsz.pmis.nextwiki.infra.mapper.ShareLinkMapper">

    <resultMap id="ShareLinkResult" type="com.njydsz.pmis.nextwiki.domain.entity.ShareLink">
        <id column="id" property="id"/>
        <result column="file_node_id" property="fileNodeId"/>
        <result column="share_code" property="shareCode"/>
        <result column="extract_code" property="extractCode"/>
        <result column="share_type" property="shareType"/>
        <result column="expire_time" property="expireTime"/>
        <result column="max_access_count" property="maxAccessCount"/>
        <result column="access_count" property="accessCount"/>
        <result column="status" property="status"/>
        <result column="password" property="password"/>
        <result column="created_by" property="createdBy"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_by" property="updatedBy"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="revision" property="revision"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <select id="selectByShareCode" resultMap="ShareLinkResult">
        SELECT * FROM nw_share_link
        WHERE share_code = #{shareCode} AND deleted = 0
    </select>

    <select id="selectByFileNodeId" resultMap="ShareLinkResult">
        SELECT * FROM nw_share_link
        WHERE file_node_id = #{fileNodeId} AND deleted = 0
        ORDER BY created_at DESC
    </select>

    <select id="selectActiveSharesByUserId" resultMap="ShareLinkResult">
        SELECT * FROM nw_share_link
        WHERE created_by = #{userId} AND deleted = 0 AND status = 'active'
        ORDER BY created_at DESC
    </select>

</mapper>
