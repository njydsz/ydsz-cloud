<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.njydsz.pmis.sales.mapper.contract.ContractSupplementMapper">

    <resultMap id="BaseResultMap" type="com.njydsz.pmis.sales.entity.ContractSupplementDO">
        <id column="id" property="id"/>
        <result column="contract_id" property="contractId"/>
        <result column="supplement_code" property="supplementCode"/>
        <result column="supplement_name" property="supplementName"/>
        <result column="supplement_type" property="supplementType"/>
        <result column="change_amount" property="changeAmount"/>
        <result column="new_total_amount" property="newTotalAmount"/>
        <result column="effective_date" property="effectiveDate"/>
        <result column="expire_date" property="expireDate"/>
        <result column="content" property="content"/>
        <result column="file_id" property="fileId"/>
        <result column="status" property="status"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="created_by" property="createdBy"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_by" property="updatedBy"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <select id="selectByContractId" resultMap="BaseResultMap">
        SELECT id, contract_id, supplement_code, supplement_name, supplement_type, change_amount, new_total_amount, effective_date, expire_date, content, file_id, status, tenant_id, created_by, created_at, updated_by, updated_at, deleted
        FROM pmis_project_contract_supplement
        WHERE contract_id = #{contractId} AND deleted = 0
        ORDER BY created_at DESC
    </select>

    <select id="selectByCode" resultMap="BaseResultMap">
        SELECT id, contract_id, supplement_code, supplement_name, supplement_type, change_amount, new_total_amount, effective_date, expire_date, content, file_id, status, tenant_id, created_by, created_at, updated_by, updated_at, deleted
        FROM pmis_project_contract_supplement
        WHERE supplement_code = #{code} AND deleted = 0 LIMIT 1
    </select>

</mapper>
