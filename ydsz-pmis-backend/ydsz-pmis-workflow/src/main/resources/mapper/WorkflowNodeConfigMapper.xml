<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.njydsz.pmis.workflow.mapper.WorkflowNodeConfigMapper">

    <resultMap id="BaseResultMap" type="com.njydsz.pmis.workflow.entity.WorkflowNodeConfigDO">
        <id column="id" property="id"/>
        <result column="process_key" property="processKey"/>
        <result column="node_id" property="nodeId"/>
        <result column="node_name" property="nodeName"/>
        <result column="assignee_type" property="assigneeType"/>
        <result column="assignee_value" property="assigneeValue"/>
        <result column="form_field_perm" property="formFieldPerm"/>
        <result column="extra_json" property="extraJson"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="create_by" property="createdBy"/>
        <result column="create_time" property="createdAt"/>
        <result column="update_by" property="updatedBy"/>
        <result column="update_time" property="updatedAt"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, process_key, node_id, node_name, assignee_type, assignee_value,
        form_field_perm, extra_json, tenant_id,
        create_by, create_time, update_by, update_time, deleted
    </sql>

    <select id="selectByNode" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM pmis_workflow_node_config
        WHERE process_key = #{processKey}
          AND node_id = #{nodeId}
          AND tenant_id = #{tenantId}
          AND deleted = 0
        LIMIT 1
    </select>

    <select id="selectByProcessKey" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM pmis_workflow_node_config
        WHERE process_key = #{processKey}
          AND tenant_id = #{tenantId}
          AND deleted = 0
        ORDER BY id ASC
    </select>

</mapper>
