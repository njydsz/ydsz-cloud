<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.njydsz.pmis.workflow.mapper.WorkflowBusinessMapper">

    <resultMap id="BaseResultMap" type="com.njydsz.pmis.workflow.entity.WorkflowBusinessDO">
        <id column="id" property="id"/>
        <result column="process_instance_id" property="processInstanceId"/>
        <result column="process_definition_key" property="processDefinitionKey"/>
        <result column="process_definition_id" property="processDefinitionId"/>
        <result column="business_type" property="businessType"/>
        <result column="business_id" property="businessId"/>
        <result column="business_no" property="businessNo"/>
        <result column="title" property="title"/>
        <result column="initiator_id" property="initiatorId"/>
        <result column="initiator_name" property="initiatorName"/>
        <result column="current_node" property="currentNode"/>
        <result column="status" property="status"/>
        <result column="start_time" property="startTime"/>
        <result column="end_time" property="endTime"/>
        <result column="duration_ms" property="durationMs"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="remark" property="remark"/>
        <result column="create_by" property="createdBy"/>
        <result column="create_time" property="createdAt"/>
        <result column="update_by" property="updatedBy"/>
        <result column="update_time" property="updatedAt"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, process_instance_id, process_definition_key, process_definition_id,
        business_type, business_id, business_no, title, initiator_id, initiator_name,
        current_node, status, start_time, end_time, duration_ms, tenant_id, remark,
        create_by, create_time, update_by, update_time, deleted
    </sql>

    <select id="selectByProcessInstanceId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM pmis_workflow_business
        WHERE process_instance_id = #{processInstanceId} AND deleted = 0
    </select>

    <select id="selectByBusiness" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM pmis_workflow_business
        WHERE business_type = #{businessType}
          AND business_id = #{businessId}
          AND deleted = 0
        ORDER BY create_time DESC
        LIMIT 1
    </select>

    <select id="selectByInitiator" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM pmis_workflow_business
        <where>
            deleted = 0 AND initiator_id = #{initiatorId}
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

    <update id="updateStatusByInstanceId">
        UPDATE pmis_workflow_business
        <set>
            <if test="status != null and status != ''">
                status = #{status},
            </if>
            <if test="currentNode != null and currentNode != ''">
                current_node = #{currentNode},
            </if>
            <if test="endTime != null">
                end_time = #{endTime},
            </if>
            <if test="durationMs != null">
                duration_ms = #{durationMs},
            </if>
            update_time = CURRENT_TIMESTAMP
        </set>
        WHERE process_instance_id = #{processInstanceId} AND deleted = 0
    </update>

</mapper>
