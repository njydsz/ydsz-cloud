<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.njydsz.pmis.workflow.infra.mapper.analytics.FlowAuditLogMapper">

    <resultMap id="BaseResultMap" type="com.njydsz.pmis.workflow.domain.entity.FlowAuditLogDO">
        <id column="id" property="id"/>
        <result column="instance_id" property="instanceId"/>
        <result column="task_id" property="taskId"/>
        <result column="flow_code" property="flowCode"/>
        <result column="business_type" property="businessType"/>
        <result column="business_id" property="businessId"/>
        <result column="node_code" property="nodeCode"/>
        <result column="node_name" property="nodeName"/>
        <result column="action" property="action"/>
        <result column="operator_id" property="operatorId"/>
        <result column="operator_name" property="operatorName"/>
        <result column="target_id" property="targetId"/>
        <result column="target_name" property="targetName"/>
        <result column="comment" property="comment"/>
        <result column="comment_type" property="commentType"/>
        <result column="operated_at" property="operatedAt"/>
        <result column="status" property="status"/>
        <result column="created_by" property="createdBy"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_by" property="updatedBy"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="deleted" property="deleted"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="provider_trace_id" property="providerTraceId"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, instance_id, task_id, flow_code, business_type, business_id,
        node_code, node_name, action, operator_id, operator_name,
        target_id, target_name, comment, comment_type, operated_at, status,
        created_by, created_at, updated_by, updated_at, deleted, tenant_id, provider_trace_id
    </sql>

    <!-- 查某实例的全部审计日志（按时间正序） -->
    <select id="selectByInstanceId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM pmis_flow_audit_log
        WHERE instance_id = #{instanceId}
          AND status = 'ENABLED'
          AND deleted = 0
        ORDER BY operated_at ASC, id ASC
    </select>

    <!-- 查某任务的操作记录 -->
    <select id="selectByTaskId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM pmis_flow_audit_log
        WHERE task_id = #{taskId}
          AND status = 'ENABLED'
          AND deleted = 0
        ORDER BY operated_at ASC, id ASC
    </select>

    <!-- 查某操作人的审计日志（P1-8: 加签历史查询） -->
    <select id="selectByOperatorId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM pmis_flow_audit_log
        WHERE operator_id = #{operatorId}
          AND status = 'ENABLED'
          AND deleted = 0
        ORDER BY operated_at DESC, id DESC
    </select>

    <!-- 查某目标人（转办/委派/加签目标）的审计日志（P1-8: 加签历史查询） -->
    <select id="selectByTargetId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM pmis_flow_audit_log
        WHERE target_id = #{targetId}
          AND status = 'ENABLED'
          AND deleted = 0
        ORDER BY operated_at DESC, id DESC
    </select>
</mapper>
