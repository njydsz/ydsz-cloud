<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.njydsz.pmis.workflow.mapper.WorkflowFormMapper">

    <resultMap id="BaseResultMap" type="com.njydsz.pmis.workflow.entity.WorkflowFormDO">
        <id column="id" property="id"/>
        <result column="form_key" property="formKey"/>
        <result column="form_name" property="formName"/>
        <result column="process_key" property="processKey"/>
        <result column="business_type" property="businessType"/>
        <result column="schema_json" property="schemaJson"/>
        <result column="version" property="version"/>
        <result column="status" property="status"/>
        <result column="description" property="description"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="create_by" property="createdBy"/>
        <result column="create_time" property="createdAt"/>
        <result column="update_by" property="updatedBy"/>
        <result column="update_time" property="updatedAt"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, form_key, form_name, process_key, business_type, schema_json,
        version, status, description, tenant_id,
        create_by, create_time, update_by, update_time, deleted
    </sql>

    <select id="selectByFormKey" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM pmis_workflow_form
        WHERE form_key = #{formKey} AND deleted = 0
        ORDER BY version DESC
        LIMIT 1
    </select>

    <select id="selectByProcessKey" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM pmis_workflow_form
        WHERE process_key = #{processKey} AND deleted = 0
        ORDER BY version DESC
    </select>

</mapper>
