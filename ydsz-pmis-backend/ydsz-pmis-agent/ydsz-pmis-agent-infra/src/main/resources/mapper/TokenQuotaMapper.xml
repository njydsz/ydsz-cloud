<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.njydsz.pmis.agent.infra.mapper.TokenQuotaMapper">

    <resultMap id="BaseResultMap" type="com.njydsz.pmis.agent.domain.entity.TokenQuotaDO">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="quota_month" property="quotaMonth"/>
        <result column="total_quota" property="totalQuota"/>
        <result column="used_tokens" property="usedTokens"/>
        <result column="status" property="status"/>
        <result column="reset_at" property="resetAt"/>
        <result column="created_by" property="createdBy"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_by" property="updatedBy"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, tenant_id, quota_month, total_quota, used_tokens, status, reset_at,
        created_by, created_at, updated_by, updated_at, deleted
    </sql>

    <select id="selectByTenantAndMonth" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM pmis_agent_token_quota
        WHERE tenant_id = #{tenantId}
          AND quota_month = #{quotaMonth}
          AND deleted = 0
        LIMIT 1
    </select>

</mapper>
