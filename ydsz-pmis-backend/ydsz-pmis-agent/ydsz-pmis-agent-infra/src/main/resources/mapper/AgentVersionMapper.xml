<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.njydsz.pmis.agent.infra.mapper.AgentVersionMapper">

    <resultMap id="BaseResultMap" type="com.njydsz.pmis.agent.domain.entity.AgentVersionDO">
        <id column="id" property="id"/>
        <result column="agent_type" property="agentType"/>
        <result column="version_id" property="versionId"/>
        <result column="status" property="status"/>
        <result column="config_json" property="configJson"/>
        <result column="description" property="description"/>
        <result column="published_at" property="publishedAt"/>
        <result column="is_active" property="isActive"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="created_by" property="createdBy"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_by" property="updatedBy"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, agent_type, version_id, status, config_json, description,
        published_at, is_active, tenant_id,
        created_by, created_at, updated_by, updated_at, deleted
    </sql>

    <!-- 按 agentType 查询所有版本（按创建时间降序） -->
    <select id="selectByAgentType" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM pmis_agent_version
        WHERE agent_type = #{agentType}
          AND deleted = 0
        ORDER BY created_at DESC
    </select>

    <!-- 查询指定 agentType 的当前活跃版本 -->
    <select id="selectActiveVersion" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM pmis_agent_version
        WHERE agent_type = #{agentType}
          AND is_active = 1
          AND deleted = 0
        LIMIT 1
    </select>

    <!-- 按 agentType + versionId 精确查询 -->
    <select id="selectByAgentTypeAndVersion" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM pmis_agent_version
        WHERE agent_type = #{agentType}
          AND version_id = #{versionId}
          AND deleted = 0
        LIMIT 1
    </select>

    <!-- 将指定 agentType 下所有版本标记为非活跃 -->
    <update id="deactivateAll">
        UPDATE pmis_agent_version
        SET is_active = 0, updated_at = NOW()
        WHERE agent_type = #{agentType}
          AND deleted = 0
    </update>

</mapper>
