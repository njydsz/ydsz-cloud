<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.njydsz.pmis.agent.mapper.AgentPredictionMapper">

    <resultMap id="BaseResultMap" type="com.njydsz.pmis.agent.entity.AgentPredictionDO">
        <id column="id" property="id"/>
        <result column="task_code" property="taskCode"/>
        <result column="agent_type" property="agentType"/>
        <result column="biz_type" property="bizType"/>
        <result column="biz_id" property="bizId"/>
        <result column="biz_ref" property="bizRef"/>
        <result column="input_snapshot" property="inputSnapshot"/>
        <result column="output_result" property="outputResult"/>
        <result column="alert_level" property="alertLevel"/>
        <result column="score" property="score"/>
        <result column="confidence" property="confidence"/>
        <result column="suggestion" property="suggestion"/>
        <result column="matched_rules" property="matchedRules"/>
        <result column="cost_ms" property="costMs"/>
        <result column="model_version" property="modelVersion"/>
        <result column="status" property="status"/>
        <result column="error_msg" property="errorMsg"/>
        <result column="caller_id" property="callerId"/>
        <result column="caller_name" property="callerName"/>
        <result column="source" property="source"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="provider_trace_id" property="providerTraceId"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <select id="selectByTaskCode" resultMap="BaseResultMap">
        SELECT * FROM pmis_agent_prediction
        WHERE task_code = #{code} AND deleted = 0 LIMIT 1
    </select>

    <update id="updateStatus">
        UPDATE pmis_agent_prediction
        SET status = #{status}, updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id} AND deleted = 0
    </update>

    <select id="selectByBiz" resultMap="BaseResultMap">
        SELECT * FROM pmis_agent_prediction
        <where>
            deleted = 0
            <if test="bizType != null and bizType != ''">
                AND biz_type = #{bizType}
            </if>
            <if test="bizId != null">
                AND biz_id = #{bizId}
            </if>
            <if test="agentType != null and agentType != ''">
                AND agent_type = #{agentType}
            </if>
        </where>
        ORDER BY created_at DESC
    </select>

    <select id="selectByAgentType" resultMap="BaseResultMap">
        SELECT * FROM pmis_agent_prediction
        <where>
            deleted = 0 AND status = 'SUCCESS'
            <if test="agentType != null and agentType != ''">
                AND agent_type = #{agentType}
            </if>
            <if test="alertLevel != null and alertLevel != ''">
                AND alert_level = #{alertLevel}
            </if>
        </where>
        ORDER BY created_at DESC
        <if test="limit != null and limit > 0">
            LIMIT #{limit}
        </if>
    </select>

    <select id="aggregateByType" resultType="java.util.Map">
        SELECT agent_type, alert_level, COUNT(1) AS cnt
        FROM pmis_agent_prediction
        WHERE tenant_id = #{tenantId} AND deleted = 0
        GROUP BY agent_type, alert_level
    </select>

    <select id="countByAlertLevel" resultType="java.lang.Long">
        SELECT COUNT(1) FROM pmis_agent_prediction
        <where>
            deleted = 0
            <if test="alertLevel != null and alertLevel != ''">
                AND alert_level = #{alertLevel}
            </if>
            <if test="agentType != null and agentType != ''">
                AND agent_type = #{agentType}
            </if>
            <if test="tenantId != null">
                AND tenant_id = #{tenantId}
            </if>
        </where>
    </select>

</mapper>
