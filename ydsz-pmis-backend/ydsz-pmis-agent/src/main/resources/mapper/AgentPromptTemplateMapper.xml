<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.njydsz.pmis.agent.mapper.AgentPromptTemplateMapper">

    <resultMap id="BaseResultMap" type="com.njydsz.pmis.agent.entity.AgentPromptTemplateDO">
        <id column="id" property="id"/>
        <result column="template_code" property="templateCode"/>
        <result column="template_name" property="templateName"/>
        <result column="agent_type" property="agentType"/>
        <result column="prompt_role" property="promptRole"/>
        <result column="content" property="content"/>
        <result column="version" property="version"/>
        <result column="is_active" property="isActive"/>
        <result column="description" property="description"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="created_by" property="createdBy"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_by" property="updatedBy"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, template_code, template_name, agent_type, prompt_role, content, version,
        is_active, description, tenant_id, created_by, created_at, updated_by, updated_at, deleted
    </sql>

    <select id="selectActiveByCode" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM pmis_agent_prompt_template
        WHERE template_code = #{templateCode}
          AND is_active = true
          AND deleted = 0
        LIMIT 1
    </select>

    <update id="deactivateOthers">
        UPDATE pmis_agent_prompt_template
        SET is_active = false, updated_at = CURRENT_TIMESTAMP
        WHERE template_code = #{templateCode}
          AND id != #{excludeId}
          AND is_active = true
          AND deleted = 0
    </update>

</mapper>
