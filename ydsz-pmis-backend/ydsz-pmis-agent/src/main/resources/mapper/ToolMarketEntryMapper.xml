<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.njydsz.pmis.agent.infra.mapper.ToolMarketEntryMapper">

    <resultMap id="BaseResultMap" type="com.njydsz.pmis.agent.domain.entity.ToolMarketEntryDO">
        <id column="id" property="id"/>
        <result column="tool_name" property="toolName"/>
        <result column="display_name" property="displayName"/>
        <result column="description" property="description"/>
        <result column="category" property="category"/>
        <result column="source_type" property="sourceType"/>
        <result column="http_method" property="httpMethod"/>
        <result column="endpoint_url" property="endpointUrl"/>
        <result column="headers" property="headers"/>
        <result column="param_schema" property="paramSchema"/>
        <result column="body_template" property="bodyTemplate"/>
        <result column="path_params" property="pathParams"/>
        <result column="query_params" property="queryParams"/>
        <result column="timeout_ms" property="timeoutMs"/>
        <result column="requires_approval" property="requiresApproval"/>
        <result column="enabled" property="enabled"/>
        <result column="version" property="version"/>
        <result column="open_api_spec_url" property="openApiSpecUrl"/>
        <result column="open_api_operation_id" property="openApiOperationId"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="created_by" property="createdBy"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_by" property="updatedBy"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, tool_name, display_name, description, category, source_type, http_method,
        endpoint_url, headers, param_schema, body_template, path_params, query_params,
        timeout_ms, requires_approval, enabled, version, open_api_spec_url,
        open_api_operation_id, tenant_id, created_by, created_at, updated_by, updated_at, deleted
    </sql>

    <select id="selectByToolName" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM pmis_tool_market_entry
        WHERE tool_name = #{toolName}
          AND deleted = 0
        LIMIT 1
    </select>

    <select id="selectAllEnabled" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM pmis_tool_market_entry
        WHERE enabled = true
          AND deleted = 0
        ORDER BY created_at ASC
    </select>

</mapper>
