# ====================================================================
# PMIS 本地开发环境变量（Windows / PowerShell 兼容）
#  ---------------------------------------------------------------------
#  用法（PowerShell）：
#    Get-Content .\dev.env | ForEach-Object { if ($_ -match '^\s*([^#][^=]*)=(.*)$') { [System.Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim(), 'Process') } }
#  或者 IDE 启动时直接把以下变量加到 Run/Debug Configuration 的 Environment variables
#
#  本文件仅用于本地开发；CI/生产请使用 deploy/docker/.env.example
#  修改本文件后请在 IDE 重启服务，或重新执行上述加载命令
# ====================================================================

# ---------- 本地 Nacos（3.2.2 独立模式） ----------
# 安装路径 D:\Tool\Nacos\nacos-server-3.2.2
# 启动方式：cmd /c "cd /d D:\Tool\Nacos\nacos-server-3.2.2\bin && startup.cmd -m standalone"
# Nacos 控制台：http://localhost:8848/nacos   （默认账号 nacos/nacos，可在 Nacos 端修改）
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=
# Nacos 3.x 默认开启鉴权；若本地关闭了鉴权则留空，否则填 Nacos 控制台账号
NACOS_USERNAME=
NACOS_PASSWORD=

# ---------- 后端业务库（PostgreSQL 14+/17/18） ----------
# 连接串：jdbc:postgresql://127.0.0.1:5432/ydsz-pmis
# 初始化脚本：deploy/sql/V1.0.0_001~V1.0.0_022.sql 顺序执行
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ydsz-pmis
DB_USER=postgres
DB_PASSWORD=Limw1020

# ---------- Nacos 自带元数据库（与业务库分开） ----------
NACOS_DB_HOST=127.0.0.1
NACOS_DB_PORT=5432
NACOS_DB_NAME=nacos-322
NACOS_DB_USER=postgres
NACOS_DB_PASSWORD=Limw1020
# Nacos 3.2.2 端 conf/application.properties 需将 spring.datasource.platform=postgresql
# 并执行 conf/postgresql-schema.sql 建表（nacos-322 数据库下）

# ---------- Redis（无密码） ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- 业务侧 JWT / 加密（开发默认值，生产必须替换） ----------
JWT_SECRET=pmis-default-jwt-secret-key-please-change-in-production-environment-must-be-256-bits
PMIS_AES_KEY=ReplaceMeWithA32ByteKey_pmIs2026_secret
PMIS_AES_IV=ReplaceMeInitVector_pm

# ---------- MinIO（本地可选；若不启用文件服务可不填） ----------
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=pmis

# ---------- XXL-Job 调度中心（可选，scheduler 模块使用） ----------
XXL_JOB_ADMIN_ADDRESSES=http://127.0.0.1:8080/xxl-job-admin
XXL_JOB_ACCESS_TOKEN=pmis-xxl-token
XXL_JOB_EXECUTOR_APP_NAME=ydsz-pmis-scheduler
XXL_JOB_EXECUTOR_IP=
XXL_JOB_EXECUTOR_PORT=9999
