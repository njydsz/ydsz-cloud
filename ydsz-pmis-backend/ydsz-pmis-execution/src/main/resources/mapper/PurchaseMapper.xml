<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.njydsz.pmis.execution.mapper.PurchaseMapper">

    <resultMap id="BaseResultMap" type="com.njydsz.pmis.execution.entity.PurchaseDO">
        <id column="id" property="id"/>
        <result column="purchase_code" property="purchaseCode"/>
        <result column="initiation_id" property="initiationId"/>
        <result column="vendor" property="vendor"/>
        <result column="item_name" property="itemName"/>
        <result column="quantity" property="quantity"/>
        <result column="unit_price" property="unitPrice"/>
        <result column="amount" property="amount"/>
        <result column="purchase_date" property="purchaseDate"/>
        <result column="status" property="status"/>
        <result column="applicant_id" property="applicantId"/>
        <result column="applicant_name" property="applicantName"/>
        <result column="approver_id" property="approverId"/>
        <result column="approver_name" property="approverName"/>
        <result column="approved_at" property="approvedAt"/>
        <result column="description" property="description"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="provider_trace_id" property="providerTraceId"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <select id="selectByCode" resultMap="BaseResultMap">
        SELECT * FROM pmis_cost_purchase
        WHERE purchase_code = #{code} AND deleted = 0 LIMIT 1
    </select>

    <update id="updateStatus">
        UPDATE pmis_cost_purchase
        SET status = #{status},
            approver_id = COALESCE(#{approverId}, approver_id),
            approver_name = COALESCE(#{approverName}, approver_name),
            approved_at = CASE WHEN #{status} = 'APPROVED' THEN CURRENT_TIMESTAMP ELSE approved_at END,
            updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id} AND deleted = 0
    </update>
</mapper>
