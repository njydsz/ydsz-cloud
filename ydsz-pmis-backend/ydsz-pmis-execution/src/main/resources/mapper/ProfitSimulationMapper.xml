<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.njydsz.pmis.execution.mapper.ProfitSimulationMapper">

    <resultMap id="BaseResultMap" type="com.njydsz.pmis.execution.entity.ProfitSimulationDO">
        <id column="id" property="id"/>
        <result column="simulation_code" property="simulationCode"/>
        <result column="simulation_name" property="simulationName"/>
        <result column="initiation_id" property="initiationId"/>
        <result column="version" property="version"/>
        <result column="scenario_type" property="scenarioType"/>
        <result column="contract_amount" property="contractAmount"/>
        <result column="external_revenue" property="externalRevenue"/>
        <result column="internal_cost" property="internalCost"/>
        <result column="expected_hours" property="expectedHours"/>
        <result column="blended_rate" property="blendedRate"/>
        <result column="gross_profit" property="grossProfit"/>
        <result column="gross_margin" property="grossMargin"/>
        <result column="target_margin" property="targetMargin"/>
        <result column="labor_cost" property="laborCost"/>
        <result column="purchase_cost" property="purchaseCost"/>
        <result column="expense_cost" property="expenseCost"/>
        <result column="outsource_cost" property="outsourceCost"/>
        <result column="assumptions" property="assumptions"/>
        <result column="status" property="status"/>
        <result column="approver_name" property="approverName"/>
        <result column="approved_at" property="approvedAt"/>
        <result column="remark" property="remark"/>
        <result column="applicant_id" property="applicantId"/>
        <result column="applicant_name" property="applicantName"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="provider_trace_id" property="providerTraceId"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <select id="selectByCode" resultMap="BaseResultMap">
        SELECT * FROM pmis_profit_simulation
        WHERE simulation_code = #{code} AND deleted = 0 LIMIT 1
    </select>

    <select id="selectByInitiation" resultMap="BaseResultMap">
        SELECT * FROM pmis_profit_simulation
        WHERE initiation_id = #{initiationId} AND deleted = 0
        ORDER BY version DESC
    </select>

    <select id="maxVersion" resultType="java.lang.Integer">
        SELECT COALESCE(MAX(version), 0) FROM pmis_profit_simulation
        WHERE initiation_id = #{initiationId} AND deleted = 0
    </select>
</mapper>
