<?xml version="1.0" encoding="UTF-8"?>
<!--
    SpotBugs 全局排除规则（项目级）
    用法：mvn spotbugs:check / 构建 verify 阶段自动执行
    注意：此文件必须位于聚合根目录（remi-cloud/），
    所有子模块通过 ${maven.multiModuleProjectDirectory}/spotbugs-exclude.xml 引用。
-->
<FindBugsFilter
        xmlns="https://github.com/spotbugs/filter/3.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/master/spotbugs/etc/findbugsfilter.xsd">

    <!-- ==================== 忽略规则说明 ====================
         1. 测试代码：不参与生产缺陷判定
         2. 生成代码：Lombok / MapStruct / 字节码生成产物
         3. 已知无害模式：日志输出、序列化、TOCTOU 等
    ======================================================== -->

    <!-- 测试代码全部排除 -->
    <Match>
        <Source name="~.*/src/test/.*"/>
    </Match>

    <!-- Lombok 生成代码（getter/setter/builder/构造器） -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP, EI_EXPOSE_REP2, NP_NONNULL_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR"/>
        <Or>
            <Source name="~.*\$\$.*\.class"/>
        </Or>
    </Match>

    <!-- 领域枚举 / 常量类：不参与缺陷判定 -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP, EI_EXPOSE_REP2"/>
        <Or>
            <Class name="~.*\.enums\..*"/>
            <Class name="~.*\.constant\..*"/>
        </Or>
    </Match>

    <!-- 日志输出：无安全问题 -->
    <Match>
        <Bug pattern="SLF4J_FORMAT_SHOULD_BE_CONST"/>
    </Match>

    <!-- 序列化 / 反序列化相关已知模式 -->
    <Match>
        <Bug pattern="SE_BAD_FIELD, SE_BAD_FIELD_STORE, SE_TRANSIENT_FIELD_NOT_RESTORED"/>
    </Match>

    <!-- equals/hashCode 误报（Lombok @EqualsAndHashCode 生成） -->
    <Match>
        <Bug pattern="EQ_DOESNT_OVERRIDE_EQUALS, HE_EQUALS_USE_HASHCODE"/>
        <Source name="~.*\.class"/>
    </Match>

    <!-- ==================== 通用无害模式（全模块排除） ====================
         以下均为误报率极高的低价值告警，或项目既定设计：
         - RCN/URF/UPM：冗余空检查、未读字段/方法（反射、序列化、框架场景常见误报）
         - REC/DE：catch Exception 兜底 / 忽略异常（底层组件统一兜底策略）
         - PA_*/FE_*/RC_*/NP_BOOLEAN：公共字段、浮点 ==（d==d 判 NaN 为标准写法）、
           包装类型返回 null 等，均为设计使然或误报
         - DP_DO_INSIDE_DO_PRIVILEGED：反射 setAccessible（JDK17+ 无 SecurityManager，无实际风险）
         - INT_BAD_COMPARISON / BC_UNCONFIRMED_CAST：ASM 字节码生成器内部实现
         - RV_RETURN_VALUE_OF_PUTIFABSENT_IGNORED：ConcurrentHashMap 缓存预热标准写法
    ======================================================== -->
    <Match>
        <Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE,
            URF_UNREAD_PUBLIC_OR_PROTECTED_FIELD,
            REC_CATCH_EXCEPTION,
            UPM_UNCALLED_PRIVATE_METHOD,
            PA_PUBLIC_PRIMITIVE_ATTRIBUTE,
            PA_PUBLIC_MUTABLE_OBJECT_ATTRIBUTE,
            FE_FLOATING_POINT_EQUALITY,
            DE_MIGHT_IGNORE,
            DP_DO_INSIDE_DO_PRIVILEGED,
            CT_CONSTRUCTOR_THROW,
            SING_SINGLETON_HAS_NONPRIVATE_CONSTRUCTOR,
            BC_UNCONFIRMED_CAST_OF_RETURN_VALUE,
            RC_REF_COMPARISON_BAD_PRACTICE_BOOLEAN,
            RV_RETURN_VALUE_OF_PUTIFABSENT_IGNORED,
            NP_BOOLEAN_RETURN_NULL,
            INT_BAD_COMPARISON_WITH_NONNEGATIVE_VALUE,
            PZLA_PREFER_ZERO_LENGTH_ARRAYS,
            DCN_NULLPOINTER_EXCEPTION,
            SF_SWITCH_NO_DEFAULT,
            UC_USELESS_OBJECT,
            VO_VOLATILE_REFERENCE_TO_ARRAY"/>
    </Match>

    <!-- 底层 JSON 引擎（remi-common-json，fastjson2 风格高性能实现）：
         内部类间共享可变对象/静态单例/无 locale 大小写转换均为设计使然，
         限定包名排除，不影响其他模块对同类问题的检查灵敏度 -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP, EI_EXPOSE_REP2, MS_EXPOSE_REP, DM_CONVERT_CASE"/>
        <Class name="~com\.remisoft\.common\.json\..*"/>
    </Match>

</FindBugsFilter>
