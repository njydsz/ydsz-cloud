<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Exclude generated code -->
    <Match>
        <Class name="~.*\..*Test"/>
    </Match>
    <!-- Exclude Lombok generated methods -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <!-- Exclude MyBatis-Plus generated -->
    <Match>
        <Class name="~.*mapper\..*"/>
    </Match>
    <!-- Exclude config classes -->
    <Match>
        <Class name="~.*config\..*"/>
    </Match>
</FindBugsFilter>
