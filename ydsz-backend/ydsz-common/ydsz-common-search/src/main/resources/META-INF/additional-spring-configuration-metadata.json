    {
      "name": "ydsz.search.rank.content-weight",
      "type": "java.lang.Double",
      "description": "内容字段排序权重（默认 0.4）"
    },
    {
      "name": "ydsz.search.rank.tags-weight",
      "type": "java.lang.Double",
      "description": "标签字段排序权重（默认 0.2）"
