    },
    {
      "name": "ydsz.search.search-timeout",
      "type": "java.lang.Integer",
      "description": "搜索超时时间（秒）"
    },
    {
      "name": "ydsz.search.suggest-limit",
      "type": "java.lang.Integer",
      "description": "搜索建议返回数量"
    },
    {
