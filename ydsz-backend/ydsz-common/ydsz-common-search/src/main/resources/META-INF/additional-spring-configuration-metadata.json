      "type": "java.lang.Boolean",
      "description": "是否启用同义词搜索"
    },
    {
      "name": "ydsz.search.synonym.file",
      "type": "java.lang.String",
      "description": "同义词词典文件路径"
    },
    {
      "name": "ydsz.search.pinyin.enabled",
      "type": "java.lang.Boolean",
      "description": "是否启用拼音搜索"
    },
    {
      "name": "ydsz.search.pinyin.file",
      "type": "java.lang.String",
      "description": "拼音词典文件路径（格式：汉字=拼音）"
