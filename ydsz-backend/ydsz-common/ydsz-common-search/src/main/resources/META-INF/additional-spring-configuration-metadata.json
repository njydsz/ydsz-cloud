{
  "properties": [
    {
      "name": "ydsz.search.enabled",
      "type": "java.lang.Boolean",
      "description": "是否启用搜索服务"
    },
    {
      "name": "ydsz.search.engine-type",
      "type": "java.lang.String",
      "description": "搜索引擎类型：pg、memory"
    },
    {
      "name": "ydsz.search.page-size",
      "type": "java.lang.Integer",
      "description": "默认每页大小"
    },
    {
      "name": "ydsz.search.max-page-size",
      "type": "java.lang.Integer",
      "description": "每页最大大小（深分页保护）"
    },
    {
      "name": "ydsz.search.max-page-depth",
      "type": "java.lang.Integer",
