        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-userinfo-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-project-api</artifactId>
            <version>${project.version}</version>
        </dependency>
