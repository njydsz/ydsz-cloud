{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "概览 — Cache Stats",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "green", "value": 0.85 }
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "avg(cache_hit_rate{cache_name=~\"$cache_name\"})",
          "legendFormat": "平均命中率"
        }
      ],
      "title": "平均命中率",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "ops" }
      },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "targets": [
        {
          "expr": "sum by (cache_name) (rate(cache_gets_total{cache_name=~\"$cache_name\"}[5m]))",
          "legendFormat": "{{cache_name}}"
        }
      ],
      "title": "GET QPS (5m)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "ops" }
      },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "targets": [
        {
          "expr": "sum by (cache_name) (rate(cache_misses_total{cache_name=~\"$cache_name\"}[5m]))",
          "legendFormat": "{{cache_name}}"
        }
      ],
      "title": "MISS QPS (5m)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }
      },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "targets": [
        {
          "expr": "sum by (cache_name) (cache_size{cache_name=~\"$cache_name\"})",
          "legendFormat": "{{cache_name}}"
        }
      ],
      "title": "当前缓存条目数",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "id": 101,
      "title": "延迟分布 — Cache GET/PUT",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 10 }, "unit": "ns" }
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 8 },
      "id": 5,
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (cache_name, le) (rate(cache_get_duration_bucket{cache_name=~\"$cache_name\"}[5m])))",
          "legendFormat": "P99 {{cache_name}}"
        },
        {
          "expr": "histogram_quantile(0.5, sum by (cache_name, le) (rate(cache_get_duration_bucket{cache_name=~\"$cache_name\"}[5m])))",
          "legendFormat": "P50 {{cache_name}}"
        }
      ],
      "title": "GET 延迟 (P50/P99)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 10 }, "unit": "ns" }
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 8 },
      "id": 6,
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (cache_name, le) (rate(cache_put_duration_bucket{cache_name=~\"$cache_name\"}[5m])))",
          "legendFormat": "P99 {{cache_name}}"
        },
        {
          "expr": "histogram_quantile(0.5, sum by (cache_name, le) (rate(cache_put_duration_bucket{cache_name=~\"$cache_name\"}[5m])))",
          "legendFormat": "P50 {{cache_name}}"
        }
      ],
      "title": "PUT 延迟 (P50/P99)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "id": 102,
      "title": "淘汰 & 加载 — Eviction/Load",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "ops" }
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 16 },
      "id": 7,
      "targets": [
        {
          "expr": "sum by (cache_name) (rate(cache_evictions_total{cache_name=~\"$cache_name\"}[5m]))",
          "legendFormat": "{{cache_name}}"
        }
      ],
      "title": "淘汰速率 (5m)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "ns" }
      },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 16 },
      "id": 8,
      "targets": [
        {
          "expr": "sum by (cache_name) (rate(cache_load_duration_sum{cache_name=~\"$cache_name\"}[5m])) / sum by (cache_name) (rate(cache_load_duration_count{cache_name=~\"$cache_name\"}[5m]))",
          "legendFormat": "{{cache_name}}"
        }
      ],
      "title": "加载平均耗时 (5m)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }
      },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 16 },
      "id": 9,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "cache_hotkey_tracker_local_key_count{cache_name=~\"$cache_name\"}",
          "legendFormat": "{{cache_name}}"
        }
      ],
      "title": "HotKeyTracker 本地条目数",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 103,
      "title": "热点 Key — Top-K",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "align": "auto", "cellOptions": { "type": "color-text" } },
          "unit": "short"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "频率" }, "properties": [{ "id": "custom.width", "value": 120 }] },
          { "matcher": { "id": "byName", "options": "排名" }, "properties": [{ "id": "custom.width", "value": 80 }] }
        ]
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 23 },
      "id": 10,
      "options": {
        "footer": { "reducers": [] },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "频率" }]
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "expr": "cache_hotkey_frequency{cache_name=~\"$cache_name\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "{{rank}}"
        }
      ],
      "title": "热点 Key Top-K (即时快照)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "cache_name": true },
            "renameByName": { "key": "Key", "rank": "排名", "Value": "频率" }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 31 },
      "id": 11,
      "targets": [
        {
          "expr": "cache_hotkey_frequency{cache_name=~\"$cache_name\"}",
          "legendFormat": "#{{rank}} {{key}}"
        }
      ],
      "title": "热点 Key 频率趋势",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["ydsz", "cache"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(cache_hit_rate, cache_name)",
        "includeAll": true,
        "label": "cache_name",
        "multi": true,
        "name": "cache_name",
        "options": [],
        "query": { "query": "label_values(cache_hit_rate, cache_name)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "YDSZ Cache Stats — 命中率 / 热点 Key",
  "uid": "ydsz-cache-stats",
  "version": 1,
  "weekStart": ""
}
