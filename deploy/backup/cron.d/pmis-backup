# ============================================================================
#  PMIS PostgreSQL 备份 crontab 配置
#  --------------------------------------------------------------------------
#  安装方式：
#    sudo cp deploy/backup/cron.d/pmis-backup /etc/cron.d/pmis-backup
#    sudo chmod 644 /etc/cron.d/pmis-backup
#    sudo systemctl restart cron
#  配套修改：
#    1. postgresql.conf 中配置 archive_mode=on
#       archive_command = '/data/backup/pg_incremental.sh %f %p'
#    2. 环境变量 PMIS_PGPASSWORD 通过 /etc/pmis/backup.env (chmod 600) 提供
# ============================================================================

# 环境变量（生产环境建议放在 /etc/pmis/backup.env 并 source）
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
PMIS_PGPASSWORD_FILE=/etc/pmis/backup.env
PMIS_BACKUP_DIR=/data/backup/pmis
PMIS_BACKUP_LOG_DIR=/var/log/pmis/backup
PMIS_ALERT_MAIL=ops@ydsz-pmis.cn
PMIS_BACKUP_OSS_BUCKET=pmis-prod-backup

# m  h  dom mon dow user command
# 每日 02:00 全量备份
0 2 * * *   postgres  test -f ${PMIS_PGPASSWORD_FILE} && . ${PMIS_PGPASSWORD_FILE} && /data/backup/pg_backup.sh >> /var/log/pmis/backup/pg_backup_cron.log 2>&1

# 每月 1 号 04:00 触发恢复演练（pg_backup.sh + 临时实例）
0 4 1 * *   postgres  test -f ${PMIS_PGPASSWORD_FILE} && . ${PMIS_PGPASSWORD_FILE} && /data/backup/restore-test.sh >> /var/log/pmis/backup/restore_test.log 2>&1

# 每日 09:00 检查昨日备份是否成功（.last_backup.json 状态校验）
0 9 * * *   postgres  test -f ${PMIS_PGPASSWORD_FILE} && /data/backup/verify_last_backup.sh >> /var/log/pmis/backup/verify.log 2>&1
