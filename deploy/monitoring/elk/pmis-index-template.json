# =============================================================================
# Elasticsearch 索引模板 - PMIS 日志
# -----------------------------------------------------------------------------
# 部署:
#   通过 Logstash manage_template 自动加载
#   或手动: curl -X PUT "http://elasticsearch:9200/_index_template/pmis-logs" -H 'Content-Type: application/json' -d @pmis-index-template.json
# =============================================================================
{
  "index_patterns": ["pmis-logs-*"],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "index.refresh_interval": "5s",
      "index.lifecycle.name": "pmis-logs-policy"
    },
    "mappings": {
      "properties": {
        "@timestamp": { "type": "date" },
        "level": { "type": "keyword" },
        "logger_name": { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 256 } } },
        "thread_name": { "type": "keyword" },
        "message": { "type": "text", "analyzer": "ik_max_word", "search_analyzer": "ik_smart" },
        "app_name": { "type": "keyword" },
        "hostname": { "type": "keyword" },
        "profile": { "type": "keyword" },
        "traceId": { "type": "keyword" },
        "userId": { "type": "keyword" },
        "username": { "type": "keyword" },
        "stack_trace": { "type": "text", "analyzer": "ik_max_word" },
        "source": { "type": "keyword" },
        "pipeline": { "type": "keyword" }
      }
    }
  },
  "priority": 200
}
