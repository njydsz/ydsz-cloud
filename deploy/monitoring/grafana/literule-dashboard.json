{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "LiteRule 规则引擎监控面板（P1-6）",
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "datasource": "Prometheus",
      "title": "规则评估 QPS",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(literule_rule_evaluations_total[5m])) by (scenario)",
          "legendFormat": "{{scenario}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "title": "规则触发 QPS（按严重度）",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(literule_rule_triggered_total[5m])) by (severity)",
          "legendFormat": "{{severity}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "title": "评估耗时 P99（按规则）",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(literule_rule_eval_duration_seconds_bucket[5m])) by (le, rule_code))",
          "legendFormat": "{{rule_code}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "title": "规则错误率",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(literule_rule_errors_total[5m])) by (rule_code)",
          "legendFormat": "{{rule_code}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "title": "已注册规则数 / 单次评估规则数",
      "type": "stat",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "literule_registered_rules", "legendFormat": "已注册", "refId": "A" },
        { "expr": "literule_evaluated_rules", "legendFormat": "单次评估", "refId": "B" }
      ]
    },
    {
      "datasource": "Prometheus",
      "title": "Trace 队列积压",
      "type": "stat",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "literule_trace_queue_size", "legendFormat": "积压", "refId": "A" }
      ]
    },
    {
      "datasource": "Prometheus",
      "title": "熔断中的规则（state=OPEN）",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "targets": [
        {
          "expr": "literule_breaker_state{state=\"OPEN\"}",
          "legendFormat": "{{rule_code}}",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 27,
  "style": "dark",
  "tags": ["literule", "rule-engine"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "LiteRule 规则引擎监控",
  "uid": "literule-dashboard",
  "version": 1
}
