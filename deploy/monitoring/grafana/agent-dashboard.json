{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "AI Agent 模块监控面板（P1-6）— LLM 调用、Token 消耗、护栏拦截、健康状态",
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "datasource": "Prometheus",
      "title": "LLM 调用 QPS（按 Provider）",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(agent_llm_calls_total{job=\"pmis-agent\"}[5m])) by (provider)",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "title": "LLM 调用成功率",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.85 },
              { "color": "green", "value": 0.95 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "1 - sum(rate(agent_llm_calls_total{job=\"pmis-agent\",status=\"failure\"}[5m])) / clamp_min(sum(rate(agent_llm_calls_total{job=\"pmis-agent\"}[5m])), 1)",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "title": "护栏拦截次数（5min）",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "sum(increase(agent_guardrail_rejections_total{job=\"pmis-agent\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "title": "LLM 调用耗时 P99/P95/P50（秒）",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(agent_llm_call_duration_seconds_bucket{job=\"pmis-agent\"}[5m])) by (le))",
          "legendFormat": "P99",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(agent_llm_call_duration_seconds_bucket{job=\"pmis-agent\"}[5m])) by (le))",
          "legendFormat": "P95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(agent_llm_call_duration_seconds_bucket{job=\"pmis-agent\"}[5m])) by (le))",
          "legendFormat": "P50",
          "refId": "C"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "title": "Token 消耗速率（按类型）",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(agent_llm_tokens_total{job=\"pmis-agent\"}[5m])) by (type)",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "title": "Token 消耗（按模型）",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(agent_llm_tokens_total{job=\"pmis-agent\"}[5m])) by (model)",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "title": "LLM 错误分布（按 error_type）",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(agent_llm_calls_total{job=\"pmis-agent\",status=\"failure\"}[5m])) by (error_type)",
          "legendFormat": "{{error_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "title": "护栏拦截趋势（按护栏名称和方向）",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(agent_guardrail_rejections_total{job=\"pmis-agent\"}[5m])) by (guard, direction)",
          "legendFormat": "{{guard}} / {{direction}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "title": "Agent 服务健康状态",
      "type": "stat",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } }, "type": "value" }
          ]
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "up{job=\"pmis-agent\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 27,
  "style": "dark",
  "tags": ["agent", "ai", "llm"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "PMIS AI Agent 监控",
  "uid": "agent-dashboard",
  "version": 1
}
