{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "PMIS 总览仪表盘 - 服务可用性 / QPS / 延迟 / 错误率 / JVM / DB / Redis",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "服务可用性(各服务 up 状态)",
      "description": "Prometheus 抓取目标存活状态,1=存活 0=下线",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}, "type": "value"}
          ],
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "red", "value": null},
            {"color": "green", "value": 1}
          ]},
          "color": {"mode": "thresholds"},
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "gridPos": {"h": 5, "w": 24, "x": 0, "y": 0},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "up{job=~\"pmis-.*\"}",
          "legendFormat": "{{job}} - {{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "请求 QPS(按服务分组)",
      "description": "每秒请求数 = rate(http_server_requests_seconds_count[1m])",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {"drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 10, "stacking": {"mode": "none"}}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(rate(http_server_requests_seconds_count{job=~\"pmis-.*\"}[1m])) by (job)",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "5xx 错误率",
      "description": "5xx 请求数 / 总请求数",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 0.01},
            {"color": "red", "value": 0.05}
          ]},
          "custom": {"drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 20}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["last", "max"]}, "tooltip": {"mode": "multi"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(rate(http_server_requests_seconds_count{job=~\"pmis-.*\",status=~\"5..\"}[2m])) by (job) / sum(rate(http_server_requests_seconds_count{job=~\"pmis-.*\"}[2m])) by (job)",
          "legendFormat": "{{job}} 5xx%",
          "refId": "A"
        }
      ]
    },
    {
      "title": "P99 / P95 / P50 延迟",
      "description": "histogram_quantile 计算分位延迟(秒)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {"drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 5}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{job=~\"pmis-.*\"}[5m])) by (le, job))",
          "legendFormat": "P99 {{job}}",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=~\"pmis-.*\"}[5m])) by (le, job))",
          "legendFormat": "P95 {{job}}",
          "refId": "B"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{job=~\"pmis-.*\"}[5m])) by (le, job))",
          "legendFormat": "P50 {{job}}",
          "refId": "C"
        }
      ]
    },
    {
      "title": "JVM 堆内存使用(按服务)",
      "description": "jvm_memory_used_bytes{area=heap} / 1024 / 1024 (MB)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "MB",
          "custom": {"drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 10, "stacking": {"mode": "none"}}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["last", "max"]}, "tooltip": {"mode": "multi"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(jvm_memory_used_bytes{job=~\"pmis-.*\",area=\"heap\"}) by (job) / 1024 / 1024",
          "legendFormat": "used {{job}}",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(jvm_memory_max_bytes{job=~\"pmis-.*\",area=\"heap\"}) by (job) / 1024 / 1024",
          "legendFormat": "max {{job}}",
          "refId": "B"
        }
      ]
    },
    {
      "title": "GC 次数与耗时",
      "description": "increase(jvm_gc_pause_seconds_count[5m]) 次数 / sum(rate(jvm_gc_pause_seconds_sum[5m])) 耗时",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"drawStyle": "bars", "lineInterpolation": "linear", "fillOpacity": 50}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "GC 耗时(s)"},
            "properties": [{"id": "unit", "value": "s"}, {"id": "custom.drawStyle", "value": "line"}]
          }
        ]
      },
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["sum"]}, "tooltip": {"mode": "multi"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 21},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(increase(jvm_gc_pause_seconds_count{job=~\"pmis-.*\"}[5m])) by (job, action)",
          "legendFormat": "{{job}} {{action}} 次数",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(rate(jvm_gc_pause_seconds_sum{job=~\"pmis-.*\"}[5m])) by (job)",
          "legendFormat": "{{job}} GC 耗时(s)",
          "refId": "B"
        }
      ]
    },
    {
      "title": "数据库连接池活跃数(Druid/HikariCP)",
      "description": "活跃连接数 / 最大连接数,告警阈值见 pmis-alerts.yml PmisDbPoolExhausted",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 10}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["last", "max"]}, "tooltip": {"mode": "multi"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 21},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(hikaricp_connections_active{job=~\"pmis-.*\"}) by (job)",
          "legendFormat": "active {{job}}",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(hikaricp_connections_max{job=~\"pmis-.*\"}) by (job)",
          "legendFormat": "max {{job}}",
          "refId": "B"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(hikaricp_connections_pending{job=~\"pmis-.*\"}) by (job)",
          "legendFormat": "pending {{job}}",
          "refId": "C"
        }
      ]
    },
    {
      "title": "Redis 命令 QPS",
      "description": "rate(lettuce_command_completion_seconds_count[1m]) 按 status 分组",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {"drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 10}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi"}},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 29},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(rate(lettuce_command_completion_seconds_count{job=~\"pmis-.*\"}[1m])) by (job, status)",
          "legendFormat": "{{job}} {{status}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["pmis", "overview"],
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": "label_values(up{job=~\"pmis-.*\"}, job)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {"selected": true, "text": "All", "value": "$__all"}
      }
    ]
  },
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "PMIS 总览",
  "uid": "pmis-overview",
  "version": 1,
  "weekStart": ""
}
