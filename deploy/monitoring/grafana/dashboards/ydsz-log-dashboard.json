        "query": { "label": "appName", "refId": "LokiVariableQueryEditor-VariableQuery", "stream": "{namespace=\"ydsz\"}", "type": 1 },
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      },
