{
  "title": "PMIS Sentry 自监控",
  "uid": "pmis-sentry",
  "tags": ["pmis", "sentry", "monitoring"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Sentry 组件健康状态",
      "type": "stat",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "ydsz_sentry_metrics_available",
          "legendFormat": "Metrics: {{job}}",
          "refId": "A"
        },
        {
          "expr": "ydsz_sentry_logging_available",
          "legendFormat": "Logging: {{job}}",
          "refId": "B"
        },
        {
          "expr": "ydsz_sentry_alerting_available",
          "legendFormat": "Alerting: {{job}}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 1, "color": "green" }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "CPU 使用率",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "ydsz_system_cpu_usage{job=~\"pmis-.*\"} * 100",
          "legendFormat": "{{job}} 进程CPU",
          "refId": "A"
        },
        {
          "expr": "ydsz_system_cpu_system_usage{job=~\"pmis-.*\"} * 100",
          "legendFormat": "{{job}} 系统CPU",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 70, "color": "yellow" },
              { "value": 85, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "堆内存使用",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "ydsz_system_memory_heap_used{job=~\"pmis-.*\"}",
          "legendFormat": "{{job}} 已用",
          "refId": "A"
        },
        {
          "expr": "ydsz_system_memory_heap_max{job=~\"pmis-.*\"}",
          "legendFormat": "{{job}} 最大",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "id": 4,
      "title": "线程数",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "ydsz_system_process_thread_count{job=~\"pmis-.*\"}",
          "legendFormat": "{{job}} 线程",
          "refId": "A"
        },
        {
          "expr": "ydsz_system_process_daemon_thread_count{job=~\"pmis-.*\"}",
          "legendFormat": "{{job}} 守护线程",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "title": "GC 耗时",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(ydsz_system_process_gc_time_delta{job=~\"pmis-.*\"}[5m])",
          "legendFormat": "{{job}} GC增量",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "id": 6,
      "title": "磁盘可用空间",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "(ydsz_system_disk_free{job=~\"pmis-.*\"} / ydsz_system_disk_total{job=~\"pmis-.*\"}) * 100",
          "legendFormat": "{{job}} {{mount}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 10, "color": "yellow" },
              { "value": 20, "color": "green" }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "title": "SLA 违反次数",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "increase(ydsz_sla_violation_total{job=~\"pmis-.*\"}[5m])",
          "legendFormat": "{{job}} {{sla}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 8,
      "title": "慢追踪次数",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "increase(ydsz_trace_slow_total{job=~\"pmis-.*\"}[5m])",
          "legendFormat": "{{job}} {{operation}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 9,
      "title": "告警收敛统计",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "ydsz_sentry_alert_suppression_rate",
          "legendFormat": "抑制率",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 0.7, "color": "yellow" },
              { "value": 0.9, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "id": 10,
      "title": "进程运行时长",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "ydsz_system_process_uptime{job=~\"pmis-.*\"}",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 11,
      "title": "SLA 执行耗时 P99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(ydsz_sla_total_duration_seconds_bucket{job=~\"pmis-.*\"}[5m])) by (le, sla, job))",
          "legendFormat": "{{job}} {{sla}} P99",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 0.3, "color": "yellow" },
              { "value": 0.5, "color": "red" }
            ]
          }
        }
      }
    }
  ]
}
