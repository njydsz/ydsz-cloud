      "id": 1,
      "title": "工时提交速率",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(pmis_time_entry_create_total[5m])",
          "legendFormat": "create",
          "refId": "A"
        },
        {
          "expr": "rate(pmis_time_entry_approve_total[5m])",
          "legendFormat": "approve",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "AI 编排耗时 P99",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(pmis_orchestration_seconds_bucket[5m])) by (le, mode))",
          "legendFormat": "P99 {{mode}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" } },
