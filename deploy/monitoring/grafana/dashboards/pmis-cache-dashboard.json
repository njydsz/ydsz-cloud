{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "YDSZ PMIS Cache - 多策略缓存框架监控仪表盘",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "title": "缓存命中率",
      "type": "gauge",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "avg(cache_hit_rate{application=\"$application\"})",
          "legendFormat": "命中率",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 0.5 },
              { "color": "green", "value": 0.8 }
            ]
          },
          "unit": "percentunit"
        }
      }
    },
    {
      "title": "缓存大小",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "cache_size{application=\"$application\"}",
          "legendFormat": "{{cache_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "title": "缓存查询 QPS",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "rate(cache_gets_total{application=\"$application\"}[1m])",
          "legendFormat": "{{cache_name}} gets/s",
          "refId": "A"
        },
        {
          "expr": "rate(cache_misses_total{application=\"$application\"}[1m])",
          "legendFormat": "{{cache_name}} misses/s",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "title": "缓存淘汰次数",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "rate(cache_evictions_total{application=\"$application\"}[5m])",
          "legendFormat": "{{cache_name}} evictions/s",
          "refId": "A"
        }
      ]
    },
    {
      "title": "GET 操作延迟 (P50/P90/P99)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(cache_get_duration_seconds_bucket{application=\"$application\"}[5m])) by (le))",
          "legendFormat": "P50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(cache_get_duration_seconds_bucket{application=\"$application\"}[5m])) by (le))",
          "legendFormat": "P90",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(cache_get_duration_seconds_bucket{application=\"$application\"}[5m])) by (le))",
          "legendFormat": "P99",
          "refId": "C"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Write-Behind 死信队列",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(cache_dead_letter_count{application=\"$application\"})",
          "legendFormat": "死信总数",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "title": "缓存健康状态",
      "type": "table",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "cache_size{application=\"$application\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "cache_hit_rate{application=\"$application\"}",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "rate(cache_evictions_total{application=\"$application\"}[5m])",
          "format": "table",
          "instant": true,
          "refId": "C"
        }
      ]
    }
  ],
  "schemaVersion": 27,
  "style": "dark",
  "tags": ["pmis", "cache"],
  "templating": {
    "list": [
      {
        "name": "application",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(cache_size, application)",
        "refresh": 1,
        "sort": 1
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "title": "PMIS Cache Dashboard",
  "uid": "pmis-cache",
  "version": 1
}
