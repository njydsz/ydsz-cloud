{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "YDSZ JVM 监控仪表盘 - 堆/非堆内存、GC 次数/耗时、线程数、CPU 使用率",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "JVM 堆内存使用(used / max)",
      "description": "jvm_memory_used_bytes{area=heap} vs jvm_memory_max_bytes{area=heap}",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {"drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 20, "stacking": {"mode": "none"}}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "max"},
            "properties": [{"id": "custom.fillOpacity", "value": 0}, {"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [10, 10]}}]
          }
        ]
      },
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["last", "max"]}, "tooltip": {"mode": "multi"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(jvm_memory_used_bytes{job=~\"ydsz-.*\",area=\"heap\"}) by (job)",
          "legendFormat": "used {{job}}",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(jvm_memory_max_bytes{job=~\"ydsz-.*\",area=\"heap\"}) by (job)",
          "legendFormat": "max {{job}}",
          "refId": "B"
        }
      ]
    },
    {
      "title": "JVM 非堆内存使用",
      "description": "jvm_memory_used_bytes{area=nonheap} (MB)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "MB",
          "custom": {"drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 15}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["last", "max"]}, "tooltip": {"mode": "multi"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(jvm_memory_used_bytes{job=~\"ydsz-.*\",area=\"nonheap\"}) by (job) / 1024 / 1024",
          "legendFormat": "non-heap {{job}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "GC 次数(5min 增量)",
      "description": "increase(jvm_gc_pause_seconds_count[5m]) 按 action 分组",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"drawStyle": "bars", "lineInterpolation": "linear", "fillOpacity": 60}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["sum"]}, "tooltip": {"mode": "multi"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(increase(jvm_gc_pause_seconds_count{job=~\"ydsz-.*\"}[5m])) by (job, action)",
          "legendFormat": "{{job}} {{action}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "GC 耗时(5min 均值)",
      "description": "rate(jvm_gc_pause_seconds_sum[5m]) 单位秒",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {"drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 10}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(rate(jvm_gc_pause_seconds_sum{job=~\"ydsz-.*\"}[5m])) by (job)",
          "legendFormat": "{{job}} GC 耗时",
          "refId": "A"
        }
      ]
    },
    {
      "title": "JVM 线程数(按状态)",
      "description": "jvm_threads_states_threads 按 state 分组(runnable/blocked/waiting/timed-waiting)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 10, "stacking": {"mode": "normal"}}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["last", "max"]}, "tooltip": {"mode": "multi"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(jvm_threads_states_threads{job=~\"ydsz-.*\"}) by (job, state)",
          "legendFormat": "{{job}} {{state}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "CPU 使用率(进程 / 系统)",
      "description": "process_cpu_usage(进程) / system_cpu_usage(系统) 百分比",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 0.7},
            {"color": "red", "value": 0.9}
          ]},
          "custom": {"drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 15}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["last", "max"]}, "tooltip": {"mode": "multi"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(process_cpu_usage{job=~\"ydsz-.*\"}) by (job)",
          "legendFormat": "process {{job}}",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "avg(system_cpu_usage{job=~\"ydsz-.*\"}) by (job)",
          "legendFormat": "system {{job}}",
          "refId": "B"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["ydsz", "jvm"],
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": "label_values(up{job=~\"ydsz-.*\"}, job)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {"selected": true, "text": "All", "value": "$__all"}
      }
    ]
  },
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "YDSZ JVM 监控",
  "uid": "ydsz-jvm",
  "version": 1,
  "weekStart": ""
}
