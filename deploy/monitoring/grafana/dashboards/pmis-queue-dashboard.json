{
  "title": "PMIS 消息队列监控",
  "uid": "pmis-queue-dashboard",
  "tags": ["PMIS", "Queue", "MQ"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "title": "消息发送 QPS",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(ydsz_queue_publish_total[1m]))",
          "legendFormat": "publish QPS",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1000 },
              { "color": "red", "value": 5000 }
            ]
          }
        }
      }
    },
    {
      "title": "消息消费 QPS",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(ydsz_queue_consume_total[1m]))",
          "legendFormat": "consume QPS",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1000 },
              { "color": "red", "value": 5000 }
            ]
          }
        }
      }
    },
    {
      "title": "消息发送成功率",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(ydsz_queue_publish_total{result=\"success\"}[5m])) / sum(rate(ydsz_queue_publish_total[5m])) * 100",
          "legendFormat": "publish success rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          }
        }
      }
    },
    {
      "title": "消息消费成功率",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(ydsz_queue_consume_total{result=\"success\"}[5m])) / sum(rate(ydsz_queue_consume_total[5m])) * 100",
          "legendFormat": "consume success rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          }
        }
      }
    },
    {
      "title": "发送/消费 QPS 趋势",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum(rate(ydsz_queue_publish_total[1m])) by (channel)",
          "legendFormat": "publish: {{channel}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(ydsz_queue_consume_total[1m])) by (channel)",
          "legendFormat": "consume: {{channel}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "title": "消息处理延迟（P50/P90/P99）",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(ydsz_queue_consume_latency_seconds_bucket[5m])) by (le, channel))",
          "legendFormat": "P50: {{channel}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.9, sum(rate(ydsz_queue_consume_latency_seconds_bucket[5m])) by (le, channel))",
          "legendFormat": "P90: {{channel}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(ydsz_queue_consume_latency_seconds_bucket[5m])) by (le, channel))",
          "legendFormat": "P99: {{channel}}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "title": "消息发送延迟（P50/P90/P99）",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(ydsz_queue_publish_latency_seconds_bucket[5m])) by (le, channel))",
          "legendFormat": "P50: {{channel}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.9, sum(rate(ydsz_queue_publish_latency_seconds_bucket[5m])) by (le, channel))",
          "legendFormat": "P90: {{channel}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(ydsz_queue_publish_latency_seconds_bucket[5m])) by (le, channel))",
          "legendFormat": "P99: {{channel}}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "title": "死信队列消息数",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "ydsz_queue_dead_letter_count",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      }
    },
    {
      "title": "重试消息数",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 20 },
      "targets": [
        {
          "expr": "ydsz_queue_retry_count",
          "legendFormat": "{{channel}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 200 }
            ]
          }
        }
      }
    },
    {
      "title": "去重记录数",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 20 },
      "targets": [
        {
          "expr": "ydsz_queue_dedup_record_count",
          "legendFormat": "dedup records",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50000 },
              { "color": "red", "value": 100000 }
            ]
          }
        }
      }
    },
    {
      "title": "各通道消息积压",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "ydsz_queue_backlog",
          "legendFormat": "{{channel}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20,
            "stacking": { "mode": "normal" }
          }
        }
      }
    },
    {
      "title": "消费失败趋势",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "targets": [
        {
          "expr": "sum(rate(ydsz_queue_consume_total{result=\"failure\"}[5m])) by (channel)",
          "legendFormat": "failures: {{channel}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 50,
            "stacking": { "mode": "normal" }
          }
        }
      }
    }
  ]
}
