{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "YDSZ 工作流引擎仪表盘 - 流程实例 / 任务待办 / 审批耗时 / 异常 / DMN",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "流程实例趋势(创建 / 完成 / 终止)",
      "description": "rate(ydsz_workflow_instance_total) by operation 每分钟速率",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {"drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 15, "stacking": {"mode": "none"}}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi"}},
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 0},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(rate(ydsz_workflow_instance_total{operation=\"created\"}[5m])) by (process_key)",
          "legendFormat": "创建 {{process_key}}",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(rate(ydsz_workflow_instance_total{operation=\"completed\"}[5m])) by (process_key)",
          "legendFormat": "完成 {{process_key}}",
          "refId": "B"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(rate(ydsz_workflow_instance_total{operation=\"terminated\"}[5m])) by (process_key)",
          "legendFormat": "终止 {{process_key}}",
          "refId": "C"
        }
      ]
    },
    {
      "title": "任务待办数(按节点)",
      "description": "ydsz_workflow_task_pending_count by node_key 当前各节点积压待办数",
      "type": "bargauge",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 50},
            {"color": "red", "value": 100}
          ]},
          "color": {"mode": "thresholds"}
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showUnfilled": true
      },
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 9},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(ydsz_workflow_task_pending_count) by (node_key)",
          "legendFormat": "{{node_key}}",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "title": "审批耗时分布",
      "description": "histogram_quantile P50/P95/P99 of ydsz_workflow_approval_duration_seconds_bucket",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {"drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 5}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi"}},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 9},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.50, sum(rate(ydsz_workflow_approval_duration_seconds_bucket[5m])) by (le, process_key))",
          "legendFormat": "P50 {{process_key}}",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.95, sum(rate(ydsz_workflow_approval_duration_seconds_bucket[5m])) by (le, process_key))",
          "legendFormat": "P95 {{process_key}}",
          "refId": "B"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.99, sum(rate(ydsz_workflow_approval_duration_seconds_bucket[5m])) by (le, process_key))",
          "legendFormat": "P99 {{process_key}}",
          "refId": "C"
        }
      ]
    },
    {
      "title": "流程异常数",
      "description": "increase(ydsz_workflow_error_total[1h]) 近 1 小时流程异常(执行异常 / 超时 / 死信)累计",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"drawStyle": "bars", "lineInterpolation": "linear", "fillOpacity": 50, "stacking": {"mode": "normal"}}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["sum"]}, "tooltip": {"mode": "multi"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 18},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(increase(ydsz_workflow_error_total[1h])) by (error_type)",
          "legendFormat": "{{error_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "DMN 决策表执行次数",
      "description": "increase(ydsz_workflow_dmn_execution_total[1h]) 各决策表近 1 小时执行次数",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 10}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["sum", "max"]}, "tooltip": {"mode": "multi"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 18},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(increase(ydsz_workflow_dmn_execution_total[1h])) by (decision_key)",
          "legendFormat": "{{decision_key}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "1m",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["ydsz", "workflow"],
  "templating": {
    "list": [
      {
        "name": "process_key",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": "label_values(ydsz_workflow_instance_total, process_key)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {"selected": true, "text": "All", "value": "$__all"}
      }
    ]
  },
  "time": {"from": "now-24h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "YDSZ 工作流引擎",
  "uid": "ydsz-workflow",
  "version": 1,
  "weekStart": ""
}
