{
  "annotations": {
    "list": []
  },
  "description": "ydsz 工作流引擎监控看板 — 实例/任务/SLA/效率分析",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "实例创建 QPS",
      "type": "stat",
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(pmis_flow_instance_created_total[5m]))",
          "legendFormat": "创建 QPS"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops", "decimals": 2 }
      }
    },
    {
      "title": "实例完成 QPS",
      "type": "stat",
      "gridPos": { "h": 6, "w": 4, "x": 4, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(pmis_flow_instance_finished_total[5m]))",
          "legendFormat": "完成 QPS"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops", "decimals": 2 }
      }
    },
    {
      "title": "待办任务积压量",
      "type": "stat",
      "gridPos": { "h": 6, "w": 4, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "pmis_flow_pending_tasks",
          "legendFormat": "待办数"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 500 },
          { "color": "red", "value": 1000 }
        ]}}
      }
    },
    {
      "title": "运行中实例数",
      "type": "stat",
      "gridPos": { "h": 6, "w": 4, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "pmis_flow_running_instances",
          "legendFormat": "运行中"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },
    {
      "title": "超时率",
      "type": "stat",
      "gridPos": { "h": 6, "w": 4, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(pmis_flow_task_timeout_total[5m])) / sum(rate(pmis_flow_task_created_total[5m])) * 100",
          "legendFormat": "超时率%"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "decimals": 2, "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 5 },
          { "color": "red", "value": 10 }
        ]}}
      }
    },
    {
      "title": "驳回率",
      "type": "stat",
      "gridPos": { "h": 6, "w": 4, "x": 20, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(pmis_flow_task_rejected_total[5m])) / sum(rate(pmis_flow_task_created_total[5m])) * 100",
          "legendFormat": "驳回率%"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "decimals": 2 }
      }
    },
    {
      "title": "实例创建趋势（按流程编码）",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "sum by (flow_code) (rate(pmis_flow_instance_created_total[5m]))",
          "legendFormat": "{{flow_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      }
    },
    {
      "title": "实例完成趋势（按结果）",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "sum by (result) (rate(pmis_flow_instance_finished_total[5m]))",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      }
    },
    {
      "title": "任务处理耗时 P50/P95/P99（秒）",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(pmis_flow_task_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(pmis_flow_task_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(pmis_flow_task_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P99"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "title": "实例总耗时 P50/P95/P99（秒）",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(pmis_flow_instance_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(pmis_flow_instance_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(pmis_flow_instance_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P99"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "title": "SLA 触发次数（按动作）",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "targets": [
        {
          "expr": "sum by (action) (rate(pmis_flow_sla_timeout_total[5m]))",
          "legendFormat": "{{action}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      }
    },
    {
      "title": "任务操作分布（通过/驳回/转办/委派/催办）",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "targets": [
        { "expr": "sum(rate(pmis_flow_task_passed_total[5m]))", "legendFormat": "通过" },
        { "expr": "sum(rate(pmis_flow_task_rejected_total[5m]))", "legendFormat": "驳回" },
        { "expr": "sum(rate(pmis_flow_task_transferred_total[5m]))", "legendFormat": "转办" },
        { "expr": "sum(rate(pmis_flow_task_delegated_total[5m]))", "legendFormat": "委派" },
        { "expr": "sum(rate(pmis_flow_task_urged_total[5m]))", "legendFormat": "催办" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      }
    },
    {
      "title": "抄送未读数",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 30 },
      "targets": [
        {
          "expr": "pmis_flow_cc_unread",
          "legendFormat": "未读抄送"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },
    {
      "title": "启动异常次数",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 30 },
      "targets": [
        {
          "expr": "sum(rate(pmis_flow_start_error_total[5m]))",
          "legendFormat": "启动异常"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops", "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "red", "value": 0.1 }
        ]}}
      }
    },
    {
      "title": "Top 10 瓶颈节点（平均耗时最长）",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 36 },
      "targets": [
        {
          "expr": "topk(10, avg by (flow_code, node_code) (pmis_flow_task_duration_seconds_sum / pmis_flow_task_duration_seconds_count))",
          "legendFormat": "{{flow_code}} / {{node_code}}",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["pmis", "workflow", "bpmn"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "PMIS 工作流引擎监控",
  "uid": "pmis-flow-dashboard",
  "version": 1,
  "weekStart": ""
}
