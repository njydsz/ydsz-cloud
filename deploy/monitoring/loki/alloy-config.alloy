# =============================================================================
# Grafana Alloy 配置 - Loki 官方推荐采集器（替代 Promtail）
# -----------------------------------------------------------------------------
# 部署:
#   挂载至容器 /etc/alloy/config.alloy
#   启动: alloy run /etc/alloy/config.alloy
#
# 采集目标:
#   /var/log/ydsz/*.log (YDSZ 后端服务日志, 由 SentryLogbackLayout 输出)
#
# 优势（相比 Promtail）:
#   - 支持 OpenTelemetry 格式
#   - 支持管道处理器（pipeline processor）
#   - 支持服务发现（Kubernetes / Docker）
#   - 性能更好（基于 Go, 支持多线程）
# =============================================================================
server {
  http_listen_port = 12345
  log_level = "info"
}

// =============================================================================
// 日志采集 - YDSZ 应用日志
// =============================================================================
local.file_match "ydsz_app_logs" {
  path_targets = [{
    __path__  = "/var/log/ydsz/*.log",
    job       = "ydsz",
    source    = "app",
  }]
}

loki.source.file "ydsz_app" {
  targets    = local.file_match.ydsz_app_logs.targets
  forward_to = [loki.process.ydsz_json.receiver]
}

// =============================================================================
// 日志处理管道 - 解析 SentryLogbackLayout 输出的 JSON
// =============================================================================
loki.process "ydsz_json" {
  // 解析 JSON 结构化日志
  stage.json {
    expressions = {
      level     = "level",
      logger    = "logger_name",
      thread    = "thread_name",
      message   = "message",
      timestamp = "@timestamp",
      appName   = "app_name",
      hostname  = "hostname",
      profile   = "profile",
      traceId   = "traceId",
      userId    = "userId",
      username  = "username",
    }
  }

  // 提取 Loki 标签
  stage.labels {
    values = {
      level    = "",
      appName  = "",
      profile  = "",
      traceId  = "",
    }
  }

  // 提取时间戳
  stage.timestamp {
    source = "@timestamp"
    format = "RFC3339Nano"
  }

  // 输出消息内容
  stage.output {
    source = "message"
  }

  forward_to = [loki.write.ydsz.receiver]
}

// =============================================================================
// 日志采集 - YDSZ 审计日志
// =============================================================================
local.file_match "ydsz_audit_logs" {
  path_targets = [{
    __path__  = "/var/log/ydsz/audit-fallback.log",
    job       = "ydsz",
    source    = "audit",
  }]
}

loki.source.file "ydsz_audit" {
  targets    = local.file_match.ydsz_audit_logs.targets
  forward_to = [loki.process.ydsz_audit_json.receiver]
}

loki.process "ydsz_audit_json" {
  stage.json {
    expressions = {
      event   = "event",
      userId  = "userId",
      traceId = "traceId",
    }
  }

  stage.labels {
    values = {
      event = "",
    }
  }

  forward_to = [loki.write.ydsz.receiver]
}

// =============================================================================
// Loki 写入配置
// =============================================================================
loki.write "ydsz" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"

    // 批处理配置
    batchwait  = "1s"
    batchsize  = 1048576  // 1MB

    // 重试配置
    min_backoff = "500ms"
    max_backoff = "5m"
    max_retries = 10

    // 超时
    http_client_timeout = "10s"
  }
}

// =============================================================================
// Docker 容器日志采集（可选）
// =============================================================================
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
  filter {
    name   = "name"
    values = ["ydsz-*"]
  }
}

loki.source.docker "ydsz_containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.docker.containers.targets
  forward_to = [loki.write.ydsz.receiver]
}
