{
  "info": {
    "_postman_id": "pmis-contract-2026-07-01",
    "name": "PMIS OpenAPI 契约测试",
    "description": "基于 docs/api/openapi-summary.json 派生的 Postman v2.1.0 集合，覆盖 14 模块核心端点，用于 Newman 自动跑测与契约回归。验收依据：开发计划 11.1 节'全量接口契约测试（基于 OpenAPI）'。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "{{BASE_URL}}", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "traceId", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// 统一断言：响应时间 < 2000ms + 响应是 JSON + 包含 traceId",
          "pm.test('响应是 JSON', function () { pm.response.to.be.json; });",
          "pm.test('响应时间 < 2s', function () { pm.expect(pm.response.responseTime).to.be.below(2000); });",
          "try {",
          "  const body = pm.response.json();",
          "  pm.expect(body).to.have.property('code');",
          "  pm.expect(body).to.have.property('traceId');",
          "  pm.expect(body).to.have.property('timestamp');",
          "  pm.environment.set('traceId', body.traceId);",
          "} catch (e) {",
          "  console.log('响应非 R 包装结构，跳过 R 字段断言');",
          "}",
          ""
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. 鉴权 - 登录",
      "item": [
        {
          "name": "POST /api/v1/auth/login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"contract-test\",\"password\":\"contract123\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('登录成功', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "if (body && body.data && body.data.accessToken) {",
                  "  pm.environment.set('token', body.data.accessToken);",
                  "}",
                  ""
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. auth 模块",
      "item": [
        { "name": "POST /api/v1/auth/refresh", "request": { "method": "POST", "header": [], "url": { "raw": "{{baseUrl}}/api/v1/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","refresh"] } } },
