#!/bin/bash
# =============================================================================
# pre-commit — Git Pre-commit Hook
#
# 在 git commit 前自动执行以下检查：
#   1. 行内 FQN 违规检测（deploy/scripts/check-inline-fqn.sh --strict）
#   2. 未使用 import 检测（简易 grep 方案）
#
# 安装方式：
#   方式一（推荐）：运行 deploy/scripts/install-hooks.sh
#   方式二（手动）：将本文件复制到 .git/hooks/pre-commit 并赋予执行权限
#     cp deploy/scripts/pre-commit .git/hooks/pre-commit
#     chmod +x .git/hooks/pre-commit
#
# 跳过方式（紧急情况下）：
#   git commit --no-verify
#
# 退出码：
#   0 — 检查通过，允许提交
#   1 — 检查失败，阻断提交
# =============================================================================
set -euo pipefail

REPO_ROOT=$(git rev-parse --show-toplevel)
STAGED_JAVA_FILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.java' || true)

if [ -z "$STAGED_JAVA_FILES" ]; then
    # 没有 Java 文件变更，跳过检查
    exit 0
fi

echo "🔍 Pre-commit: 正在检查暂存的 Java 文件..."

# -----------------------------------------------------------------------------
# 1. 行内 FQN 违规检测（仅检查暂存文件）
# -----------------------------------------------------------------------------
TMPFILE=$(mktemp)
trap 'rm -f "$TMPFILE"' EXIT

VIOLATION_COUNT=0

for file in $STAGED_JAVA_FILES; do
    if [ ! -f "$REPO_ROOT/$file" ]; then
        continue
    fi

    # FQN 正则模式
    FQN_PATTERN='(com|org|java|javax|jakarta|net|io)\.[a-z][a-z0-9_]*(\.[a-z][a-z0-9_]*)*\.[A-Z][a-zA-Z0-9_]*'

    grep -nE "$FQN_PATTERN" "$REPO_ROOT/$file" 2>/dev/null | while IFS=':' read -r line_num line_content; do
        # 跳过 import 行
        trimmed=$(echo "$line_content" | sed 's/^[[:space:]]*//')
        case "$trimmed" in
            import\ *) continue ;;
            package\ *) continue ;;
        esac

        # 跳过带 FQN-OK 注释的行
        if echo "$line_content" | grep -q 'FQN-OK'; then
            continue
        fi

        # 跳过 Javadoc {@link FQN} 引用
        if echo "$line_content" | grep -qE '\{@link\s.*'"$FQN_PATTERN" ; then
            non_link_fqn=$(echo "$line_content" | sed 's/{@link[^}]*}//g')
            if ! echo "$non_link_fqn" | grep -qE "$FQN_PATTERN"; then
                continue
            fi
        fi

        # 跳过 @ConditionalOnClass(name = "FQN")
        if echo "$line_content" | grep -qE '@ConditionalOnClass\(name\s*=\s*"' ; then
            continue
        fi

        # 跳过字符串字面量中的 FQN
        code_only=$(echo "$line_content" | sed 's/"[^"]*"//g')
        if ! echo "$code_only" | grep -qE "$FQN_PATTERN"; then
            continue
        fi

        # 跳过纯注释说明行（Javadoc 标签行报告违规）
        if echo "$trimmed" | grep -qE '^(\*|//)' ; then
            if echo "$trimmed" | grep -qE '^(\*\s*)?@(throws|see|param|return)\s+'"$(echo "$FQN_PATTERN" | sed 's/\\//g')" ; then
                echo "  ❌ $file:$line_num" >> "$TMPFILE"
                echo "     $line_content" >> "$TMPFILE"
                continue
            fi
            continue
        fi

        echo "  ❌ $file:$line_num" >> "$TMPFILE"
        echo "     $line_content" >> "$TMPFILE"
    done
done

# 读取违规数
if [ -f "$TMPFILE" ]; then
    VIOLATION_COUNT=$(wc -l < "$TMPFILE")
    VIOLATION_COUNT=$((VIOLATION_COUNT / 2))
fi

if [ "$VIOLATION_COUNT" -gt 0 ]; then
    echo ""
    echo "❌ Pre-commit 检测到 $VIOLATION_COUNT 处行内 FQN 违规："
    cat "$TMPFILE"
    echo ""
    echo "修复方式：将行内全限定类名改为 import + 简单类名引用。"
    echo "跳过检查（不推荐）：git commit --no-verify"
    exit 1
fi

echo "✅ Pre-commit 检查通过。"
exit 0
