# =============================================================================
#  YDSZ · 开发/测试环境变量模板
# -----------------------------------------------------------------------------
#  使用方法:
#    1. 复制本文件为 .env：    cp deploy/.env.example deploy/.env
#    2. 按需修改账号密码（生产必须改）
#    3. docker compose 会自动读取 deploy/.env
#    4. 后端服务启动时也会读取此文件（通过 set -a; source deploy/.env; set +a）
#
#  安全警告:
#    - 本文件仅作为模板，所有敏感字段必须使用占位符 <your-xxx-here>
#    - 严禁在模板中填写任何真实密码/密钥（包括个人开发机密码）
#    - 生产环境必须从 Vault / K8s Secret / Sealed Secrets 注入，禁止使用 .env
#    - JWT_SECRET 必须填写 ≥ 32 字节的随机字符串（生产环境从 Vault/K8s Secret 注入）
#    - CORS_ALLOWED_ORIGINS 生产环境必须设置为显式域名白名单，禁止使用 *
#    - 如发现本文件中出现真实密码，请立即：1) git 历史清除 2) 全量轮换 3) 提安全事件
# =============================================================================

# -----------------------------------------------------------------------------
#  PostgreSQL 主数据库
# -----------------------------------------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ydsz
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<your-postgres-password-here>

# 后端使用（与 docker 容器内一致）
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ydsz
DB_USER=postgres
DB_PASSWORD=<your-postgres-password-here>

# -----------------------------------------------------------------------------
#  Redis
# -----------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=<your-redis-password-here>
REDIS_DB=0

# -----------------------------------------------------------------------------
#  Druid 监控台（生产环境建议关闭 DRUID_STAT_ENABLED=false）
# -----------------------------------------------------------------------------
DRUID_STAT_ENABLED=false
DRUID_STAT_USERNAME=
DRUID_STAT_PASSWORD=

# -----------------------------------------------------------------------------
#  Nacos 服务注册 + 配置中心
# -----------------------------------------------------------------------------
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=ydsz
NACOS_USERNAME=nacos
NACOS_PASSWORD=<your-nacos-password-here>
# profile：dev / sit / uat / prod
NACOS_PROFILE=dev

# -----------------------------------------------------------------------------
#  Sentinel 限流 Dashboard（可选，规则也可放 Nacos）
# -----------------------------------------------------------------------------
SENTINEL_DASHBOARD=127.0.0.1:8858
SENTINEL_TRANSPORT_PORT=8719

# -----------------------------------------------------------------------------
#  MinIO 对象存储
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=http://127.0.0.1:9100
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=<your-minio-secret-key-here>
MINIO_BUCKET=ydsz

# -----------------------------------------------------------------------------
#  XXL-Job 调度（可选，未启动 XXL-Job Admin 时保留默认值即可）
# -----------------------------------------------------------------------------
XXL_JOB_ADMIN_ADDRESSES=http://127.0.0.1:9100/xxl-job-admin
XXL_JOB_USERNAME=admin
XXL_JOB_PASSWORD=<your-xxl-job-password-here>
XXL_JOB_ACCESS_TOKEN=default-token
XXL_JOB_APPNAME=ydsz-executor
XXL_JOB_EXECUTOR_PORT=9999

# -----------------------------------------------------------------------------
#  RocketMQ（可选，未启动 NameServer 时保留默认值即可）
# -----------------------------------------------------------------------------
ROCKETMQ_NAME_SERVER=127.0.0.1:9876
ROCKETMQ_PRODUCER_GROUP=ydsz-producer-group
ROCKETMQ_CONSUMER_ENABLED=true

# -----------------------------------------------------------------------------
#  Seata 分布式事务（可选，未启动 Seata Server 时关闭）
# -----------------------------------------------------------------------------
SEATA_ENABLED=false
SEATA_SERVER_ADDR=127.0.0.1:8091

# -----------------------------------------------------------------------------
#  全文检索：PostgreSQL tsvector（P2-19 起替代 Elasticsearch，无需配置）
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
#  SMTP 邮件（内网部署如不发邮件，留空即可）
# -----------------------------------------------------------------------------
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USER=no-reply@example.com
MAIL_PASSWORD=

# -----------------------------------------------------------------------------
#  Webhook 默认地址（企微/钉钉/飞书机器人，留空表示不启用兜底）
# -----------------------------------------------------------------------------
YDSZ_WEBHOOK_DEFAULT_URL=

# -----------------------------------------------------------------------------
#  JWT 签名密钥（必须填写 ≥ 32 字节随机字符串，生产环境从 Vault/K8s Secret 注入）
#  警告: 留空时服务将无法启动；使用默认占位符时生产环境会拒绝启动
# -----------------------------------------------------------------------------
JWT_SECRET=
# 登录是否强制图形验证码
CAPTCHA_REQUIRED=false

# -----------------------------------------------------------------------------
#  CORS 跨域白名单（生产环境必须设置为显式域名，多个用逗号分隔）
#  示例: https://ydsz.cn,https://admin.ydsz.cn
#  dev 环境可留空，网关将默认允许所有来源（仅 dev profile 生效）
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
#  AI Agent LLM Provider
# -----------------------------------------------------------------------------
# Provider 选择: mock(默认) | spring-ai-openai | dashscope | qianfan
LLM_PROVIDER=mock
LLM_TIMEOUT_MILLIS=10000
LLM_MAX_RETRIES=2
LLM_FALLBACK_TO_MOCK=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
#  日志级别（root: INFO / com.njydsz: DEBUG）
# -----------------------------------------------------------------------------
LOG_ROOT_LEVEL=INFO
LOG_YDSZ_LEVEL=DEBUG
