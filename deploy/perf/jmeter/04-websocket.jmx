<?xml version="1.0" encoding="UTF-8"?>
<!-- =====================================================================
     PMIS 性能压测 - 长连接 WebSocket（批次 19）
     ---------------------------------------------------------------------
     场景：1k 并发 WebSocket 连接 10 分钟，消息 1/s/连接
     期望：连接成功率 > 99%，消息延迟 P99 < 100ms
     用途：通知/AI 推送实时性
     ===================================================================== -->
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="PMIS WebSocket 压测" enabled="true">
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments">
        <collectionProp name="Arguments.arguments">
          <elementProp name="WS_URL" elementType="Argument">
            <stringProp name="Argument.value">${__P(wsUrl,ws://localhost:9000/ws/notification)}</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="WS 压测" enabled="true">
        <stringProp name="ThreadGroup.num_threads">1000</stringProp>
        <stringProp name="ThreadGroup.ramp_time">120</stringProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">600</stringProp>
      </ThreadGroup>
      <hashTree>
        <!-- WebSocket Open Connection Sampler -->
        <eu.luminis.jmeter.wssampler.OpenWebSocketSampler guiclass="eu.luminis.jmeter.wssampler.OpenWebSocketSamplerGui" testclass="eu.luminis.jmeter.wssampler.OpenWebSocketSampler" testname="WS Open" enabled="true">
          <stringProp name="server">${__split(${WS_URL},,3)}</stringProp>
          <stringProp name="port">9000</stringProp>
          <stringProp name="path">/ws/notification</stringProp>
          <stringProp name="connectTimeout">10000</stringProp>
          <stringProp name="readTimeout">5000</stringProp>
        </eu.luminis.jmeter.wssampler.OpenWebSocketSampler>
        <hashTree/>
        <!-- WebSocket Ping/Pong Sampler -->
        <eu.luminis.jmeter.wssampler.PingWebSocketSampler guiclass="eu.luminis.jmeter.wssampler.PingWebSocketSamplerGui" testclass="eu.luminis.jmeter.wssampler.PingWebSocketSampler" testname="WS Ping" enabled="true"/>
        <hashTree>
          <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="ping interval" enabled="true">
            <stringProp name="ConstantTimer.delay">1000</stringProp>
          </ConstantTimer>
        </hashTree>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
