# ====================================================================
#  PMIS 全局环境变量模板（批次 19 落地）
#  ---------------------------------------------------------------------
#  用法：
#    1) 复制本文件为 .env：cp .env.example .env
#    2) 修改 .env 中的密码 / Token 等敏感字段
#    3) 不要把 .env 提交到 Git 仓库（.gitignore 已忽略）
#  说明：
#    镜像版本、数据库密码、JWT 密钥、第三方 API Key 等集中管理
# ====================================================================

# ---------- 镜像版本 ----------
IMAGE_TAG=1.0.0

# ---------- PostgreSQL ----------
POSTGRES_USER=pmis
POSTGRES_PASSWORD=pmis@2026
POSTGRES_DB=pmis

# ---------- Redis ----------
REDIS_PASSWORD=pmis@2026

# ---------- Nacos ----------
NACOS_AUTH_TOKEN=SecretKey012345678901234567890123456789012345678901234567890123456789
NACOS_AUTH_IDENTITY_KEY=pmis
NACOS_AUTH_IDENTITY_VALUE=pmis

# ---------- MinIO ----------
MINIO_ROOT_USER=pmis-admin
MINIO_ROOT_PASSWORD=pmis@2026

# ---------- XXL-Job ----------
XXL_JOB_ACCESS_TOKEN=pmis-xxl-token

# ---------- JWT 签名密钥（auth 模块使用） ----------
# 长度必须 ≥ 256 bit，建议 32 字节随机字符串
PMIS_JWT_SECRET=ReplaceMeWithARandomSecretOfAtLeast32Bytes_pmIs2026
PMIS_JWT_ACCESS_TTL=7200
PMIS_JWT_REFRESH_TTL=604800

# ---------- TOTP 双因素（user 模块） ----------
PMIS_TOTP_ISSUER=PMIS
PMIS_TOTP_DIGITS=6
PMIS_TOTP_PERIOD=30

# ---------- AES-256 加密（common 模块敏感字段） ----------
# 必须 32 字节，使用 openssl rand -base64 32 生成
PMIS_AES_KEY=ReplaceMeWithA32ByteKey_pmIs2026_secret
PMIS_AES_IV=ReplaceMeInitVector_pm

# ---------- SM4 国密（金融行业客户可选） ----------
PMIS_SM4_KEY=ReplaceMeWithA32ByteSm4Key_pm

# ---------- 数据备份（pg_backup.sh / pg_incremental.sh） ----------
PG_HOST=pmis-postgres
PG_PORT=5432
PG_USER=pmis
PG_PASSWORD=pmis@2026
PG_DBNAME=pmis
BACKUP_DIR=/var/backups/pmis
BACKUP_RETAIN_DAYS=30

# ---------- AI Agent 大模型接入（P3 真实 LLM 接入使用） ----------
# 当前使用 Mock 实现（批次 8 已说明），接入真实 LLM 时启用
PMIS_AGENT_LLM_PROVIDER=mock
PMIS_AGENT_LLM_BASE_URL=
PMIS_AGENT_LLM_API_KEY=
PMIS_AGENT_LLM_MODEL=qwen-plus

# ---------- Spring AI 集成（OpenAI / 通义 / Anthropic） ----------
SPRING_AI_OPENAI_API_KEY=
SPRING_AI_OPENAI_BASE_URL=https://api.openai.com
SPRING_AI_DASHSCOPE_API_KEY=
SPRING_AI_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com

# ---------- Sentinel 流控（apps.yml 内置 dashboard） ----------
SENTINEL_DASHBOARD_USER=pmis
SENTINEL_DASHBOARD_PASSWORD=pmis@2026

# ---------- Seata 分布式事务 ----------
SEATA_PORT=8091
SEATA_STORE_MODE=file

# ---------- Prometheus 监控 ----------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=pmis@2026

# ---------- 业务告警阈值（可被 ThresholdProvider 动态加载） ----------
PMIS_EVM_CPI_YELLOW=0.95
PMIS_EVM_CPI_RED=0.85
PMIS_EVM_SPI_YELLOW=0.95
PMIS_EVM_SPI_RED=0.85
PMIS_BUDGET_YELLOW_PCT=80
PMIS_BUDGET_RED_PCT=95
PMIS_BENCH_IDLE_DAYS_YELLOW=7
PMIS_BENCH_IDLE_DAYS_RED=15
PMIS_BENCH_BENCH_COST_PCT_RED=8
PMIS_UTILIZATION_OVERLOAD_PROJECTS=3

# ---------- 日志级别（按模块覆盖 application.yml） ----------
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_PMIS=DEBUG
LOG_LEVEL_ORG_SPRINGFRAMEWORK=WARN
LOG_LEVEL_ORG_HIBERNATE=WARN
