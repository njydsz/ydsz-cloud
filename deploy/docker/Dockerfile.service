# =====================================================================
#  PMIS 通用微服务 Dockerfile（适用于除 gateway 外的所有后端服务）
# ---------------------------------------------------------------------
#  构建参数：
#    APP_NAME   - 应用名（如 pmis-auth / pmis-user）
#    SERVER_PORT- 服务端口（如 9001）
#    JAR_FILE   - jar 文件路径（相对构建上下文）
#
#  用法：
#    docker build -f Dockerfile.service \
#      --build-arg APP_NAME=pmis-auth \
#      --build-arg SERVER_PORT=9001 \
#      --build-arg JAR_FILE=ydsz-pmis-auth/target/ydsz-pmis-auth-*.jar \
#      -t pmis-auth:1.0.0 .
# =====================================================================
FROM pmis-base:1.0.0

LABEL description="PMIS microservice image"

# ---- 构建参数 ----
ARG APP_NAME=pmis-app
ARG SERVER_PORT=9000
ARG JAR_FILE=target/*.jar

# ---- 业务 jar 拷贝 ----
COPY --chown=appuser:appgroup ${JAR_FILE} /opt/pmis/app.jar

# ---- 微服务环境变量 ----
ENV APP_NAME=${APP_NAME} \
    SERVER_PORT=${SERVER_PORT}

EXPOSE ${SERVER_PORT}
