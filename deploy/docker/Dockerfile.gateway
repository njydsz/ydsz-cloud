# =====================================================================
#  PMIS 网关层 Dockerfile（示例：ydsz-pmis-gateway）
# ---------------------------------------------------------------------
#  展示如何基于 Dockerfile.base 扩展具体微服务镜像。
#  其他 13 个微服务同理（替换 APP_NAME / SERVER_PORT 即可）。
# =====================================================================
FROM pmis-base:1.0.0

LABEL description="PMIS API Gateway"

# ---- 业务 jar 拷贝 ----
COPY --chown=appuser:appgroup target/ydsz-pmis-gateway-*.jar /opt/pmis/app.jar

# ---- 微服务环境变量 ----
ENV APP_NAME="pmis-gateway" \
    SERVER_PORT=9000

EXPOSE 9000
