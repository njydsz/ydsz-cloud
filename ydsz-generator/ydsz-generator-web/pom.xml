<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.njydsz</groupId>
    <artifactId>ydsz-generator</artifactId>
    <version>26.09.01-SNAPSHOT</version>
  </parent>

  <artifactId>ydsz-generator-web</artifactId>
  <name>ydsz-generator-web</name>
  <description>代码生成器接口层 — REST 控制器、DTO、Assembler</description>

  <dependencies>
    <dependency>
      <groupId>com.njydsz</groupId>
      <artifactId>ydsz-generator-server</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.njydsz</groupId>
      <artifactId>ydsz-common-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.njydsz</groupId>
      <artifactId>ydsz-common-exception</artifactId>
    </dependency>
    <dependency>
      <groupId>com.njydsz</groupId>
      <artifactId>ydsz-common-base</artifactId>
    </dependency>
    <dependency>
      <groupId>com.njydsz</groupId>
      <artifactId>ydsz-common-audit</artifactId>
    </dependency>
    <!-- P0-1: ydsz-common-auth 提供 Spring Security 方法级鉴权底层能力 -->
    <dependency>
      <groupId>com.njydsz</groupId>
      <artifactId>ydsz-common-auth</artifactId>
    </dependency>
    <!-- P1-2: ydsz-common-web 提供 WebAuthFilter / CSRF / TraceFilter 等 Web 基础能力 -->
    <dependency>
      <groupId>com.njydsz</groupId>
      <artifactId>ydsz-common-web</artifactId>
    </dependency>
    <!-- P0-1: spring-boot-starter-security 提供 SecurityFilterChain / HttpSecurity / @Secured / @EnableMethodSecurity -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
          <!-- 单元测试基础设施：JUnit 5 + AssertJ + Mockito（云顶编码规范 §14.1） -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency></dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.njydsz.generator.GeneratorWebApplication</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
