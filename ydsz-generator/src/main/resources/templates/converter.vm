package ${package}.infra.converter;

import java.util.List;

import org.mapstruct.Mapper;
import org.mapstruct.Mapping;
import org.mapstruct.MappingTarget;
import org.mapstruct.ReportingPolicy;

import ${package}.domain.dto.${table.dtoName};
import ${package}.domain.entity.${table.entityName};
import ${package}.domain.vo.${table.voName};

/**
 * ${table.tableComment} MapStruct 对象转换器
 *
 * <p>Entity ↔ DTO ↔ VO 相互转换，由 MapStruct 在编译期生成实现类。
 *
 * <p><b>设计要点：</b>
 * <ul>
 *   <li>componentModel = "spring" — 生成 Spring Bean，可直接注入使用</li>
 *   <li>unmappedTargetPolicy = IGNORE — 目标对象多余字段不报错（审计字段由基类处理）</li>
 * </ul>
 *
 * @author ${author}
 * @since ${date}
 */
@Mapper(componentModel = "spring", unmappedTargetPolicy = ReportingPolicy.IGNORE)
public interface ${table.converterName} {

  /**
   * DTO → Entity（新增场景，忽略审计字段和主键）。
   *
   * @param dto 数据传输对象
   * @return 领域实体
   */
  @Mapping(target = "id", ignore = true)
  @Mapping(target = "createdAt", ignore = true)
  @Mapping(target = "createdBy", ignore = true)
  @Mapping(target = "updatedAt", ignore = true)
  @Mapping(target = "updatedBy", ignore = true)
  @Mapping(target = "deleted", ignore = true)
  @Mapping(target = "tenantId", ignore = true)
  ${table.entityName} dtoToEntity(${table.dtoName} dto);

  /**
   * DTO → Entity（更新场景，保留主键）。
   *
   * @param dto 数据传输对象（含主键 ID）
   * @return 领域实体
   */
  @Mapping(target = "createdAt", ignore = true)
  @Mapping(target = "createdBy", ignore = true)
  @Mapping(target = "updatedAt", ignore = true)
  @Mapping(target = "updatedBy", ignore = true)
  @Mapping(target = "deleted", ignore = true)
  @Mapping(target = "tenantId", ignore = true)
  ${table.entityName} dtoToEntityWithId(${table.dtoName} dto);

  /**
   * Entity → VO（单对象转换）。
   *
   * @param entity 领域实体
   * @return 视图对象
   */
  ${table.voName} entityToVO(${table.entityName} entity);

  /**
   * Entity 列表 → VO 列表。
   *
   * @param entities 领域实体列表
   * @return 视图对象列表
   */
  List<${table.voName}> toList(List<${table.entityName}> entities);
}
