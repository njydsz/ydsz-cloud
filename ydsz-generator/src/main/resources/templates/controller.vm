package ${package}.web.controller;

import java.util.List;

import io.swagger.v3.oas.annotations.Operation;
import io.swagger.v3.oas.annotations.tags.Tag;
import jakarta.validation.Valid;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.web.bind.annotation.DeleteMapping;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.njydsz.common.auth.annotation.AuthApiPermission;
import com.njydsz.common.core.response.PageResponse;
import com.njydsz.common.core.response.YdszResponse;
import ${package}.domain.dto.${table.dtoName};
import ${package}.domain.query.${table.queryName};
import ${package}.domain.vo.${table.voName};
import ${package}.server.service.${table.serviceName};

/**
 * ${table.tableComment} Controller
 *
 * <p>提供 CRUD、分页查询等管理能力。接口路径：${table.apiPath}
 *
 * @author ${author}
 * @since ${date}
 */
@Tag(name = "${table.tableComment}管理", description = "${table.tableComment!} CRUD")
@Slf4j
@RestController
@RequestMapping("${table.apiPath}")
@RequiredArgsConstructor
@AuthApiPermission(apiCodes = "${table.permissionPrefix}:list")
public class ${table.controllerName} {

  private final ${table.serviceName} service;

  @Operation(summary = "分页查询列表")
  @GetMapping("/page")
  public YdszResponse<PageResponse<List<${table.voName}>>> page(${table.queryName} query) {
    query.setPageSize(Math.min(query.getPageSize(), MAX_PAGE_SIZE));
    return YdszResponse.success(service.page(query));
  }

  @Operation(summary = "按 ID 查询")
  @GetMapping("/{id}")
  public YdszResponse<${table.voName}> getById(@PathVariable String id) {
    return YdszResponse.success(service.getById(id));
  }

  @Operation(summary = "创建")
  @PostMapping
  @AuthApiPermission(apiCodes = "${table.permissionPrefix}:add")
  public YdszResponse<String> save(@Valid @RequestBody ${table.dtoName} dto) {
    return YdszResponse.success(service.save(dto));
  }

  @Operation(summary = "更新")
  @PutMapping
  @AuthApiPermission(apiCodes = "${table.permissionPrefix}:edit")
  public YdszResponse<Boolean> update(@Valid @RequestBody ${table.dtoName} dto) {
    return YdszResponse.success(service.updateById(dto));
  }

  @Operation(summary = "删除")
  @DeleteMapping("/{id}")
  @AuthApiPermission(apiCodes = "${table.permissionPrefix}:delete")
  public YdszResponse<Boolean> remove(@PathVariable String id) {
    return YdszResponse.success(service.removeById(id));
  }

  /** 分页安全上限 */
  private static final int MAX_PAGE_SIZE = 500;
}
