package ${package}.api;

import lombok.extern.slf4j.Slf4j;
import org.springframework.cloud.openfeign.FallbackFactory;
import org.springframework.stereotype.Component;

import com.njydsz.common.core.response.YdszResponse;
import ${package}.domain.vo.${table.voName};

/**
 * ${table.tableComment} FeignClient 熔断降级工厂
 *
 * <p>当远程服务不可用时返回降级响应，避免调用方因 RPC 异常瘫痪。
 *
 * @author ${author}
 * @since ${date}
 */
@Slf4j
@Component
public class ${table.entityName}ClientFallbackFactory implements FallbackFactory<${table.entityName}FeignClient> {

  @Override
  public ${table.entityName}FeignClient create(Throwable cause) {
    log.warn("${table.entityName} 远程调用降级: {}", cause.getMessage());
    return new ${table.entityName}FeignClient() {

      private static final String REMOTE_ERROR = "远程服务暂不可用: ";

      @Override
      public YdszResponse<${table.voName}> getById(String id) {
        return YdszResponse.fail(REMOTE_ERROR + cause.getMessage());
      }

      @Override
      public YdszResponse<?> page(Integer pageNum, Integer pageSize) {
        return YdszResponse.fail(REMOTE_ERROR + cause.getMessage());
      }

      @Override
      public YdszResponse<String> save(${package}.domain.dto.${table.dtoName} dto) {
        return YdszResponse.fail(REMOTE_ERROR + cause.getMessage());
      }

      @Override
      public YdszResponse<Boolean> update(${package}.domain.dto.${table.dtoName} dto) {
        return YdszResponse.fail(REMOTE_ERROR + cause.getMessage());
      }

      @Override
      public YdszResponse<Boolean> remove(String id) {
        return YdszResponse.fail(REMOTE_ERROR + cause.getMessage());
      }
    };
  }
}
