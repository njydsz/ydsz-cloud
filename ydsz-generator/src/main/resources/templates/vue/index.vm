<template>
  <div class="${table.entityName}Manager">
    <!-- 搜索栏 -->
    <el-card class="search-card" shadow="never">
      <el-form :model="queryForm" inline size="default">
#foreach($col in $table.columns)
#if($col.javaShortType == "String" && !$col.auditField)
        <el-form-item label="${col.comment}">
          <el-input
            v-model="queryForm.${col.javaFieldName}"
            placeholder="请输入${col.comment}"
            clearable
            style="width: 200px"
          />
        </el-form-item>
#end
#end
        <el-form-item>
          <el-button type="primary" @click="handleSearch">
            <el-icon><Search /></el-icon>查询
          </el-button>
          <el-button @click="handleReset">
            <el-icon><Refresh /></el-icon>重置
          </el-button>
        </el-form-item>
      </el-form>
    </el-card>

    <!-- 数据表格 -->
    <el-card class="table-card" shadow="never">
      <!-- 操作栏 -->
      <div class="toolbar">
        <el-button type="primary" @click="handleAdd">
          <el-icon><Plus /></el-icon>新增
        </el-button>
        <el-button type="danger" :disabled="selectedRows.length === 0" @click="handleBatchDelete">
          <el-icon><Delete /></el-icon>批量删除
        </el-button>
      </div>

      <!-- 表格 -->
      <el-table
        v-loading="loading"
        :data="tableData"
        border
        stripe
        @selection-change="handleSelectionChange"
      >
        <el-table-column type="selection" width="55" align="center" />
#foreach($col in $table.allColumns)
#if(!$col.auditField || $col.primaryKey)
        <el-table-column
          prop="${col.javaFieldName}"
          label="${col.comment}"
          min-width="120"
          show-overflow-tooltip
        />
#end
#end
        <el-table-column label="操作" width="180" fixed="right" align="center">
          <template #default="{ row }">
            <el-button type="primary" link size="small" @click="handleEdit(row)">
              编辑
            </el-button>
            <el-button type="danger" link size="small" @click="handleDelete(row)">
              删除
            </el-button>
          </template>
        </el-table-column>
      </el-table>

      <!-- 分页 -->
      <el-pagination
        v-model:current-page="queryForm.pageNum"
        v-model:page-size="queryForm.pageSize"
        :total="total"
        :page-sizes="[10, 20, 50, 100]"
        layout="total, sizes, prev, pager, next, jumper"
        background
        class="pagination"
        @size-change="handleSizeChange"
        @current-change="handleCurrentChange"
      />
    </el-card>

    <!-- 新增/编辑弹窗 -->
    <el-dialog
      v-model="dialogVisible"
      :title="dialogMode === 'add' ? '新增${table.tableComment}' : '编辑${table.tableComment}'"
      width="600px"
      :close-on-click-modal="false"
    >
      <el-form
        ref="formRef"
        :model="formData"
        :rules="formRules"
        label-width="100px"
        size="default"
      >
#foreach($col in $table.columns)
        <el-form-item label="${col.comment}" prop="${col.javaFieldName}">
          <el-input
            v-model="formData.${col.javaFieldName}"
            placeholder="请输入${col.comment}"
            maxlength="${col.columnSize}"
            show-word-limit
          />
        </el-form-item>
#end
      </el-form>
      <template #footer>
        <el-button @click="dialogVisible = false">取消</el-button>
        <el-button type="primary" :loading="submitting" @click="handleSubmit">
          确定
        </el-button>
      </template>
    </el-dialog>
  </div>
</template>

<script setup>
import { ref, reactive, onMounted } from 'vue'
import { ElMessage, ElMessageBox } from 'element-plus'
import { Search, Refresh, Plus, Delete } from '@element-plus/icons-vue'
import {
  get${table.entityName}Page,
  save${table.entityName},
  update${table.entityName},
  remove${table.entityName}
} from '@/api/${module}/${table.entityName.toLowerCase()}'

// 查询参数
const queryForm = reactive({
  pageNum: 1,
  pageSize: 10,
#foreach($col in $table.columns)
#if($col.javaShortType == "String" && !$col.auditField)
  ${col.javaFieldName}: '',
#end
#end
})

// 表格数据
const loading = ref(false)
const tableData = ref([])
const total = ref(0)
const selectedRows = ref([])

// 弹窗
const dialogVisible = ref(false)
const dialogMode = ref('add')
const formRef = ref(null)
const submitting = ref(false)
const formData = reactive({
#foreach($col in $table.columns)
  ${col.javaFieldName}: '',
#end
})

// 表单校验规则
const formRules = {
#foreach($col in $table.columns)
#if(!$col.nullable && !$col.primaryKey)
  ${col.javaFieldName}: [
    { required: true, message: '请输入${col.comment}', trigger: 'blur' }
  ],
#end
#end
}

// 查询列表
const fetchList = async () => {
  loading.value = true
  try {
    const res = await get${table.entityName}Page(queryForm)
    tableData.value = res.data.records || []
    total.value = res.data.total || 0
  } finally {
    loading.value = false
  }
}

// 搜索
const handleSearch = () => {
  queryForm.pageNum = 1
  fetchList()
}

// 重置
const handleReset = () => {
  Object.keys(queryForm).forEach(key => {
    queryForm[key] = key === 'pageNum' ? 1 : key === 'pageSize' ? 10 : ''
  })
  fetchList()
}

// 分页
const handleSizeChange = (size) => {
  queryForm.pageSize = size
  fetchList()
}

const handleCurrentChange = (page) => {
  queryForm.pageNum = page
  fetchList()
}

// 选择
const handleSelectionChange = (rows) => {
  selectedRows.value = rows
}

// 新增
const handleAdd = () => {
  dialogMode.value = 'add'
  Object.keys(formData).forEach(key => {
    formData[key] = ''
  })
  dialogVisible.value = true
}

// 编辑
const handleEdit = (row) => {
  dialogMode.value = 'edit'
  Object.assign(formData, row)
  dialogVisible.value = true
}

// 提交
const handleSubmit = async () => {
  const valid = await formRef.value?.validate()
  if (!valid) return

  submitting.value = true
  try {
    if (dialogMode.value === 'add') {
      await save${table.entityName}(formData)
      ElMessage.success('创建成功')
    } else {
      await update${table.entityName}(formData)
      ElMessage.success('更新成功')
    }
    dialogVisible.value = false
    fetchList()
  } finally {
    submitting.value = false
  }
}

// 删除
const handleDelete = async (row) => {
  await ElMessageBox.confirm('确定删除该记录？', '提示', { type: 'warning' })
  await remove${table.entityName}(row.id)
  ElMessage.success('删除成功')
  fetchList()
}

// 批量删除
const handleBatchDelete = async () => {
  const ids = selectedRows.value.map(r => r.id)
  await ElMessageBox.confirm(`确定删除选中的 ${ids.length} 条记录？`, '提示', { type: 'warning' })
  // TODO: 调用批量删除接口
  ElMessage.success('批量删除成功')
  fetchList()
}

onMounted(() => {
  fetchList()
})
</script>

<style scoped>
.${table.entityName}Manager {
  padding: 16px;
}

.search-card {
  margin-bottom: 16px;
}

.table-card {
  margin-bottom: 16px;
}

.toolbar {
  margin-bottom: 16px;
}

.pagination {
  margin-top: 16px;
  justify-content: flex-end;
}
</style>
