package ${package}.api.assembler;

import java.util.List;

import ${package}.domain.dto.${table.dtoName};
import ${package}.domain.vo.${table.voName};

/**
 * ${table.tableComment} Feign 参数装配器
 *
 * <p>将外部 RPC 请求参数装配为本模块 domain 层识别的 DTO/Query，并将 domain VO 转为 RPC 友好的结构。
 *
 * <p><b>职责边界：</b>
 * <ul>
 *   <li>仅做参数转换，不触发业务逻辑</li>
 *   <li>不依赖 infra/server/web 层，符合 YDIZ-ARCH-001 单向依赖</li>
 * </ul>
 *
 * <p><b>YDIZ-DDD-005 合规说明：</b>本模块为 api 层，仅引用 domain 层已定义的 DTO/Query/VO，不自建 dto/vo/query 子包。
 *
 * @author ${author}
 * @since ${date}
 */
public final class ${table.entityName}Assembler {

  private ${table.entityName}Assembler() {
    throw new UnsupportedOperationException("Utility class");
  }

  /**
   * 将保存请求参数转为 DTO。
   *
   * <p>子类或调用方可覆写此方法以添加自定义字段映射。
   *
   * @param param 外部传入参数
   * @return domain DTO
   */
  public static ${table.dtoName} toDto(${table.dtoName} param) {
    return param;
  }

  /**
   * 将 domain VO 转为对外 RPC 视图。
   *
   * <p>默认直接返回，若需裁剪字段可在此处构建 {@code Map<String, Object>} 或专用 RPC VO。
   *
   * @param vo 域视图对象
   * @return RPC 视图
   */
  public static ${table.voName} toRpcView(${table.voName} vo) {
    return vo;
  }

  /**
   * 批量转换 VO 列表。
   *
   * @param voList 域视图对象列表
   * @return RPC 视图列表
   */
  public static List<${table.voName}> toRpcList(List<${table.voName}> voList) {
    return voList;
  }
}
