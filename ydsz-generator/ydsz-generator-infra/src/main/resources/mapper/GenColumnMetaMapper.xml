<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.njydsz.generator.mapper.GenColumnMetaMapper">

  <resultMap id="BaseResultMap" type="com.njydsz.generator.entity.GenColumnMeta">
    <id     column="id"                  property="id"/>
    <result column="table_meta_id"       property="tableMetaId"/>
    <result column="column_name"         property="columnName"/>
    <result column="data_type"           property="dataType"/>
    <result column="column_size"         property="columnSize"/>
    <result column="is_nullable"        property="isNullable"/>
    <result column="is_pk"               property="isPk"/>
    <result column="comment"             property="comment"/>
    <result column="override_java_type"  property="overrideJavaType"/>
    <result column="override_field_name" property="overrideFieldName"/>
    <result column="is_dto_skipped"     property="isDtoSkipped"/>
    <result column="is_vo_skipped"      property="isVoSkipped"/>
    <result column="is_query_skipped"   property="isQuerySkipped"/>
    <result column="extra_config"        property="extraConfig"/>
  </resultMap>

  <select id="selectByTableMetaIdOrderByIdAsc" resultMap="BaseResultMap">
    SELECT id, table_meta_id, column_name, data_type, column_size, is_nullable, is_pk, "comment", override_java_type, override_field_name, is_dto_skipped, is_vo_skipped, is_query_skipped, extra_config
    FROM ydsz_gen_column_meta
    WHERE table_meta_id = #{tableMetaId}
    ORDER BY id ASC
  </select>

</mapper>
