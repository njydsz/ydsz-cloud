#parse("velocity_implicit.vm")
#set($entityName = $text.textFirstUpper($table.aliasName))
#set($lowerName = $text.textFirstLower($entityName))
package ${package}.web.controller;

import io.swagger.v3.oas.annotations.Operation;
import io.swagger.v3.oas.annotations.tags.Tag;
import jakarta.validation.Valid;
import lombok.RequiredArgsConstructor;
import org.springframework.web.bind.annotation.DeleteMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.njydsz.common.core.response.PageResponse;
import com.njydsz.common.core.response.YdszResponse;
import ${package}.domain.dto.${entityName}Dto;
import ${package}.domain.entity.${entityName};
import ${package}.domain.query.${entityName}Query;
import ${package}.domain.service.${entityName}Service;

/**
 * ${table.comment} REST 控制器。
 *
 * <p>映射路径**不带** {@code /api} 前缀：前缀剥离由网关负责（与平台既有 Controller 一致，如
 * {@code AgentController#chat} 映射 {@code /agent/chat}）。
 *
 * @author ${author}
 * @since ${date}
 */
@Tag(name = "${table.comment}接口")
@RestController
@RequestMapping("/${lowerName}")
@RequiredArgsConstructor
public class ${entityName}Controller {

  private final ${entityName}Service ${lowerName}Service;

  /**
   * 分页查询。
   */
  @Operation(summary = "分页查询")
  @PostMapping("/page")
  public YdszResponse<PageResponse<${entityName}>> page(
      @Valid @RequestBody ${entityName}Query query) {
    // TODO: 对外展示需要裁剪字段时，把 ${entityName} 映射为 ${entityName}Vo
    return YdszResponse.success(${lowerName}Service.page(query));
  }

  /**
   * 新增。
   */
  @Operation(summary = "新增")
  @PostMapping
  public YdszResponse<Boolean> create(@Valid @RequestBody ${entityName}Dto dto) {
    // TODO: DTO → Entity 映射后调用 ${lowerName}Service.create(entity)
    return YdszResponse.success(true);
  }

  /**
   * 修改。
   */
  @Operation(summary = "修改")
  @PutMapping
  public YdszResponse<Boolean> update(@Valid @RequestBody ${entityName}Dto dto) {
    // TODO: DTO → Entity 映射后调用 ${lowerName}Service.update(entity)
    return YdszResponse.success(true);
  }

  /**
   * 删除。
   */
  @Operation(summary = "删除")
  @DeleteMapping("/{id}")
  public YdszResponse<Boolean> delete(@PathVariable("id") String id) {
    return YdszResponse.success(${lowerName}Service.removeById(id));
  }
}
