<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.njydsz</groupId>
    <artifactId>ydsz-generator</artifactId>
    <version>26.10.01-SNAPSHOT</version>
  </parent>

  <artifactId>ydsz-generator-server</artifactId>
  <name>ydsz-generator-server</name>
  <description>代码生成器业务编排层 — 领域服务、代码生成引擎、任务调度</description>

  <dependencies>
  <!-- 显式声明：本模块源码直接使用该公共能力（原先仅经传递依赖获得，P1-5 整改） -->
  <dependency>
      <groupId>com.njydsz</groupId>
      <artifactId>ydsz-common-util</artifactId>
  </dependency>
    <dependency>
      <groupId>com.njydsz</groupId>
      <artifactId>ydsz-generator-infra</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- ydsz-common-exception：全局异常枚举 BusinessException/SysException -->
    <dependency>
      <groupId>com.njydsz</groupId>
      <artifactId>ydsz-common-exception</artifactId>
    </dependency>
    <dependency>
      <groupId>com.njydsz</groupId>
      <artifactId>ydsz-common-thread</artifactId>
    </dependency>
    <!-- P2-4: common-json（TemplateImportExportService 构建 manifest JSON 使用 YdszJson，避免字段含特殊字符破坏结构） -->
    <dependency>
      <groupId>com.njydsz</groupId>
      <artifactId>ydsz-common-json</artifactId>
    </dependency>
    <!-- P1-3: ydsz-common-lock 提供 DistributedLocker 分布式锁 -->
    <dependency>
      <groupId>com.njydsz</groupId>
      <artifactId>ydsz-common-lock</artifactId>
    </dependency>
    <!-- P1-3: ydsz-common-redis 提供 RedisStringOps/RedisHashOps -->
    <dependency>
      <groupId>com.njydsz</groupId>
      <artifactId>ydsz-common-redis</artifactId>
    </dependency>
    <!-- P8: ydsz-common-sentry 提供 SentryObservation 可观测埋点 -->
    <dependency>
      <groupId>com.njydsz</groupId>
      <artifactId>ydsz-common-sentry</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.velocity</groupId>
      <artifactId>velocity-engine-core</artifactId>
      <version>2.4.1</version>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
          <!-- 单元测试基础设施：JUnit 5 + AssertJ + Mockito（云顶编码规范 §14.1） -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- JUnit Jupiter Params（@ParameterizedTest 支持，修复 TemplateInvocationValidationException） -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- ArchUnit：DDD 分层架构合规门禁（YDIZ-DDD-001 P0 编译期拦截） -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
</dependencies>

    <!-- B1-2 覆盖率棘轮（2026-10-26 实测：mvn -o test jacoco:report）。
         值 = 本模块 BUNDLE 实测覆盖率向下取整到 0.1%，只可下调不可上调；
         根 pom 默认 0.01/0.005 是新模块起步线，真正的 PR 门禁是
         data/scripts/check-diff-coverage.py（增量行覆盖率 >= 40%，云顶编码规范 14.7）。 -->
    <properties>
        <jacoco.line.threshold>0.023</jacoco.line.threshold>
        <jacoco.branch.threshold>0.011</jacoco.branch.threshold>
    </properties>
</project>
