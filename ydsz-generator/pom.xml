<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.njydsz</groupId>
    <artifactId>ydsz-cloud</artifactId>
    <version>26.09.01-SNAPSHOT</version>
  </parent>

  <artifactId>ydsz-generator</artifactId>
  <packaging>pom</packaging>
  <name>ydsz-generator</name>
  <description>代码生成器聚合 BOM — 基于数据库表结构自动生成 DDD 分层 CRUD 代码</description>

  <modules>
    <module>ydsz-generator-domain</module>
    <module>ydsz-generator-infra</module>
    <module>ydsz-generator-server</module>
    <module>ydsz-generator-web</module>
  </modules>

  <properties>
    <mapstruct.version>1.6.3</mapstruct.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.njydsz</groupId>
        <artifactId>ydsz-generator-domain</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.njydsz</groupId>
        <artifactId>ydsz-generator-infra</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.njydsz</groupId>
        <artifactId>ydsz-generator-server</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <annotationProcessorPaths>
              <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
              </path>
              <path>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
              </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

</project>
