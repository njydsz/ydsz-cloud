<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.njydsz</groupId>
    <artifactId>ydsz-generator</artifactId>
    <version>26.09.01-SNAPSHOT</version>
  </parent>

  <artifactId>ydsz-generator-domain</artifactId>
  <name>ydsz-generator-domain</name>
  <description>代码生成器领域层 — 实体、VO、枚举、Repository 接口</description>

  <dependencies>
    <dependency>
      <groupId>com.njydsz</groupId>
      <artifactId>ydsz-common-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.njydsz</groupId>
      <artifactId>ydsz-common-util</artifactId>
    </dependency>
    <!-- ydsz-common-jdbc：提供 MpBaseEntity/MpBaseAuditEntity 基类、PageResponses、MybatisPlus 审计 -->
    <dependency>
      <groupId>com.njydsz</groupId>
      <artifactId>ydsz-common-jdbc</artifactId>
    </dependency>
    <!-- mybatis: 编译期提供 JdbcType 等枚举，满足 mybatis-plus-annotation @TableField.jdbcType() 默认值解析 -->
    <dependency>
      <groupId>org.mybatis</groupId>
      <artifactId>mybatis</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- mybatis-plus-annotation: Domain Entity 使用 @TableId/@TableName/@TableField
         注：本模块不依赖 ydsz-common-domain，故独立声明（与 common-domain 写法一致） -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-annotation</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
  </dependencies>

</project>
