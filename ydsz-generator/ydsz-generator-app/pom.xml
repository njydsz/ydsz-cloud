<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.njydsz</groupId>
    <artifactId>ydsz-generator</artifactId>
    <version>26.09.01-SNAPSHOT</version>
  </parent>

  <artifactId>ydsz-generator-app</artifactId>
  <name>ydsz-generator-app</name>
  <description>代码生成器 CLI 应用入口 — 独立运行的命令行工具</description>

  <dependencies>
    <!-- 依赖 server 层以使用领域服务 -->
    <dependency>
      <groupId>com.njydsz</groupId>
      <artifactId>ydsz-generator-server</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- DDD: api 契约层 -->
    <dependency>
      <groupId>com.njydsz</groupId>
      <artifactId>ydsz-generator-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Spring Boot Starter -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <!-- Lombok -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.njydsz.generator.app.GeneratorCliApplication</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
