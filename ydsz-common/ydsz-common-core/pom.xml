<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.njydsz</groupId>
        <artifactId>ydsz-common</artifactId>
        <version>26.10.01-SNAPSHOT</version>
    </parent>

    <artifactId>ydsz-common-core</artifactId>
    <name>ydsz-common-core</name>
    <description>minimal core — response model, request context, trace ID, constants, enums</description>

    <dependencies>
        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- SLF4J API -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- TransmittableThreadLocal -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>transmittable-thread-local</artifactId>
        </dependency>
        <!-- spring-boot（提供 spring-core、spring-context、spring-beans 等核心 API）
             CoreAutoConfiguration / CoreProperties / SpringMessageResolver 直接使用这些包 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- spring-boot-autoconfigure（提供 @AutoConfiguration、@ConditionalOnXxx 等注册机制）
             CoreAutoConfiguration 直接使用注解和条件 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- jakarta.validation-api（提供 @Min、@Max、@AssertTrue 校验注解）
             CoreProperties 字段级校验直接使用 -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- JSON 模块 -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-json</artifactId>
        </dependency>
        <!-- ydsz-common-locales（国际化基座，DataScopeConstants 使用 I18n.message） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-locales</artifactId>
        </dependency>
        <!-- spring-web（提供 RestTemplate / HttpHeaders / HttpEntity 等 HTTP 客户端能力，WebhookDispatcher 使用） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- spring-boot-starter-test: 提供 AssertJ + JsonPath + Spring Boot 扩展（scope=test，不打包到主 jar） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- spring-test: 提供 MockMvc / MockMvcBuilders（BaseControllerMockTest 使用，compile scope 打包到主 jar，供下游测试继承） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <scope>compile</scope>
            <optional>true</optional>
        </dependency>
        <!-- mockito-core: 提供 @Mock / @InjectMocks（BaseControllerMockTest 继承链依赖，compile scope 打包） -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>compile</scope>
            <optional>true</optional>
        </dependency>
        <!-- junit-jupiter-api: 提供 @ExtendWith 注解（compile scope 打包） -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>compile</scope>
            <optional>true</optional>
        </dependency>
        <!-- mockito-junit-jupiter: 提供 MockitoExtension（compile scope 打包，下游模块自动继承） -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>compile</scope>
            <optional>true</optional>
        </dependency>

    </dependencies>

</project>
