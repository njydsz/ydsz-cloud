<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <artifactId>ydsz-common-jdbc</artifactId>
    <name>ydsz-common-jdbc</name>
    <description>数据库访问模块,支持多数据源路由、动态切换、MyBatis-Plus 增强</description>

    <parent>
        <groupId>com.njydsz</groupId>
        <artifactId>ydsz-common</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <dependencies>
        <!--ydsz-common-core-->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-core</artifactId>
        </dependency>
        <!--ydsz-common-domain-->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-domain</artifactId>
        </dependency>
        <!--ydsz-common-exception-->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-exception</artifactId>
        </dependency>
        <!--ydsz-common-util-->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-util</artifactId>
        </dependency>
        <!--
            jackson-annotations（optional，编译期可见，运行期不强制）
            由于 optional 依赖不传递的规则，ydsz-common-json 中的 jackson-annotations(optional)
            无法传递到本模块。但本模块依赖的 spring-boot-actuator / spring-boot-health 的 class
            文件字节码中带有 @JsonInclude 等 Jackson 注解，javac 编译时需要解析这些注解的
            枚举常量，否则会报"未知的枚举常量 JsonInclude.Include.NON_EMPTY"警告。
            声明为 optional 即可消除警告，又不强制本模块使用者引入 Jackson 核心。
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- mybatis-plus (Spring Boot 4.x) -->
        <dependency>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
            <groupId>com.baomidou</groupId>
        </dependency>
        <!-- jsqlparser -->
        <dependency>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <groupId>com.baomidou</groupId>
        </dependency>
        <!-- 动态数据源 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>dynamic-datasource-spring-boot3-starter</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- servlet API 依赖，解决 RequestHolder 间接依赖 -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- spring-web 支持，用于异常处理 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <optional>true</optional>
        </dependency>
        <!--aop-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>
        <!--spring-boot-configuration-processor-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- mysql (开发环境常用) -->
        <dependency>
            <artifactId>mysql-connector-j</artifactId>
            <groupId>com.mysql</groupId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <!-- postgresql (生产环境主选) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <!--
            以下数据库驱动已移除（如需使用，请在业务模块 pom.xml 中自行引入）：
            - Oracle (ojdbc11 + orai18n)：许可证合规风险
            - SQL Server (mssql-jdbc)：非主流选择
            - DB2 (jcc)：许可证合规风险且社区活跃度低
        -->
        <!--slf4j-->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- micrometer -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>
        <!-- resilience4j 熔断器（数据库熔断，按数据源分桶） -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-circuitbreaker</artifactId>
        </dependency>
        <!-- resilience4j Micrometer 指标（熔断状态可观测） -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-micrometer</artifactId>
        </dependency>
        <!-- ydsz-common-cache（统一本地缓存框架，替代 Caffeine） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-cache</artifactId>
        </dependency>
        <!-- spring-boot-actuator (optional for HealthIndicator) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-actuator</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- spring-boot-health (Spring Boot 4.x: health classes moved from actuator to health module) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-health</artifactId>
            <optional>true</optional>
        </dependency>
        <!--lombok-->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!--ydsz-common-json-->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-json</artifactId>
        </dependency>
        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>


</project>
