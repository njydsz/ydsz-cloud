<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.njydsz</groupId>
    <artifactId>ydsz-common</artifactId>
    <version>26.09.01-SNAPSHOT</version>
  </parent>
  <artifactId>ydsz-common-cache</artifactId>
  <name>ydsz-common-cache</name>
  <description>YDSZ Common Cache - 多策略本地缓存框架（零第三方依赖核心，可选 Spring/Micrometer 集成）</description>

  <properties>
    <!-- L1 工具层模块标识：激活 purity 检查 -->
    <l1.module.skip>false</l1.module.skip>
  </properties>

    <dependencies>
    <!-- SLF4J API（日志门面，L1 模块直接声明，避免内部模块耦合） -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <!-- Spring Context（Cache 接口） -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- Spring Boot Autoconfigure -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- Spring Boot Configuration Processor -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- Micrometer 可观测性（可选） -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
      <scope>provided</scope>
      <optional>true</optional>
    </dependency>
    <!--
        Jackson annotations（provided，编译期可见，运行期不强制）
        spring-boot 4.x 的 spring-boot-health / spring-boot-actuator / spring-web 7.0.x
        的 class 文件字节码中带有 @JsonInclude 等 Jackson 注解。声明为 provided 即可在
        编译期消除 "未知的枚举常量 com.fasterxml.jackson.annotation.JsonInclude.Include.NON_EMPTY"
        警告，又不强制本模块使用者必须引入 Jackson 核心。
    -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
      <scope>provided</scope>
      <optional>true</optional>
    </dependency>
    <!-- Spring Boot Health（HealthIndicator，Spring Boot 4.x 独立模块） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-health</artifactId>
      <scope>provided</scope>
      <optional>true</optional>
    </dependency>
    <!-- Spring Boot Actuator（自定义端点，可选） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-actuator</artifactId>
      <scope>provided</scope>
      <optional>true</optional>
    </dependency>
    <!-- Spring Boot Actuator AutoConfigure（条件注册端点） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-actuator-autoconfigure</artifactId>
      <scope>provided</scope>
      <optional>true</optional>
    </dependency>
    <!--
        注意：ydsz-common-cache 不依赖 ydsz-common-tenant。
        CacheConstants 中提及的 TenantContextHolder 仅在 Javadoc 注释中，无编译期耦合。
        若引入 tenant 会形成 jdbc → cache → tenant → jdbc 循环依赖，违反 YDIZ-ARCH-001。
    -->
  </dependencies>

</project>
