<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.njydsz</groupId>
        <artifactId>ydsz-common</artifactId>
        <version>26.10.01-SNAPSHOT</version>
    </parent>

        <!-- L1 工具模块层：激活 purity 检查，禁止依赖 L2+ 内部模块 -->
    <properties>
        <l1.module.skip>false</l1.module.skip>
        <easyexcel.version>4.0.3</easyexcel.version>
        <poi.version>5.3.0</poi.version>
    </properties>

    <artifactId>ydsz-common-excel</artifactId>
    <name>ydsz-common-excel</name>
    <description>高性能 Excel 处理模块 — 纯手工 OOXML 字节流引擎（零 POI 依赖）、MethodHandle 字段访问优化、公式注入防护</description>

    <dependencies>
        <!-- ==================== 同层模块依赖 ==================== -->
        <!-- ydsz-common-util（L1 工具层，ExcelI18nHelper 委托 MessageUtils） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-util</artifactId>
        </dependency>

        <!-- ==================== 第三方依赖 ==================== -->
        <!-- 零 POI 依赖：纯手工 OOXML 字节流读写 -->

        <!-- Jakarta Bean Validation API（JSR-303 标准校验） -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Jackson Annotations（@JsonInclude 等——Spring Boot autoconfigure 编译期引用，需显式声明以消除 'unknown enum constant' 告警） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- SLF4J -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Micrometer（可观测性指标） -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Boot 自动配置（可选） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Spring Boot Actuator（Spring Boot 4.x: 端点 + 健康检查支持） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-actuator</artifactId>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
        <!-- Spring Boot Actuator AutoConfigure（Spring Boot 4.x: 条件装配支持） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-actuator-autoconfigure</artifactId>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
        <!-- spring-boot-health (Spring Boot 4.x: health classes moved from actuator to health module) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-health</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Web（可选，Web 下载支持） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
          ydsz-common-thread / ydsz-common-exception 已移除（26.11.06）：
          ydsz-common-excel 属 L1 工具层，按云顶编码规范 §22.2「L1 工具纯度」禁止依赖 L2+ 内部模块。
          AsyncReadBridge 改用 JDK 21 Thread.ofVirtual()（与原虚拟线程语义一致），
          ExcelReadResult 改用本模块自带的 ExcelOperationException，不再抛 BusinessException。
          异常语义变化：Excel 读取失败由 BusinessException 改为 ExcelOperationException（同为
          unchecked，全局异常处理器已能处理），调用方若依赖具体异常类型请做适配。
        -->

        <!-- JUnit 5 (test scope)，版本由根 POM / Spring Boot BOM 统一管控 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- ArchUnit：L1 工具纯度守护（YDIZ-ARCH-L1-PURITY 自动化验证） -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ==================== Benchmark 竞品依赖（仅 test scope） ==================== -->
        <!-- EasyExcel 3.x for competitive benchmark -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>easyexcel</artifactId>
            <version>${easyexcel.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Apache POI — explicit SXSSF/XSSF benchmark baseline -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- exec-maven-plugin for running benchmark Main classes during development -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
            </plugin>
        </plugins>
    </build>
</project>
