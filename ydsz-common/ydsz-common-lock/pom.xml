<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <artifactId>ydsz-common-lock</artifactId>
    <name>ydsz-common-lock</name>
    <description>ydsz-common-lock</description>

    <parent>
        <groupId>com.njydsz</groupId>
        <artifactId>ydsz-common</artifactId>
        <version>26.09.01-SNAPSHOT</version>
    </parent>

    <dependencies>
        <!--aop-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>
        <!--exception-->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-exception</artifactId>
        </dependency>
        <!--core（直接依赖，避免通过 ydsz-common-exception 间接引入）-->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-core</artifactId>
        </dependency>
        <!--util（RequestContextUtils 等工具类）-->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-util</artifactId>
        </dependency>
        <!--lombok-->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!--configuration processor for IDE auto-completion-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <!--actuator-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-actuator</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- spring-boot-health (Spring Boot 4.x: health classes moved from actuator to health module) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-health</artifactId>
            <optional>true</optional>
        </dependency>
        <!--micrometer-->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
            <optional>true</optional>
        </dependency>
        <!--
            Jackson annotations（optional，编译期可见，运行期不强制）
            spring-boot 4.x 的 spring-boot-health / spring-boot-actuator / spring-web 7.0.x
            的 class 文件字节码中带有 @JsonInclude 等 Jackson 注解。声明为 optional 即可在
            编译期消除 "未知的枚举常量 com.fasterxml.jackson.annotation.JsonInclude.Include.NON_EMPTY"
            警告，又不强制本模块使用者必须引入 Jackson 核心。
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <optional>true</optional>
        </dependency>
        <!--ydsz-common-cache（本地缓存框架，替代 Caffeine）-->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-cache</artifactId>
        </dependency>
        <!--
            web（optional）
            RepeatSubmitTokenController 提供 REST 端点，编译期需要 spring-web 的 @RestController/@RequestMapping。
            标记 optional 避免强制所有使用方（如纯后台批处理服务）引入 web 栈。
            消费方若需启用 Token 接口，需自行声明 spring-boot-starter-web。
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- springdoc OpenAPI（optional，编译期可见 @Tag/@Operation/@Parameter） -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
            <optional>true</optional>
        </dependency>
        <!--
            jakarta.servlet-api（optional）
            RepeatSubmitAspect / RepeatSubmitTokenController 引用 HttpServletRequest / @RestController。
            标记 optional 避免强制非 web 场景下的使用方引入 servlet API。
        -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!--
            ydsz-common-auth 依赖已移除（C2 修复：循环依赖）。
            RepeatSubmitTokenService 不再依赖 AuthContext，
            改为通过 CurrentUserIdResolver SPI 接口获取用户 ID。
        -->
        <!--ydsz-common-redis-->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-redis</artifactId>
        </dependency>
        <!--ydsz-common-json-->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-json</artifactId>
        </dependency>

    </dependencies>

</project>
