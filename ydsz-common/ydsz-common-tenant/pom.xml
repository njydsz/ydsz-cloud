<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <artifactId>ydsz-common-tenant</artifactId>
    <name>ydsz-common-tenant</name>
    <description>多租户隔离公共模块（可选引入，数据库无关）</description>

    <parent>
        <groupId>com.njydsz</groupId>
        <artifactId>ydsz-common</artifactId>
        <version>26.09.01-SNAPSHOT</version>
    </parent>

    <dependencies>
        <!-- common-core: TTL ThreadLocal -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-core</artifactId>
        </dependency>
        <!-- common-jdbc: InnerInterceptor SPI + MpBaseEntity + JSqlParser -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-jdbc</artifactId>
        </dependency>
        <!-- common-util: 通用工具 -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-util</artifactId>
        </dependency>
        <!-- common-domain: TenantAware interface -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-domain</artifactId>
        </dependency>

        <!--
            可选依赖：OpenFeign feign-core（TenantContextFeignInterceptor 实现 feign.RequestInterceptor）。
            使用第三方库而非 ydsz-common-feign 模块，消除 L4 → L5 反向依赖。
        -->
        <dependency>
            <groupId>io.github.openfeign</groupId>
            <artifactId>feign-core</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 可选依赖：TaskDecorator 异步传播 -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-thread</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 可选依赖：Web Filter（jakarta.servlet.Filter） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 可选依赖：Health Indicator（Spring Boot 4.x 拆分至 spring-boot-health） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-health</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- micrometer-core（指标计量，原由 ydsz-common-core 传递） -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>
        <!-- ydsz-common-cache（统一本地缓存框架，替代 Caffeine） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-cache</artifactId>
        </dependency>
        <!-- ydzs-common-redis -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-redis</artifactId>
        </dependency>
    </dependencies>

</project>
