<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <artifactId>ydsz-common-file</artifactId>
    <name>ydsz-common-file</name>
    <description>ydsz-common-file</description>

    <parent>
        <groupId>com.njydsz</groupId>
        <artifactId>ydsz-common</artifactId>
        <version>26.10.01-SNAPSHOT</version>
    </parent>

    <!-- B1-3 覆盖率棘轮（2026-10-27 实测：mvn -o verify -pl ydsz-common/ydsz-common-file →
         jacoco.xml BUNDLE LINE 34/4719 = 0.0072，BRANCH 19/1536 = 0.0124，按实测向下取整钉死地板）。
         本模块此前零测试：根默认 0.01 直接判红（"lines covered ratio is 0.00, expected 0.01"），
         说明地板此前是靠"没有测量"而非"达标"维持的。0.7% 是在**记录债**而非认可债：
         模块内 58 个类只有 FileOps 被测，存储 SDK 适配层仍未覆盖。
         覆盖率上升后应同步上调本值锁定成果，只可升不可降。 -->
    <properties>
        <jacoco.line.threshold>0.007</jacoco.line.threshold>
        <jacoco.branch.threshold>0.012</jacoco.branch.threshold>
    </properties>

    <dependencies>
        <!-- spring -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-actuator</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Micrometer for FileMetrics (transitive via actuator, explicit for compile-time resolution) -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- spring-boot-health (Spring Boot 4.x: health classes moved from actuator to health module) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-health</artifactId>
            <optional>true</optional>
        </dependency>
        <!--servlet-->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--ydsz-common-core-->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-core</artifactId>
        </dependency>

        <!--全局工具-->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-util</artifactId>
        </dependency>

        <!--全局自定义异常-->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-exception</artifactId>
        </dependency>

        <!-- Redis (optional, for distributed multipart context and checkpoint) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <optional>true</optional>
        </dependency>


        <!-- ydsz-common-lock (optional, @DistributedScheduled 保护定时清理任务) -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-lock</artifactId>
            <optional>true</optional>
        </dependency>

        <!--获取文件类型 - Tika 作为默认实现-->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
        </dependency>

        <!-- aliyun-java-sdk -->
        <dependency>
            <groupId>com.aliyun.oss</groupId>
            <artifactId>aliyun-sdk-oss</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Minio-java-sdk -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- aws-java-sdk -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>auth</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>com.qiniu</groupId>
            <artifactId>qiniu-java-sdk</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 腾讯云-cos-sdk -->
        <dependency>
            <groupId>com.qcloud</groupId>
            <artifactId>cos_api</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 华为云-obs-sdk -->
        <dependency>
            <groupId>com.huaweicloud</groupId>
            <artifactId>esdk-obs-java</artifactId>
            <optional>true</optional>
        </dependency>
        <!--lombok-->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Spring Boot Configuration Processor -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <!--ydsz-common-redis-->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-redis</artifactId>
        </dependency>
        <!--ydsz-common-json-->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-json</artifactId>
        </dependency>

        <!-- ydsz-common-thread (optional, for managed thread pools - see 云顶编码规范 15.4 节) -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-thread</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 单元测试（版本由父 pom dependencyManagement 管理）。
             本模块的 FileOps.sanitizeFileName 是 AGENTS.md SOP-6 规定的全平台上传净化入口，
             此前零测试：安全属性从未被验证，且实测超长后缀会抛 StringIndexOutOfBoundsException。 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
