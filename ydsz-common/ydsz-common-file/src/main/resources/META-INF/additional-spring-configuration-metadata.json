{
  "properties": [
    {
      "name": "ydsz.file.enabled",
      "type": "java.lang.Boolean",
      "description": "Enable file storage module.",
      "defaultValue": true
    },
    {
      "name": "ydsz.file.type",
      "type": "java.lang.String",
      "description": "Storage type: local, minio, s3, oss, cos, obs, qiniu."
    },
    {
      "name": "ydsz.file.endpoint",
      "type": "java.lang.String",
      "description": "Storage endpoint URL."
    },
    {
      "name": "ydsz.file.access-key",
      "type": "java.lang.String",
      "description": "Storage access key."
    },
    {
      "name": "ydsz.file.secret-key",
      "type": "java.lang.String",
      "description": "Storage secret key."
    },
    {
      "name": "ydsz.file.bucket",
      "type": "java.lang.String",
      "description": "Default bucket name."
    },
    {
      "name": "ydsz.file.domain",
      "type": "java.lang.String",
      "description": "Custom domain for public access."
    },
    {
      "name": "ydsz.file.max-file-size",
      "type": "java.lang.Long",
      "description": "Max file size in bytes (0 = unlimited).",
      "defaultValue": 104857600
    },
    {
      "name": "ydsz.file.retry-count",
      "type": "java.lang.Integer",
      "description": "Storage operation retry count.",
      "defaultValue": 3
    },
    {
      "name": "ydsz.file.check-magic-number",
      "type": "java.lang.Boolean",
      "description": "Enable magic number file type validation.",
      "defaultValue": false
    },
    {
      "name": "ydsz.file.lifecycle.enabled",
      "type": "java.lang.Boolean",
      "description": "Enable file lifecycle management.",
      "defaultValue": false
    },
    {
      "name": "ydsz.file.lifecycle.cron",
      "type": "java.lang.String",
      "description": "Lifecycle cleanup cron expression.",
      "defaultValue": "0 0 2 * * ?"
    },
    {
      "name": "ydsz.file.upload.chunk-md5-check",
      "type": "java.lang.Boolean",
      "description": "Enable chunk MD5 verification.",
      "defaultValue": false
    }
  ]
}
