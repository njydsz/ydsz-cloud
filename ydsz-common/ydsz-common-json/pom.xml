<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.njydsz</groupId>
        <artifactId>ydsz-common</artifactId>
        <version>26.09.01-SNAPSHOT</version>
    </parent>

    <artifactId>ydsz-common-json</artifactId>
    <packaging>jar</packaging>
    <name>ydsz-common-json</name>
    <description>YDSZ 公共依赖 - 高性能 JSON 序列化/反序列化引擎（YdszJson，零外部 JSON 库依赖）</description>

    <properties>
        <!-- L1 工具层模块标识：激活 purity 检查 -->
        <l1.module.skip>false</l1.module.skip>
    </properties>

    <dependencies>
        <!-- Lombok（父 POM 已管理版本和 annotation processor） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- SLF4J（可选） -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Boot AutoConfigure -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Spring Boot Configuration Processor -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Web（HTTP 消息转换器集成） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            Jackson annotations（optional，编译期可见，运行期不强制）
            spring-boot 4.x 的 spring-boot-health / spring-boot-actuator / spring-web 7.0.x
            的 class 文件字节码中带有 @JsonInclude 等 Jackson 注解。本模块刻意不强制依赖
            Jackson 引擎（用 Ydsz YdszJson 替代），但需要 Jackson annotations jar 提供
            注解 class 文件供 javac 在读取这些依赖 class 时解析，否则会持续报
            "未知的枚举常量 com.fasterxml.jackson.annotation.JsonInclude.Include.NON_EMPTY"
            警告。声明为 optional 即可在编译期消除警告，又不强制本模块使用者必须引入 Jackson 核心。
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Jakarta Annotation -->
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Jakarta Validation（可选，用于 @Validated 配置校验） -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <optional>true</optional>
        </dependency>

    </dependencies>

</project>
