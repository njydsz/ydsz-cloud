<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.njydsz</groupId>
        <artifactId>ydsz-common</artifactId>
        <version>26.10.01-SNAPSHOT</version>
    </parent>

    <artifactId>ydsz-common-json</artifactId>
    <packaging>jar</packaging>
    <name>ydsz-common-json</name>
    <description>YDSZ 公共依赖 - 高性能 JSON 序列化/反序列化引擎（YdszJson，零外部 JSON 库依赖）</description>

    <properties>
        <!-- L1 工具层模块标识：激活 purity 检查 -->
        <l1.module.skip>false</l1.module.skip>
        <!-- B1-2 覆盖率棘轮（2026-10-27 实测：mvn -o verify -pl ydsz-common/ydsz-common-json）。
             本模块此前零测试，jacoco:check 因无 exec 数据整体空转——"没跑测试"被读成"门禁通过"。
             值 = BUNDLE 实测向下取整到 0.1%（LINE 725/8301=0.0873、BRANCH 254/5531=0.0459），
             较根 pom 起步线（0.01/0.005）各收紧 8 倍；全平台唯一 JSON 出入口只有 8.7% 行覆盖，
             这个低值是在记录现状而非认可现状，后续补测应继续上调。 -->
        <jacoco.line.threshold>0.08</jacoco.line.threshold>
        <jacoco.branch.threshold>0.04</jacoco.branch.threshold>
    </properties>

    <dependencies>
        <!-- Lombok（父 POM 已管理版本和 annotation processor） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- SLF4J（可选） -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Boot AutoConfigure -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Spring Boot Configuration Processor -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Web（HTTP 消息转换器集成） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            Jackson annotations（compile 作用域，传递到下游）
            本模块的 YdszJson / JsonNode / JsonMergePatch 等编译后 class 的字节码中引用 @JsonInclude(NON_EMPTY)
            等 Jackson 注解常量（用于与 Spring Boot 自动检测机制互操作，运行时由 YdszJson 引擎处理，不依赖
            Jackson 核心）。

            作用域决策：
            - 不能 optional：optional 依赖不传递，下游模块编译本模块的类时 javac 无法解析 JsonInclude$Include
              枚举常量，持续报"未知的枚举常量 com.fasterxml.jackson.annotation.JsonInclude.Include.NON_EMPTY"
              警告（参见 ydsz-common-config / ydsz-common-jdbc / ydsz-common-audit 等编译输出）。
            - compile（默认）：编译期传递给所有下游，确保 javac 能解析注解字节码；运行期仍为 annotations
              零运行时开销（本模块 100% 使用 YdszJson，不读取 Jackson 核心）。

            本模块的核心定位（"零外部 JSON 库依赖"）不变：YdszJson 运行时零 Jackson 依赖，jackson-annotations
            仅作为编译期注解占位符存在。
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>

        <!-- Jakarta Annotation -->
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Jakarta Validation（可选，用于 @Validated 配置校验） -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试基座：本模块是平台唯一 JSON 出入口，此前零测试，解析器的 ThreadLocal
             复用缺陷只能靠单元测试在同一线程内复现（版本由父 pom dependencyManagement 管理） -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>
