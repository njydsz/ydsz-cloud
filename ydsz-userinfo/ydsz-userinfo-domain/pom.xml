<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.njydsz</groupId>
        <artifactId>ydsz-userinfo</artifactId>
        <version>26.09.01-SNAPSHOT</version>
    </parent>
    <artifactId>ydsz-userinfo-domain</artifactId>
    <name>ydsz-userinfo-domain</name>
    <description>Domain Layer - DTO/VO/Query/Enum</description>
    <dependencies>

        <!-- mybatis-plus-annotation: @TableName/@TableField（Domain Entity 使用 ORM 注解） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-annotation</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-core</artifactId>
        </dependency>
        <!-- ydsz-common-jdbc（MpBaseEntity 基类 + @TableName 等 MyBatis Plus 注解） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-exception</artifactId>
        </dependency>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-event</artifactId>
        </dependency>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-safe</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <!-- ydsz-common-json -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-json</artifactId>
        </dependency>
        <!-- ydsz-common-util（MessageUtils i18n 支持） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-util</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- ydsz-common-feign（UserInfoNameAssembler 实现 NameAssembler 接口 + NameAssemblerProperties 配置） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-feign</artifactId>
        </dependency>
        <!-- ydsz-common-redis（UserInfoNameAssembler L2 缓存 RedisStringOps） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-redis</artifactId>
        </dependency>
        <!-- ydsz-common-cache（UserInfoNameAssembler L1 本地缓存 Cache/CacheBuilder） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-cache</artifactId>
        </dependency>
        <!-- swagger-annotations-jakarta: @Schema 注解（RefreshRequest 等 DTO 使用） -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
        </dependency>
        <!-- MapStruct（Domain 层 Converter 使用 @Mapper 注解，provided scope 与各模块保持一致） -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- P1-5: common-excel（UserImportResultDTO 继承 ExcelImportResult 基类） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-excel</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
