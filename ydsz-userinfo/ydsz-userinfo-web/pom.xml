        <artifactId>ydsz-common-search</artifactId>
    </dependency>

    <!-- 显式声明：本模块源码直接使用该公共能力（原先仅经传递依赖获得，P1-5 整改） -->
    <dependency>
        <groupId>com.njydsz</groupId>
        <artifactId>ydsz-common-sentry</artifactId>
    </dependency>

    <!-- 显式声明：本模块源码直接使用该公共能力（原先仅经传递依赖获得，P1-5 整改） -->
    <dependency>
        <groupId>com.njydsz</groupId>
        <artifactId>ydsz-common-util</artifactId>
    </dependency>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-userinfo-server</artifactId>
        </dependency>
        <!-- userinfo-infra: Repository 实现 + MyBatis Mapper 注入 -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-userinfo-infra</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-web</artifactId>
        </dependency>
        <!-- ydsz-common-json: explicit declaration for direct usage of YdszJson in controllers/filters -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-json</artifactId>
        </dependency>
        <!-- ydsz-common-core: explicit declaration for direct usage (was transitive via common-web) -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bootstrap</artifactId>
        </dependency>
        <dependency>
