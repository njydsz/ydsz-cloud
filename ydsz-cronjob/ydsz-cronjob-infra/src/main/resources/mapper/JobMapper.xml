<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.njydsz.cronjob.infra.mapper.JobMapper">

    <resultMap id="BaseResultMap" type="com.njydsz.cronjob.infra.entity.job.Job">
        <id column="id" property="id"/>
        <result column="job_name" property="jobName"/>
        <result column="job_group" property="jobGroup"/>
        <result column="job_key" property="jobKey"/>
        <result column="handler" property="handler"/>
        <result column="cron_expression" property="cronExpression"/>
        <result column="schedule_type" property="scheduleType"/>
        <result column="fixed_rate_ms" property="fixedRateMs"/>
        <result column="fixed_delay_ms" property="fixedDelayMs"/>
        <result column="params_json" property="paramsJson"/>
        <result column="status" property="status"/>
        <result column="remark" property="remark"/>
        <result column="next_fire_time" property="nextFireTime"/>
        <result column="last_fire_time" property="lastFireTime"/>
        <result column="fire_count" property="fireCount"/>
        <result column="success_count" property="successCount"/>
        <result column="fail_count" property="failCount"/>
        <result column="lock_ttl_ms" property="lockTtlMs"/>
        <result column="timeout_ms" property="timeoutMs"/>
        <result column="misfire_policy" property="misfirePolicy"/>
        <result column="shard_total" property="shardTotal"/>
        <result column="timezone" property="timezone"/>
        <result column="cluster" property="cluster"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="created_by" property="createdBy"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_by" property="updatedBy"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, job_name, job_group, job_key, handler, cron_expression,
        schedule_type, fixed_rate_ms, fixed_delay_ms,
        params_json,
        status, remark, next_fire_time, last_fire_time, fire_count, success_count, fail_count,
        lock_ttl_ms, timeout_ms, misfire_policy, shard_total, timezone, cluster, tenant_id,
        created_by, created_at, updated_by, updated_at, deleted
    </sql>

    <select id="selectByJobKey" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM ydsz_job
        WHERE job_key = #{jobKey} AND deleted = 0
    </select>

    <select id="selectAllNormal" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM ydsz_job
        WHERE status = 'NORMAL' AND deleted = 0
    </select>

    <!-- P1-7: Leader 模式扫描待触发任务，FOR UPDATE SKIP LOCKED 抢占式行锁 -->
    <!-- P0-3: 按 priority 升序排序（priority 越小优先级越高），同优先级按 next_fire_time 升序 -->
    <!-- P1-2: 支持所有 schedule_type（CRON / FIXED_RATE / FIXED_DELAY），固定频率任务统一由 Leader 扫描驱动，具备故障转移能力 -->
    <select id="selectDueJobs" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM ydsz_job
        WHERE status = 'NORMAL'
          AND deleted = 0
          AND next_fire_time IS NOT NULL
          AND next_fire_time &lt;= #{now}
        ORDER BY COALESCE(priority, 5) ASC, next_fire_time ASC
        LIMIT #{limit}
        FOR UPDATE SKIP LOCKED
    </select>

    <!-- P0-2: 精准调度窗口内扫描，FOR UPDATE SKIP LOCKED 抢占式行锁 -->
    <!-- P0-3: 按 priority 升序排序（priority 越小优先级越高） -->
    <!-- P2-5: 支持 CRON + FIXED_RATE（秒级 fixed-rate 任务获得毫秒级预读触发，主扫描器兜底） -->
    <select id="selectDueJobsInWindow" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM ydsz_job
        WHERE status = 'NORMAL'
          AND deleted = 0
          AND schedule_type IN ('CRON', 'FIXED_RATE')
          AND next_fire_time IS NOT NULL
          AND next_fire_time &gt;= #{now}
          AND next_fire_time &lt;= #{windowEnd}
        ORDER BY COALESCE(priority, 5) ASC, next_fire_time ASC
        LIMIT #{limit}
        FOR UPDATE SKIP LOCKED
    </select>

    <!-- P1-7: CAS 推进 next_fire_time，防止 Leader 切换时重复派发 -->
    <update id="advanceNextFireTime">
        UPDATE ydsz_job
        SET next_fire_time = #{newNextFireTime},
            last_fire_time = #{lastFireTime},
            fire_count = fire_count + 1,
            updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id}
          AND deleted = 0
          AND next_fire_time = #{oldNextFireTime}
    </update>

    <update id="updateStats">
        UPDATE ydsz_job
        <set>
            <if test="lastFireTime != null">last_fire_time = #{lastFireTime},</if>
            <if test="nextFireTime != null">next_fire_time = #{nextFireTime},</if>
            <if test="fireCount != null">fire_count = fire_count + #{fireCount},</if>
            <if test="successCount != null">success_count = success_count + #{successCount},</if>
            <if test="failCount != null">fail_count = fail_count + #{failCount},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            updated_at = CURRENT_TIMESTAMP
        </set>
        WHERE id = #{id} AND deleted = 0
    </update>

</mapper>
