<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.njydsz</groupId>
        <artifactId>ydsz-cronjob</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>ydsz-cronjob-server</artifactId>
    <name>ydsz-cronjob-server</name>
    <description>DDD Module</description>
    <dependencies>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-cronjob-infra</artifactId>
        </dependency>
        <!-- App 端基座模块（移动端接口能力） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-cronjob-app</artifactId>
        </dependency>
        <!-- common-web 传递引入: common-base(→core/util/exception), common-auth, common-safe, common-redis -->
        <!-- common-jdbc 传递引入: common-domain -->
        <!-- P1-A1: 显式声明 common-auth（使用 @AuthApiPermission / AuthContextUtils 等能力） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-auth</artifactId>
        </dependency>
        <!-- ydsz-common-domain: explicit declaration for direct usage (JobHandler/DAG/JobContext etc., was transitive via common-jdbc) -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-domain</artifactId>
        </dependency>
        <!-- common-feign 传递引入: spring-cloud-starter-openfeign -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-lock</artifactId>
        </dependency>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-feign</artifactId>
        </dependency>
        <!-- P2-7: 直接依赖 common-socket 推送 WebSocket 消息（替代 Feign 中转 message 模块） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-socket</artifactId>
        </dependency>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-file</artifactId>
        </dependency>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-notify</artifactId>
        </dependency>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-queue</artifactId>
        </dependency>
        <!-- P0-2: 事务性 Outbox 事件模式 -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-event</artifactId>
        </dependency>
        <!-- P0-1: 统一线程池管理（替代手动 ThreadPoolExecutor 创建） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-thread</artifactId>
        </dependency>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-web</artifactId>
        </dependency>
        <!-- ydsz-common-core: explicit declaration for direct usage (was transitive via common-web) -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-core</artifactId>
        </dependency>
        <!-- P0-FIX: ThreadLocal 线程池传播（TtlRunnable 包装线程池任务） -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>transmittable-thread-local</artifactId>
        </dependency>
        <!-- P2-3: LMAX Disruptor（高性能无锁队列，用于日志输出） -->
        <dependency>
            <groupId>com.lmax</groupId>
            <artifactId>disruptor</artifactId>
        </dependency>

        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-excel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.groovy</groupId>
            <artifactId>groovy</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <!-- Redisson（RedissonLeaderElector 使用） -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
        </dependency>
        <!-- P0-1: 统一监控告警（Sentry SPI：ELK/Loki 日志推送 + 告警收敛 + SLA） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-sentry</artifactId>
        </dependency>
        <!-- P1-4: 搜索 Provider SPI（任务日志搜索） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-search</artifactId>
        </dependency>
        <!-- P2-5: 统一 Excel 导入导出（已在上方引入，去重） -->
        <!-- P0-2: 多租户隔离 -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-tenant</artifactId>
        </dependency>
        <!-- P2-1: 统一配置加密健康检查（ConfigEncryptHealthIndicator 自动激活） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-config</artifactId>
        </dependency>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-util</artifactId>
        </dependency>
        <!-- P1-A: 审计日志生命周期管理（LogCleaner 联动清理 sys_audit_log） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-audit</artifactId>
        </dependency>
        <!-- P2: JdbcHealthIndicator 自动注册（需要 actuator 在 classpath 上） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- ========== 测试依赖 ========== -->
        <!-- P1-1: Spring Boot Test Starter（包含 JUnit 5 + Mockito + AssertJ） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- P1-1: Testcontainers（PostgreSQL + Redis 集成测试） -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
