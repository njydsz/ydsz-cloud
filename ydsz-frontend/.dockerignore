# YDSZ 前端 .dockerignore
# 减少构建上下文体积，加速 docker build

# 依赖与构建产物
node_modules/
dist/
dist-ssr/
.vite/
.cache/
coverage/
.nyc_output/

# 测试产物
test-output/
test-results/
allure-results/
allure-report/
playwright-report/

# IDE
.idea/
.vscode/
*.iml

# 日志
*.log
logs/

# 临时文件
*.tmp
*.bak
.cache/
.tmp/

# Git
.git/
.gitignore
.husky/

# 系统文件
.DS_Store
Thumbs.db

# 敏感信息
.env
.env.local
.env.*.local

# 文档（构建不需要）
*.md
