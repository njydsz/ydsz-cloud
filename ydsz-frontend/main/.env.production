VITE_BASE=/

# 接口地址（生产环境通过 Gateway 统一路由）
VITE_GLOB_API_URL=/api

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=gzip,brotli

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=history

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true

# 微前端预加载应用清单（逗号分隔），未配置时回退到 userinfo-web,project-web
# VITE_PREFETCH_APPS=userinfo-web,project-web,system-web
