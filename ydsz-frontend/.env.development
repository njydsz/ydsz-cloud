# 开发环境配置
NODE_ENV=development
VITE_APP_TITLE=YDSZ 运营管理系统
VITE_API_BASE_URL=http://localhost:9000/api/v1
VITE_UPLOAD_URL=http://localhost:9000/upload
# P1 批次 20: 独立开发 mock 开关
# 设为 true 时, 前端直接走 viteMockPlugin, 不依赖后端
# 设为 false 时, 请求经 proxy 转发到 VITE_API_BASE_URL
VITE_USE_MOCK=true
VITE_MOCK_DELAY=200
VITE_MOCK_VERBOSE=false
VITE_ROUTER_MODE=hash
VITE_TOKEN_KEY=ydsz_token
VITE_REFRESH_TOKEN_KEY=ydsz_refresh_token
# P2-6: 开发环境关闭 CDN，第三方库走 node_modules 本地加载（保证 HMR 与断网开发体验）
VITE_CDN_ENABLED=false
