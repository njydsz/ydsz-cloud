{
  "name": "ydsz-frontend-monorepo",
  "version": "1.0.0",
  "private": true,
  "keywords": [
    "monorepo",
    "turbo",
    "ydsz",
    "ydsz pmis",
    "vue",
    "vue3",
    "element-plus",
    "qiankun",
    "micro-frontend"
  ],
  "description": "YDSZ PMIS 前端微应用 Monorepo — 基于 Qiankun + Vue 3 + Element Plus",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 turbo build",
    "build:analyze": "turbo build:analyze",
    "build:main": "pnpm run build --filter=@ydsz/main-web",
    "build:user": "pnpm run build --filter=@ydsz/user-center-web",
    "build:system": "pnpm run build --filter=@ydsz/system-admin-web",
    "build:project": "pnpm run build --filter=@ydsz/project-mgmt-web",
    "build:message": "pnpm run build --filter=@ydsz/message-center-web",
    "build:cronjob": "pnpm run build --filter=@ydsz/cronjob-admin-web",
    "build:workflow": "pnpm run build --filter=@ydsz/workflow-designer-web",
    "build:wiki": "pnpm run build --filter=@ydsz/wiki-drive-web",
    "build:rule": "pnpm run build --filter=@ydsz/rule-engine-web",
    "build:agent": "pnpm run build --filter=@ydsz/ai-assistant-web",
    "check": "pnpm run check:circular && pnpm run check:dep && pnpm run check:type && pnpm check:cspell",
    "check:circular": "vsh check-circular",
    "check:cspell": "cspell lint **/*.ts **/README.md --no-progress",
    "check:dep": "vsh check-dep",
    "check:type": "turbo run typecheck",
    "clean": "node ./bash/clean.mjs",
    "commit": "czg",
    "dev": "turbo-run dev",
    "dev:main": "pnpm -F @ydsz/main-web run dev",
    "dev:user": "pnpm -F @ydsz/user-center-web run dev",
    "dev:system": "pnpm -F @ydsz/system-admin-web run dev",
    "dev:project": "pnpm -F @ydsz/project-mgmt-web run dev",
    "dev:message": "pnpm -F @ydsz/message-center-web run dev",
    "dev:cronjob": "pnpm -F @ydsz/cronjob-admin-web run dev",
    "dev:workflow": "pnpm -F @ydsz/workflow-designer-web run dev",
    "dev:wiki": "pnpm -F @ydsz/wiki-drive-web run dev",
    "dev:rule": "pnpm -F @ydsz/rule-engine-web run dev",
    "dev:agent": "pnpm -F @ydsz/ai-assistant-web run dev",
    "dev:mock": "pnpm -F @ydsz/mock-api run dev",
    "format": "vsh lint --format",
    "lint": "vsh lint",
    "postinstall": "pnpm -r run stub --if-present",
    "preinstall": "npx only-allow pnpm",
    "preview": "turbo-run preview",
    "publint": "vsh publint",
    "reinstall": "pnpm clean --del-lock && pnpm install",
    "test:unit": "vitest run --dom",
    "test:e2e": "turbo run test:e2e",
    "update:deps": "npx taze -r -w"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@playwright/test": "catalog:",
    "@ydsz/commitlint-config": "workspace:*",
    "@ydsz/eslint-config": "workspace:*",
    "@ydsz/prettier-config": "workspace:*",
    "@ydsz/stylelint-config": "workspace:*",
    "@ydsz/tailwind-config": "workspace:*",
    "@ydsz/tsconfig": "workspace:*",
    "@ydsz/turbo-run": "workspace:*",
    "@ydsz/vite-config": "workspace:*",
    "@ydsz/vsh": "workspace:*",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "@vue/test-utils": "catalog:",
    "autoprefixer": "catalog:",
    "cross-env": "catalog:",
    "cspell": "catalog:",
    "happy-dom": "catalog:",
    "is-ci": "catalog:",
    "lefthook": "catalog:",
    "playwright": "catalog:",
    "qiankun": "catalog:",
    "rimraf": "catalog:",
    "tailwindcss": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vite": "catalog:",
    "vite-plugin-qiankun": "^1.0.15",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.12.0"
  },
  "packageManager": "pnpm@10.27.0+sha512.72d699da16b1179c14ba9e64dc71c9a40988cbdc65c264cb0e489db7de917f20dcf4d64d8723625f2969ba52d4b7e2a1170682d9ac2a5dcaeaab732b7e16f04a",
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint": "*"
      }
    },
    "overrides": {
      "@ast-grep/napi": "catalog:",
      "@ctrl/tinycolor": "catalog:",
      "clsx": "catalog:",
      "esbuild": "0.25.3",
      "pinia": "catalog:",
      "vue": "catalog:"
    },
    "neverBuiltDependencies": [
      "canvas",
      "node-gyp"
    ]
  }
}
