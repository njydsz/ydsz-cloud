# 生产环境配置
NODE_ENV=production
VITE_APP_TITLE=PMIS 运营管理系统
VITE_API_BASE_URL=/api/v1
VITE_UPLOAD_URL=/upload
# 生产环境强制关闭 mock
VITE_USE_MOCK=false
VITE_MOCK_DELAY=0
VITE_MOCK_VERBOSE=false
VITE_ROUTER_MODE=hash
VITE_TOKEN_KEY=pmis_token
VITE_REFRESH_TOKEN_KEY=pmis_refresh_token
# Sentry 错误监控 DSN（P0-5：生产环境强制启用）
# CI/CD 注入：在 GitHub Actions / K8s Secret 中设置 VITE_SENTRY_DSN
# 留空则跳过 Sentry 初始化（降级为 console.error）
# 获取 DSN：Sentry 控制台 → Settings → Client Keys → DSN
VITE_SENTRY_DSN=
# P2-6: CDN 外置开关（生产环境启用，第三方库走 CDN；设为 false 可临时关闭回退到本地打包）
VITE_CDN_ENABLED=true
