    "@ydsz/locales": "workspace:*",
    "@ydsz/types": "workspace:*",
    "@vueuse/core": "catalog:",
    "@vueuse/integrations": "catalog:",
    "json-bigint": "catalog:",
    "qrcode": "catalog:",
