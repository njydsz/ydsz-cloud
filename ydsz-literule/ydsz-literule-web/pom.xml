<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.njydsz</groupId>
        <artifactId>ydsz-literule</artifactId>
        <version>26.10.01-SNAPSHOT</version>
    </parent>
    <artifactId>ydsz-literule-web</artifactId>
    <name>ydsz-literule-web</name>
    <description>DDD Module</description>
    <dependencies>
    <!-- 显式声明：本模块源码直接使用该公共能力（原先仅经传递依赖获得，P1-5 整改） -->
    <dependency>
        <groupId>com.njydsz</groupId>
        <artifactId>ydsz-common-auth</artifactId>
    </dependency>

    <!-- 显式声明：本模块源码直接使用该公共能力（原先仅经传递依赖获得，P1-5 整改） -->
    <dependency>
        <groupId>com.njydsz</groupId>
        <artifactId>ydsz-common-base</artifactId>
    </dependency>

    <!-- 显式声明：本模块源码直接使用该公共能力（原先仅经传递依赖获得，P1-5 整改） -->
    <dependency>
        <groupId>com.njydsz</groupId>
        <artifactId>ydsz-common-domain</artifactId>
    </dependency>

    <!-- 显式声明：本模块源码直接使用该公共能力（原先仅经传递依赖获得，P1-5 整改） -->
    <dependency>
        <groupId>com.njydsz</groupId>
        <artifactId>ydsz-common-exception</artifactId>
    </dependency>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-literule-server</artifactId>
        </dependency>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-literule-domain</artifactId>
        </dependency>
        <!-- literule-infra: Repository 实现 + MyBatis Mapper 注入 -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-literule-infra</artifactId>
        </dependency>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-web</artifactId>
        </dependency>
        <!-- ydsz-common-core: explicit declaration for direct usage (was transitive via common-web) -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-core</artifactId>
        </dependency>

        <!-- P1-1: 安全模块（@RateLimit 限流注解） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-safe</artifactId>
        </dependency>
        <!-- common-lock: @Idempotent 注解（InternalApiController 幂等保护） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-lock</artifactId>
        </dependency>
        <!-- P1-1: 审计模块（@EnableYdszAudit + @Audit AOP 切面） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-audit</artifactId>
        </dependency>
        <!-- ydsz-common-feign：@EnableYdszFeign 注解 -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-feign</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bootstrap</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <!-- mapstruct: 已迁移至 infra 模块，web 模块通过 infra 传递依赖获取注解 -->
        <!-- ydsz-common-json -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-json</artifactId>
        </dependency>
        <!-- ydsz-common-excel：决策表 Excel 导入导出/模板下载（RuleDecisionTableController 直接使用 ExcelWebSupport） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-excel</artifactId>
        </dependency>

        <!-- 单元测试基础设施：MockMvc + Mockito + JUnit 5（云顶编码规范 §14.1） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Mockito JUnit Jupiter 扩展（@ExtendWith(MockitoExtension.class)） -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <configuration>
                            <classifier>exec</classifier>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
