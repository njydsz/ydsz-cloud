            <artifactId>remi-common-util</artifactId>
        </dependency>
        <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-common-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.remisoft</groupId>
