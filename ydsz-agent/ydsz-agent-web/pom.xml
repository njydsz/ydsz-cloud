<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.njydsz</groupId>
        <artifactId>ydsz-agent</artifactId>
        <version>26.10.01-SNAPSHOT</version>
    </parent>
    <artifactId>ydsz-agent-web</artifactId>
    <name>ydsz-agent-web</name>
    <description>Web Layer - REST API、SSE 流式输出、启动入口</description>
    <!-- B1-2 覆盖率棘轮（2026-10-26 实测：mvn -o test jacoco:report）。
         值 = 本模块 BUNDLE 实测覆盖率向下取整到 0.1%，只可上调不可下调（覆盖率上升后应同步上调锁定，下调即放行倒退）；
         根 pom 默认 0.01/0.005 是新模块起步线，真正的 PR 门禁是
         data/scripts/check-diff-coverage.py（增量行覆盖率 >= 40%，云顶编码规范 14.7）。 -->
    <properties>
        <jacoco.line.threshold>0.108</jacoco.line.threshold>
        <jacoco.branch.threshold>0.024</jacoco.branch.threshold>
    </properties>
    <dependencies>
    <!-- 显式声明：本模块源码直接使用该公共能力（原先仅经传递依赖获得，P1-5 整改） -->
    <dependency>
        <groupId>com.njydsz</groupId>
        <artifactId>ydsz-common-auth</artifactId>
    </dependency>

    <!-- 显式声明：本模块源码直接使用该公共能力（原先仅经传递依赖获得，P1-5 整改） -->
    <dependency>
        <groupId>com.njydsz</groupId>
        <artifactId>ydsz-common-base</artifactId>
    </dependency>

    <!-- 显式声明：本模块源码直接使用该公共能力（原先仅经传递依赖获得，P1-5 整改） -->
    <dependency>
        <groupId>com.njydsz</groupId>
        <artifactId>ydsz-common-feign</artifactId>
    </dependency>

    <!-- 显式声明：本模块源码直接使用该公共能力（原先仅经传递依赖获得，P1-5 整改） -->
    <dependency>
        <groupId>com.njydsz</groupId>
        <artifactId>ydsz-common-json</artifactId>
    </dependency>

    <!-- 显式声明：本模块源码直接使用该公共能力（原先仅经传递依赖获得，P1-5 整改） -->
    <dependency>
        <groupId>com.njydsz</groupId>
        <artifactId>ydsz-common-lock</artifactId>
    </dependency>

    <!-- 显式声明：本模块源码直接使用该公共能力（原先仅经传递依赖获得，P1-5 整改） -->
    <dependency>
        <groupId>com.njydsz</groupId>
        <artifactId>ydsz-common-redis</artifactId>
    </dependency>

    <!-- 显式声明：本模块源码直接使用该公共能力（原先仅经传递依赖获得，P1-5 整改） -->
    <dependency>
        <groupId>com.njydsz</groupId>
        <artifactId>ydsz-common-safe</artifactId>
    </dependency>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-agent-server</artifactId>
        </dependency>
        <!-- P1: DDD 分层——web 层负责依赖注入编排，依赖 infra 实现层 -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-agent-infra</artifactId>
        </dependency>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-web</artifactId>
        </dependency>
    <!-- ydsz-common-core: explicit declaration for direct usage (was transitive via common-web) -->
    <dependency>
        <groupId>com.njydsz</groupId>
        <artifactId>ydsz-common-core</artifactId>
    </dependency>
    <!-- P3-2: Excel 导出能力（AgentDefinition/Workflow/Trigger/TeamRun 列表流式导出，使用 ydsz-common-excel） -->
    <dependency>
        <groupId>com.njydsz</groupId>
        <artifactId>ydsz-common-excel</artifactId>
    </dependency>

        <!-- P1-1: 审计模块（@EnableYdszAudit + @Audit AOP 切面） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-audit</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bootstrap</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- spring-messaging + spring-websocket: common-socket WebSocketAutoConfiguration introspect 需要 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-messaging</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-websocket</artifactId>
        </dependency>

        <!-- 单元测试（MockMvc + Mockito） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Spring Cloud Contract Verifier（契约测试基类 BaseContractTest 依赖 RestAssuredMockMvc） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-contract-verifier</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <!-- B1-4 契约测试：把 src/test/resources/contracts/*.yml 生成成真正会跑的测试。
                 修复前只有 spring-cloud-starter-contract-verifier 依赖 + 一个从未被继承过的基类，
                 缺这个插件 → DSL 永远不会变成测试（"文件存在≠生效"）。
                 版本与本仓库 spring-cloud-dependencies 2025.1.2 对齐（私服/本地仓库均为 5.0.3）。 -->
            <plugin>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-contract-maven-plugin</artifactId>
                <version>5.0.3</version>
                <extensions>true</extensions>
                <configuration>
                    <baseClassForTests>com.njydsz.agent.web.contract.BaseContractTest</baseClassForTests>
                    <testFramework>JUNIT5</testFramework>
                    <testMode>MOCKMVC</testMode>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <configuration>
                            <classifier>exec</classifier>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
