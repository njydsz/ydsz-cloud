# PMIS 前端环境变量模板
# 复制为 .env.development / .env.production 后按需修改

# ============== 基础 ==============
NODE_ENV=development
VITE_APP_TITLE=PMIS 运营管理系统

# ============== 后端地址 ==============
# 开发环境后端基地址 (proxy 转发目标)
VITE_API_BASE_URL=http://localhost:9000
# API 前缀
VITE_API_PREFIX=
# 文件上传地址
VITE_UPLOAD_URL=http://localhost:9000/upload

# ============== Mock 独立开发 ==============
# 是否启用本地 mock (true: 拦截 /* 返回假数据; false: 走 proxy)
VITE_USE_MOCK=true
# 模拟网络延迟 (ms)
VITE_MOCK_DELAY=200
# 是否打印 mock 请求日志
VITE_MOCK_VERBOSE=false

# ============== 路由 ==============
# 路由模式: hash (默认, 静态部署友好) | history
VITE_ROUTER_MODE=hash

# ============== Token ==============
VITE_TOKEN_KEY=pmis_token
VITE_REFRESH_TOKEN_KEY=pmis_refresh_token

# ============== 可观测性 ==============
# Sentry DSN（生产环境错误/性能监控，留空则跳过 Sentry 初始化）
VITE_SENTRY_DSN=
# 应用发布版本号（建议 CI 注入 git short sha）
VITE_APP_VERSION=1.0.0
# 是否启用 Web Vitals 后端 beacon 上报（true: 通过 navigator.sendBeacon 上报到 /api/vitals）
VITE_ENABLE_VITALS_BEACON=false
