# E2E 测试环境配置 (批次 25 P1-6 Playwright)
#
# 启用 mock, 让 E2E 测试无需启动后端服务即可运行
# 1) pnpm exec playwright install chromium
# 2) pnpm run test:e2e
NODE_ENV=development
VITE_APP_TITLE=PMIS E2E

# 后端地址 (mock 模式下不会被使用, 仅作为兜底)
VITE_API_BASE_URL=http://localhost:9000
VITE_UPLOAD_URL=http://localhost:9000/upload

# 强制启用 mock 拦截 /*, 关闭延迟避免测试超时
VITE_USE_MOCK=true
VITE_MOCK_DELAY=0
VITE_MOCK_VERBOSE=true

# 路由: history 模式, 适配 playwright baseURL
VITE_ROUTER_MODE=history

# Token
VITE_TOKEN_KEY=pmis_token
VITE_REFRESH_TOKEN_KEY=pmis_refresh_token
