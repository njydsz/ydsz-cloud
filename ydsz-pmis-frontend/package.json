{
  "name": "ydsz-pmis-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "南京云顶 PMIS 运营管理系统 - 前端（Vue 3 + Vite + TypeScript）",
  "author": "PMIS Team <frontend@pmis.example.com>",
  "license": "UNLICENSED",
  "homepage": "https://pmis.example.com",
  "repository": {
    "type": "git",
    "url": "https://git.pmis.example.com/ydsz-pmis/ydsz-pmis-frontend.git"
  },
  "bugs": {
    "url": "https://jira.pmis.example.com"
  },
  "keywords": [
    "pmis",
    "vue3",
    "vite",
    "typescript",
    "element-plus",
    "bpmn",
    "lowcode",
    "form-designer"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:prod": "vue-tsc --noEmit && vite build --mode production",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.ts,.jsx,.tsx --fix",
    "lint:check": "eslint . --ext .vue,.js,.ts,.jsx,.tsx",
    "lint:scan-warnings": "node scripts/scan-any-warnings.mjs",
    "format": "prettier --write \"src/**/*.{vue,ts,js,scss,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --reporter=junit --outputFile=test-results.xml",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "i18n:check": "node scripts/check-i18n-coverage.mjs --threshold=20",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:smoke": "playwright test e2e/smoke.spec.ts",
    "test:e2e:report": "playwright show-report",
    "openapi:gen": "node scripts/openapi-gen.mjs",
    "openapi:gen:gateway": "node scripts/openapi-gen.mjs http://localhost:9000/v3/api-docs",
    "analyze": "ANALYZE=true vite build",
    "sentry:upload": "sentry-cli sourcemaps upload --org $SENTRY_ORG --project $SENTRY_PROJECT --release $npm_package_version dist/assets --strip-prefix dist/",
    "build:sentry": "npm run build:prod && npm run sentry:upload",
    "prepare": "husky install"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/basic-setup": "^0.20.0",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.4",
    "@element-plus/icons-vue": "^2.3.1",
    "@form-create/designer": "^3.5.0",
    "@form-create/element-ui": "^3.1.0",
    "@sentry/browser": "^8.42.0",
    "@sentry/vue": "^8.42.0",
    "@stomp/stompjs": "^7.0.0",
    "@vueuse/core": "^11.1.0",
    "axios": "^1.7.7",
    "bpmn-js": "^17.11.1",
    "codemirror": "^6.65.7",
    "dagre": "^0.8.5",
    "dayjs": "^1.11.13",
    "echarts": "^5.5.1",
    "element-plus": "^2.8.4",
    "lodash-es": "^4.17.21",
    "nprogress": "^0.2.0",
    "@types/nprogress": "^0.2.3",
    "pinia": "^2.2.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.12",
    "vue-grid-layout": "^3.0.0-beta1",
    "vue-i18n": "^10.0.8",
    "vue-router": "^4.4.5",
    "vxe-table": "^4.12.1",
    "web-vitals": "^4.2.4",
    "xe-utils": "^3.7.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@playwright/test": "^1.48.0",
    "@types/dagre": "^0.7.52",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.7.5",
    "@types/nprogress": "^0.2.3",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vitest/ui": "^2.1.9",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.28.0",
    "husky": "^9.1.6",
    "jsdom": "^29.1.1",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "rollup-plugin-visualizer": "^5.12.0",
    "sass": "^1.79.5",
    "unplugin-auto-import": "^0.18.3",
    "unplugin-vue-components": "^0.27.4",
    "vite": "^5.4.8",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-imagemin": "^0.6.1",
    "vite-plugin-pwa": "^0.20.5",
    "@vitest/coverage-v8": "^2.1.9",
    "@playwright/test": "^1.48.0",
    "vitest": "^2.1.9",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.1.6"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "lint-staged": {
    "*.{vue,ts,js,tsx,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,json,md}": [
      "prettier --write"
    ]
  }
}
