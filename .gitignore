# 项目根目录 .gitignore

# ========================
# Java / Maven
# ========================
target/
*.jar
*.war
*.ear
*.class
hs_err_pid*
replay_pid*
.mvn/wrapper/maven-wrapper.jar
**/dependency-reduced-pom.xml

# ========================
# Node / 前端
# ========================
node_modules/
dist/
dist-ssr/
*.local
.vite/
.cache/
.next/
.nuxt/
.parcel-cache/
coverage/
.nyc_output/

# ========================
# IDE
# ========================
.idea/
.vscode/
*.iml
*.iws
*.ipr
.settings/
.classpath
.project
nbproject/
nbbuild/
nbdist/

# ========================
# 系统文件
# ========================
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ========================
# 日志
# ========================
*.log
logs/
log/
*.log.*
*.pid

# ========================
# 临时文件
# ========================
*.tmp
*.bak
*.swp
*.swo
*~
.cache/
.tmp/
.temp/

# ========================
# 环境与敏感信息
# ========================
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.pfx
application-local.yml
application-local.properties
secrets.yml
secrets.yaml

# ========================
# 密钥与凭证
# ========================
**/jdbc.properties
**/credentials.json
**/service-account*.json
**/private.key
**/secret.key

# ========================
# 数据库
# ========================
*.db
*.sqlite
*.sqlite3
*.dump

# ========================
# 测试产物
# ========================
test-output/
test-results/
allure-results/
allure-report/
reports/
screenshots/

# ========================
# SonarQube
# ========================
.scannerwork/
sonar-project.properties

# ========================
# Docker
# ========================
docker-compose.override.yml

# ========================
# Nacos 自定义配置
# ========================
nacos-data/
nacos-logs/

# ========================
# 备份文件
# ========================
*.bak
*.backup
*.orig
