# =============================================================================
# YDSZ PMIS · 仓库根目录 .gitignore
# -----------------------------------------------------------------------------
# 作用:    集中管理本仓库所有需要忽略的临时文件、构建产物、IDE 缓存、敏感凭据
# 维护:    PMIS 研发部  ·  与代码同步更新
# 规范:    见 docs/standards/git-workflow.md（提交前自检）
#
# 忽略分组（按文件类别从重到轻）:
#   1. Java/Maven 构建产物（target/、*.jar、*.war、*.class）
#   2. Node.js/前端构建产物（node_modules/、dist/、.vite/、coverage/）
#   3. IDE 缓存（.idea/、.vscode/、*.iml、Eclipse/NetBeans 元数据）
#   4. 操作系统临时文件（.DS_Store、Thumbs.db、$RECYCLE.BIN/）
#   5. 日志与 PID（*.log、logs/、*.pid）
#   6. 临时文件（*.tmp、*.bak、*.swp、.cache/、.tmp/、.temp/）
#   7. 环境变量与敏感凭据（.env、*.pem、*.key、*.p12、secrets.yml）
#   8. 密钥与凭证（jdbc.properties、credentials.json、service-account*.json）
#   9. 数据库本地文件（*.db、*.sqlite、*.dump）
#  10. 测试产物（test-output/、allure-results/、screenshots/）
#  11. SonarQube 工作区（.scannerwork/）
#  12. Docker 本地覆盖（docker-compose.override.yml）
#  13. Nacos 本地数据（nacos-data/、nacos-logs/）
#  14. 备份文件（*.bak、*.backup、*.orig）
#
# 注意（必须保留入库、不被本文件忽略）:
#   - sonar-project.properties  团队共享配置（P0-3 规范要求）
#   - .env.example              环境变量模板
#   - .gitkeep                  空目录占位
#   - LICENSE / NOTICE          许可证与归属声明
# =============================================================================

# ========================
# Java / Maven
# ========================
target/
*.jar
*.war
*.ear
*.class
hs_err_pid*
replay_pid*
.mvn/wrapper/maven-wrapper.jar
**/dependency-reduced-pom.xml

# ========================
# Node / 前端
# ========================
node_modules/
dist/
dist-ssr/
*.local
.vite/
.vitepress/cache/
.vitepress/dist/
.cache/
.next/
.nuxt/
.parcel-cache/
coverage/
.nyc_output/

# ========================
# IDE
# ========================
.idea/
.vscode/
*.iml
*.iws
*.ipr
.settings/
.classpath
.project
nbproject/
nbbuild/
nbdist/

# ========================
# 系统文件
# ========================
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ========================
# 日志
# ========================
*.log
logs/
log/
*.log.*
*.pid

# ========================
# 临时文件
# ========================
*.tmp
*.bak
*.swp
*.swo
*~
.cache/
.tmp/
.temp/
# 前端 TypeScript / ESLint 编译错误诊断输出（临时文件，不应入库）
vue-tsc-errors.txt
lint-output.txt
lint-compact.txt

# ========================
# 环境与敏感信息
# ========================
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.pfx
application-local.yml
application-local.properties
secrets.yml
secrets.yaml

# ========================
# 密钥与凭证
# ========================
**/jdbc.properties
**/credentials.json
**/service-account*.json
**/private.key
**/secret.key

# ========================
# 数据库
# ========================
*.db
*.sqlite
*.sqlite3
*.dump

# ========================
# 测试产物
# ========================
test-output/
test-results/
allure-results/
allure-report/
reports/
screenshots/

# ========================
# SonarQube
# ========================
.scannerwork/
# 注：sonar-project.properties 为团队共享配置（P0-3），需纳入版本控制，故不再忽略

# ========================
# Docker
# ========================
docker-compose.override.yml

# ========================
# Nacos 自定义配置
# ========================
nacos-data/
nacos-logs/

# ========================
# 备份文件
# ========================
*.bak
*.backup
*.orig

# ========================
# 部署与运行产物
# ========================
# 后端服务启动日志与 PID（start-all.sh 生成）
.run-logs/
# 部署环境变量（deploy/.env 是真实密码，deploy/.env.example 提交）
deploy/.env
# PMIS 公共配置 Nacos 导入失败时的临时输出
deploy/common/nacos/.imported
