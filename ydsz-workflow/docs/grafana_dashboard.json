{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "ydsz-cloud Prometheus 数据源",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "核心指标概览",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 50 },
            { "color": "red", "value": 100 }
          ]},
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "title": "运行中实例数",
      "type": "stat",
      "targets": [
        { "expr": "sum(ydsz_flow_running_instances)", "legendFormat": "运行中" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 100 },
            { "color": "red", "value": 500 }
          ]},
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "title": "待办任务数",
      "type": "stat",
      "targets": [
        { "expr": "sum(ydsz_flow_pending_tasks)", "legendFormat": "待办" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 10 },
            { "color": "red", "value": 50 }
          ]},
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "title": "超期任务数",
      "type": "stat",
      "targets": [
        { "expr": "sum(ydsz_flow_overdue_tasks)", "legendFormat": "超期" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }
          ]},
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "title": "抄送未读数",
      "type": "stat",
      "targets": [
        { "expr": "sum(ydsz_flow_unread_cc)", "legendFormat": "未读" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "流程实例趋势",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "smooth"
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 10,
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "title": "实例创建 / 完成趋势",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(ydsz_flow_instance_created_total[5m]))",
          "legendFormat": "创建速率 (条/秒)"
        },
        {
          "expr": "sum(rate(ydsz_flow_instance_finished_total[5m]))",
          "legendFormat": "完成速率 (条/秒)"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 80 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 11,
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "list", "placement": "bottom" }
      },
      "title": "实例完成结果分布（按 flowCode）",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (flow_code, result) (increase(ydsz_flow_instance_finished_total[1h]))",
          "legendFormat": "{{flow_code}}-{{result}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "任务审批效率",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "id": 20,
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "list", "placement": "bottom" }
      },
      "title": "任务通过 / 驳回趋势",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(ydsz_flow_task_passed_total[5m]))",
          "legendFormat": "通过速率"
        },
        {
          "expr": "sum(rate(ydsz_flow_task_rejected_total[5m]))",
          "legendFormat": "驳回速率"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 15 },
      "id": 21,
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" }
      },
      "title": "节点驳回率 Top 5",
      "type": "barchart",
      "targets": [
        {
          "expr": "topk(5, sum by (flow_code, node_code) (rate(ydsz_flow_task_rejected_total[1h])) / sum by (flow_code, node_code) (rate(ydsz_flow_task_created_total[1h])))",
          "legendFormat": "{{flow_code}}-{{node_code}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 15 },
      "id": 22,
      "options": {
        "legend": { "calcs": ["mean"], "displayMode": "list", "placement": "bottom" }
      },
      "title": "任务处理耗时 P50/P95/P99",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(ydsz_flow_task_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(ydsz_flow_task_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(ydsz_flow_task_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P99"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 103,
      "title": "SLA / 超时 / 错误",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "id": 30,
      "title": "SLA 超时事件（按 action）",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (action) (rate(ydsz_flow_sla_timeout_total[5m]))",
          "legendFormat": "{{action}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "red", "value": 1 }
          ]}
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "id": 31,
      "title": "启动失败（按原因）",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (reason) (rate(ydsz_flow_start_error_total[5m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "id": 32,
      "title": "催办次数趋势",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(ydsz_flow_task_urged_total[5m]))",
          "legendFormat": "催办速率"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "id": 104,
      "title": "转办 / 委派 / 撤回",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 33 },
      "id": 40,
      "title": "任务转办趋势",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (flow_code) (rate(ydsz_flow_task_transferred_total[5m]))",
          "legendFormat": "{{flow_code}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 33 },
      "id": 41,
      "title": "任务委派趋势",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (flow_code) (rate(ydsz_flow_task_delegated_total[5m]))",
          "legendFormat": "{{flow_code}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 33 },
      "id": 42,
      "title": "撤回计数",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (flow_code) (rate(ydsz_flow_recall_total[5m]))",
          "legendFormat": "{{flow_code}}"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["ydsz", "workflow", "流程引擎"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(ydsz_flow_instance_created_total, flow_code)",
        "includeAll": true,
        "label": "流程编码",
        "multi": true,
        "name": "flow_code",
        "options": [],
        "query": {
          "query": "label_values(ydsz_flow_instance_created_total, flow_code)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "ydsz-workflow 流程引擎监控大盘",
  "uid": "ydsz-workflow-overview",
  "version": 1
}
