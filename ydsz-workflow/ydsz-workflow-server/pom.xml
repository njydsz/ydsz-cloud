<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.njydsz</groupId>
        <artifactId>ydsz-workflow</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>ydsz-workflow-server</artifactId>
    <name>ydsz-workflow-server</name>
    <description>DDD Module</description>
    <dependencies>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-workflow-domain</artifactId>
        </dependency>
        <!-- App 端基座模块（移动端接口能力） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-workflow-app</artifactId>
        </dependency>
        <!-- P2-3: 显式声明 common-util（多文件使用 FileTypeUtils/DateUtils 等工具类） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-util</artifactId>
        </dependency>
        <!-- common-web 传递引入: common-base(→core/util/exception), common-auth, common-safe, common-redis -->
        <!-- common-jdbc 传递引入: common-domain -->
        <!-- P1-A1: 显式声明 common-auth（使用 @AuthApiPermission / @DataScope / AuthContextUtils 等能力） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-auth</artifactId>
        </dependency>
        <!-- ydsz-common-domain: explicit declaration for direct usage (JobHandler/PageQuery, was transitive via common-jdbc) -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-domain</artifactId>
        </dependency>
        <!-- ydsz-cronjob-domain: JobHandler 抽象（FlowTimeout/ThirdPartyRetry/HistoryArchive JobHandler 由 cronjob 框架调度） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-cronjob-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- common-feign 传递引入: spring-cloud-starter-openfeign -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-jdbc</artifactId>
        </dependency>
                <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-lock</artifactId>
        </dependency>
        <!-- ydsz-common-cache（流程定义缓存，替代 Caffeine） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-feign</artifactId>
        </dependency>
        <!-- P2-7: 直接依赖 common-socket 推送 WebSocket 消息（替代 Feign 中转 message 模块） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-socket</artifactId>
        </dependency>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-audit</artifactId>
        </dependency>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-notify</artifactId>
        </dependency>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-queue</artifactId>
        </dependency>
        <!-- P0-1: 统一线程池管理（替代手动 ThreadPoolTaskExecutor 创建） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-thread</artifactId>
        </dependency>
        <!-- P1-4: 搜索 Provider SPI（流程实例搜索） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-search</artifactId>
        </dependency>
        <!-- P1-1: TCC 三方审批回调验证场景（ydsz-common-seata 验证） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-seata</artifactId>
        </dependency>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-web</artifactId>
        </dependency>
        <!-- ydsz-common-core: explicit declaration for direct usage (was transitive via common-web) -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-core</artifactId>
        </dependency>

        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-literule-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-userinfo-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.googlecode.aviator</groupId>
            <artifactId>aviator</artifactId>
            <version>5.4.3</version>
        </dependency>
        <!-- Micrometer Prometheus 注册器（FlowMetrics 指标暴露给 /actuator/prometheus） -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- dynamic-datasource（@DS 注解，common-jdbc 中标记为 optional） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>dynamic-datasource-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- P0-1: 统一监控告警（Sentry SPI：ELK/Loki 日志推送 + 告警收敛 + SLA） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-sentry</artifactId>
        </dependency>
        <!-- P0-2: 多租户隔离 -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-tenant</artifactId>
        </dependency>
        <!-- P2-1: 统一配置加密健康检查（ConfigEncryptHealthIndicator 自动激活） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-config</artifactId>
        </dependency>
        <!-- P2: JdbcHealthIndicator 自动注册（需要 actuator 在 classpath 上） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
</dependencies>
</project>
