<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.njydsz</groupId>
        <artifactId>ydsz-workflow</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>ydsz-workflow-engine</artifactId>
    <name>ydsz-workflow-engine</name>
    <description>Workflow Engine Core - BPMN 2.0 parser, expression evaluator, node ext utilities, listener system</description>
    <dependencies>
        <!-- 引擎依赖 domain 层获取 VO / Repository 接口定义 -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-workflow-domain</artifactId>
        </dependency>
        <!-- common-core: YdszResultCode / SysException -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-core</artifactId>
        </dependency>
        <!-- common-json: YdszJson -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-json</artifactId>
        </dependency>
        <!-- common-util: MapUtils / collection utilities -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-util</artifactId>
        </dependency>
        <!-- common-feign: NameAssembler -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-feign</artifactId>
        </dependency>
        <!-- common-cache: YdszCache / Cache (FlowDefinitionCacheService) -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-cache</artifactId>
        </dependency>
        <!-- common-lock: @YdszDistributedLock -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-lock</artifactId>
        </dependency>
        <!-- common-tenant: TenantContextHolder -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-tenant</artifactId>
        </dependency>
        <!-- common-thread: 线程池 (FlowUrgeLimiter) -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-thread</artifactId>
        </dependency>
        <!-- common-safe: SensitiveUtil (FlowSensitiveMasker) -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-safe</artifactId>
        </dependency>
        <!-- common-socket: WebSocket 推送 (FlowDefinitionCacheBroadcaster) -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-socket</artifactId>
        </dependency>
        <!-- common-notify: 通知推送 (FlowDefinitionCacheBroadcaster) -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-notify</artifactId>
        </dependency>
        <!-- common-queue: 消息队列 (FlowDefinitionCacheBroadcaster) -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-queue</artifactId>
        </dependency>
        <!-- common-config: 配置加密健康检查 -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-config</artifactId>
        </dependency>
        <!-- common-web: RestTemplate / WebClient (FlowServiceNodeExecutor) -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-web</artifactId>
        </dependency>
        <!-- Aviator 表达式引擎 -->
        <dependency>
            <groupId>com.googlecode.aviator</groupId>
            <artifactId>aviator</artifactId>
        </dependency>
        <!-- Spring Context (@Component / @RequiredArgsConstructor) -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <!-- Spring Web (RestTemplate / HttpHeaders) -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <!-- SLF4J API -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
