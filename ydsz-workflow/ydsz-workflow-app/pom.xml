<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.njydsz</groupId>
        <artifactId>ydsz-workflow</artifactId>
        <version>26.09.01-SNAPSHOT</version>
    </parent>
    <artifactId>ydsz-workflow-app</artifactId>
    <packaging>jar</packaging>
    <name>ydsz-workflow-app</name>
    <description>App 端接口层（移动端 API 入口，条件激活）</description>
    <dependencies>
        <!-- 平台基座（ConditionalOnPlatform / PlatformMode） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-base</artifactId>
        </dependency>
        <!-- Web 健康检查基类 -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-web</artifactId>
        </dependency>
        <!-- 本模块 API 契约 -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-workflow-api</artifactId>
        </dependency>
        <!-- 本模块领域层 -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-workflow-domain</artifactId>
        </dependency>
        <!--
          DDD 合规修正（云顶编码规范 §34.3 / §34.2.5.5）：
          app 端禁止依赖本模块 server 层（app 与 web 平行，仅通过 api/Feign 或共享 server 能力复用）。
          经核查 ydsz-workflow-app 源码无任何对 com.njydsz.workflow.server 的引用，故移除该依赖。
        -->
    </dependencies>
</project>
