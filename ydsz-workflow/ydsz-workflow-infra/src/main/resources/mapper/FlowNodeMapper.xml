<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.njydsz.workflow.infra.mapper.FlowNodeMapper">

    <resultMap id="BaseResultMap" type="com.njydsz.workflow.domain.entity.FlowNode">
        <id column="id" property="id"/>
        <result column="definition_id" property="definitionId"/>
        <result column="flow_code" property="flowCode"/>
        <result column="node_type" property="nodeType"/>
        <result column="node_code" property="nodeCode"/>
        <result column="node_name" property="nodeName"/>
        <result column="permission_flag" property="permissionFlag"/>
        <result column="skip_any_node" property="skipAnyNode"/>
        <result column="coordinate" property="coordinate"/>
        <result column="skip_list" property="skipList"/>
        <result column="ext" property="ext"/>
        <result column="status" property="status"/>
        <result column="created_by" property="createdBy"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_by" property="updatedBy"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="deleted" property="deleted"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="provider_trace_id" property="providerTraceId"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, definition_id, flow_code, node_type, node_code, node_name, permission_flag,
        skip_any_node, coordinate, skip_list, ext, status,
        created_by, created_at, updated_by, updated_at, deleted, tenant_id, provider_trace_id
    </sql>

    <select id="selectByDefinitionId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM ydsz_flow_node
        WHERE definition_id = #{definitionId}
          AND status = 'ENABLED'
          AND deleted = 0
        ORDER BY id ASC
    </select>

    <select id="selectByCode" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM ydsz_flow_node
        WHERE definition_id = #{definitionId}
          AND node_code = #{nodeCode}
          AND status = 'ENABLED'
          AND deleted = 0
        LIMIT 1
    </select>

    <select id="selectStartNode" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM ydsz_flow_node
        WHERE definition_id = #{definitionId}
          AND node_type = 0
          AND status = 'ENABLED'
          AND deleted = 0
        LIMIT 1
    </select>

    <select id="selectEndNodes" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM ydsz_flow_node
        WHERE definition_id = #{definitionId}
          AND node_type = 6
          AND status = 'ENABLED'
          AND deleted = 0
        ORDER BY id ASC
    </select>

    <delete id="deleteByDefinitionId">
        UPDATE ydsz_flow_node
        SET deleted = 1,
            updated_by = 0,
            updated_at = CURRENT_TIMESTAMP
        WHERE definition_id = #{definitionId}
          AND deleted = 0
    </delete>
</mapper>
