<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.njydsz.workflow.infra.mapper.FlowAuditLogMapper">

    <resultMap id="BaseResultMap" type="com.njydsz.workflow.infra.entity.FlowAuditLog">
        <id column="id" property="id"/>
        <result column="instance_id" property="instanceId"/>
        <result column="task_id" property="taskId"/>
        <result column="flow_code" property="flowCode"/>
        <result column="business_type" property="businessType"/>
        <result column="business_id" property="businessId"/>
        <result column="node_code" property="nodeCode"/>
        <result column="node_name" property="nodeName"/>
        <result column="action" property="action"/>
        <result column="operator_id" property="operatorId"/>
        <result column="operator_name" property="operatorName"/>
        <result column="target_id" property="targetId"/>
        <result column="target_name" property="targetName"/>
        <result column="comment" property="comment"/>
        <result column="comment_type" property="commentType"/>
        <result column="operated_at" property="operatedAt"/>
        <result column="status" property="status"/>
        <result column="created_by" property="createdBy"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_by" property="updatedBy"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="deleted" property="deleted"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="provider_trace_id" property="providerTraceId"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, instance_id, task_id, flow_code, business_type, business_id,
        node_code, node_name, action, operator_id, operator_name,
        target_id, target_name, comment, comment_type, operated_at, status,
        created_by, created_at, updated_by, updated_at, deleted, tenant_id, provider_trace_id
    </sql>

    <!-- 查某实例的全部审计日志（按时间正序） -->
    <select id="selectByInstanceId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM ydsz_flow_audit_log
        WHERE instance_id = #{instanceId}
          AND status = 'ENABLED'
          AND deleted = 0
        ORDER BY operated_at ASC, id ASC
    </select>

    <!-- 查某任务的操作记录 -->
    <select id="selectByTaskId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM ydsz_flow_audit_log
        WHERE task_id = #{taskId}
          AND status = 'ENABLED'
          AND deleted = 0
        ORDER BY operated_at ASC, id ASC
    </select>

    <!--
        查某操作人的审计日志（P1-8: 加签历史查询）
        P3: 强制时间范围，避免跨分区全表扫描（按月分区表，无时间范围会扫描全部分区）。
        服务层需保证 startTime 非空（默认查近 12 个月）。
    -->
    <select id="selectByOperatorId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM ydsz_flow_audit_log
        WHERE operator_id = #{operatorId}
          AND operated_at &gt;= #{startTime}
          <if test="endTime != null">AND operated_at &lt;= #{endTime}</if>
          AND status = 'ENABLED'
          AND deleted = 0
        ORDER BY operated_at DESC, id DESC
    </select>

    <!--
        查某目标人（转办/委派/加签目标）的审计日志（P1-8: 加签历史查询）
        P3: 同 selectByOperatorId，强制时间范围防跨分区扫描。
    -->
    <select id="selectByTargetId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM ydsz_flow_audit_log
        WHERE target_id = #{targetId}
          AND operated_at &gt;= #{startTime}
          <if test="endTime != null">AND operated_at &lt;= #{endTime}</if>
          AND status = 'ENABLED'
          AND deleted = 0
        ORDER BY operated_at DESC, id DESC
    </select>

    <!--
        P1-8: 分页查询流程实例的加签历史记录
        按 action IN (加签动作列表) + instance_id 过滤，支持 LIMIT/OFFSET 分页
    -->
    <select id="selectCountersignByInstance" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM ydsz_flow_audit_log
        WHERE instance_id = #{instanceId}
          AND action IN
          <foreach collection="actions" item="action" open="(" separator="," close=")">
              #{action}
          </foreach>
          AND status = 'ENABLED'
          AND deleted = 0
        ORDER BY operated_at DESC, id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <!-- P1-8: 统计流程实例的加签历史记录总数 -->
    <select id="countCountersignByInstance" resultType="long">
        SELECT COUNT(1)
        FROM ydsz_flow_audit_log
        WHERE instance_id = #{instanceId}
          AND action IN
          <foreach collection="actions" item="action" open="(" separator="," close=")">
              #{action}
          </foreach>
          AND status = 'ENABLED'
          AND deleted = 0
    </select>
</mapper>
