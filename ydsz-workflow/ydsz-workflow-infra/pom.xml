<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.njydsz</groupId>
        <artifactId>ydsz-workflow</artifactId>
        <version>26.10.01-SNAPSHOT</version>
    </parent>
    <artifactId>ydsz-workflow-infra</artifactId>
    <name>ydsz-workflow-infra</name>
    <description>DDD Module</description>
    <dependencies>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-workflow-domain</artifactId>
        </dependency>
        <!-- ydsz-common-jdbc: MpBaseEntity 基类（FlowInstance 等实体继承） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-jdbc</artifactId>
        </dependency>
        <!-- ydsz-common-event: 领域事件经 common-event Outbox 门面统一发布（ADR-009，禁自建 Outbox） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-event</artifactId>
        </dependency>
        <!-- ydsz-common-util: HttpAgentServiceClient 经 RestTemplateUtils 统一构建（P2-3 整改） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-util</artifactId>
        </dependency>
        <!-- mybatis-plus-annotation: @TableName/@TableField 注解 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-annotation</artifactId>
        </dependency>
        <!-- swagger-annotations-jakarta: @JsonView 等注解 -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
        </dependency>
        <!-- mapstruct (provided): 注入 domain 层 @Mapper 接口时编译期需解析 ReportingPolicy 枚举值 -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- ydsz-common-auth: 审计字段填充（SecurityUtils.getCurrentUserIdOrNull） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-auth</artifactId>
        </dependency>
        <!-- ydzs-agent-api: AgentExecuteClient Feign 契约 -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-agent-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- ydzs-agent-domain: AgentExecutionRequestDTO / ChatResponseDTO（provided via agent-api 传递） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-agent-domain</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
