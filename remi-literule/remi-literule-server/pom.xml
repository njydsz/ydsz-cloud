<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.remisoft</groupId>
        <artifactId>remi-literule</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>remi-literule-server</artifactId>
    <name>remi-literule-server</name>
    <description>DDD Module</description>
    <dependencies>
        <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-literule-infra</artifactId>
        </dependency>
        <!-- common-web 传递引入: common-base(→core/util/exception), common-auth, common-safe, common-redis -->
        <!-- common-jdbc 传递引入: common-domain -->
        <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-common-jdbc</artifactId>
        </dependency>
                <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-common-lock</artifactId>
        </dependency>
        <!-- remi-common-cache（规则配置缓存，替代 Caffeine） -->
        <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-common-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-common-feign</artifactId>
        </dependency>
        <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-common-file</artifactId>
        </dependency>
        <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-common-notify</artifactId>
        </dependency>
        <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-common-queue</artifactId>
        </dependency>
        <!-- P0-2: 事务性 Outbox 事件模式 -->
        <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-common-event</artifactId>
        </dependency>
        <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-common-thread</artifactId>
        </dependency>
        <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-common-web</artifactId>
        </dependency>
        <!-- remi-common-core: explicit declaration for direct usage (was transitive via common-web) -->
        <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-common-core</artifactId>
        </dependency>
    
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>
        <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-common-excel</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- P1-1 多级缓存 L2 + 分布式注册 / 广播依赖 Redisson（强制） -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
        </dependency>
        <!-- P1-2: 规则与定时任务联动（正式依赖，Feign 客户端 + FallbackFactory 降级）-->
        <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-cronjob-api</artifactId>
        </dependency>
        <!-- P2-1: 规则与工作流深度联动（正式依赖，Feign 客户端 + FallbackFactory 降级）-->
        <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-workflow-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
            <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-common-json</artifactId>
        </dependency>
        <!-- P0-1: 统一监控告警（Sentry SPI：ELK/Loki 日志推送 + 告警收敛 + SLA） -->
        <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-common-sentry</artifactId>
        </dependency>
        <!-- P1-6: 搜索 Provider SPI（规则定义搜索） -->
        <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-common-search</artifactId>
        </dependency>
        <!-- P0-3: 多租户隔离 -->
        <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-common-tenant</artifactId>
        </dependency>
</dependencies>
</project>
