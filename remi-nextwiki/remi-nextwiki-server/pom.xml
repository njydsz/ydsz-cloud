<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.remisoft</groupId>
        <artifactId>remi-nextwiki</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>remi-nextwiki-server</artifactId>
    <name>remi-nextwiki-server</name>
    <description>Application Layer - 应用服务编排、异步管线、事件监听</description>
    <dependencies>
        <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-nextwiki-infra</artifactId>
        </dependency>
        <!-- common-web 传递引入: common-base(->core/util/exception), common-auth, common-safe, common-redis -->
        <!-- common-jdbc 传递引入: common-domain -->
        <!-- common-feign 传递引入: spring-cloud-starter-openfeign -->
        <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-common-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-common-lock</artifactId>
        </dependency>
        <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-common-feign</artifactId>
        </dependency>
        <!-- P1-3: 跨模块 Feign 客户端（用户信息查询） -->
        <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-userinfo-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-common-file</artifactId>
        </dependency>
        <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-common-docs</artifactId>
        </dependency>
        <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-common-notify</artifactId>
        </dependency>
        <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-common-queue</artifactId>
        </dependency>
        <!-- P0-2: 事务性 Outbox 事件模式 -->
        <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-common-event</artifactId>
        </dependency>
        <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-common-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-common-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-common-thread</artifactId>
        </dependency>
        <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-common-search</artifactId>
        </dependency>
        <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-common-excel</artifactId>
        </dependency>
        <!-- dynamic-datasource（@DS 注解，common-jdbc 中标记为 optional） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>dynamic-datasource-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
        </dependency>
        <!-- commons-codec（DigestUtils 签名/摘要工具类，替代 hutool-all） -->
        <dependency>
            <groupId>commons-codec</groupId>
            <artifactId>commons-codec</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-health</artifactId>
        </dependency>
            <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-common-json</artifactId>
        </dependency>
        <!-- P0-1: 统一监控告警（Sentry SPI：ELK/Loki 日志推送 + 告警收敛 + SLA） -->
        <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-common-sentry</artifactId>
        </dependency>
        <!-- P0-2: 多租户隔离 -->
        <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-common-tenant</artifactId>
        </dependency>

        <!-- ==================== 测试依赖 ==================== -->
        <!-- common-core test-jar（AbstractIntegrationTest 基类） -->
        <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-common-core</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
