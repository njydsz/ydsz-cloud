      "description": "Global CORS configurations"
    },
    {
      "name": "spring.cloud.gateway.default-filters",
      "type": "java.util.List<org.springframework.cloud.gateway.filter.FilterDefinition>",
      "description": "Default filters"
    },
    {
      "name": "spring.cloud.gateway.httpclient.websocket.max-frame-payload-length",
      "type": "java.lang.Integer",
      "description": "WebSocket max frame payload length"
    },
    {
      "name": "remi.gateway.security-headers.enabled",
      "type": "java.lang.Boolean",
      "description": "Enable security response headers (global switch)."
    },
    {
      "name": "remi.gateway.security-headers.csp.enabled",
      "type": "java.lang.Boolean",
      "description": "Enable Content-Security-Policy header."
    },
    {
      "name": "remi.gateway.security-headers.csp.unsafe-eval",
      "type": "java.lang.Boolean",
      "description": "Allow unsafe-eval in CSP (development only, must be false in production)."
    },
    {
      "name": "remi.gateway.security-headers.hsts.enabled",
      "type": "java.lang.Boolean",
      "description": "Enable Strict-Transport-Security header."
    },
    {
      "name": "remi.gateway.security-headers.hsts.max-age",
      "type": "java.lang.Long",
      "description": "HSTS max-age in seconds (default: 31536000 = 1 year)."
    },
    {
      "name": "remi.gateway.security-headers.hsts.include-subdomains",
      "type": "java.lang.Boolean",
      "description": "Include subdomains in HSTS."
    },
    {
      "name": "remi.gateway.security-headers.hsts.preload",
      "type": "java.lang.Boolean",
      "description": "Enable HSTS preload."
    },
    {
      "name": "remi.gateway.security-headers.coop.enabled",
      "type": "java.lang.Boolean",
      "description": "Enable Cross-Origin-Opener-Policy header."
    },
    {
      "name": "remi.gateway.security-headers.coop.policy",
      "type": "java.lang.String",
      "description": "COOP policy: same-origin | same-origin-allow-popups | unsafe-none."
    },
    {
      "name": "remi.gateway.security-headers.coep.enabled",
      "type": "java.lang.Boolean",
      "description": "Enable Cross-Origin-Embedder-Policy header."
    },
    {
      "name": "remi.gateway.security-headers.coep.policy",
      "type": "java.lang.String",
      "description": "COEP policy: require-corp | credentialless | unsafe-none."
    },
    {
      "name": "remi.gateway.security-headers.corp.enabled",
      "type": "java.lang.Boolean",
      "description": "Enable Cross-Origin-Resource-Policy header."
