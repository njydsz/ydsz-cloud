      "type": "java.lang.Boolean",
      "description": "Enable discovery locator"
    },
    {
      "name": "spring.cloud.gateway.discovery.locator.lower-case-service-id",
      "type": "java.lang.Boolean",
      "description": "Lower case service id"
    },
    {
