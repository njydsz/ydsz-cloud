<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.njydsz</groupId>
        <artifactId>ydsz-message</artifactId>
        <version>26.09.01-SNAPSHOT</version>
    </parent>
    <artifactId>ydsz-message-infra</artifactId>
    <name>ydsz-message-infra</name>
    <description>DDD Module</description>
    <dependencies>
    <!-- 显式声明：本模块源码直接使用该公共能力（原先仅经传递依赖获得，P1-5 整改） -->
    <dependency>
        <groupId>com.njydsz</groupId>
        <artifactId>ydsz-common-core</artifactId>
    </dependency>

    <!-- 显式声明：本模块源码直接使用该公共能力（原先仅经传递依赖获得，P1-5 整改） -->
    <dependency>
        <groupId>com.njydsz</groupId>
        <artifactId>ydsz-common-domain</artifactId>
    </dependency>

    <!-- ydsz-common-util: MpIdGenerator 委托 SnowflakeIdGenerator（ADR-008，禁直连 MP IdWorker） -->
    <dependency>
        <groupId>com.njydsz</groupId>
        <artifactId>ydsz-common-util</artifactId>
    </dependency>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-message-domain</artifactId>
        </dependency>
        <!-- MyBatis-Plus（Entity 使用 @TableName注解、Mapper 继承 BaseMapper） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <!-- ydsz-common-jdbc（MpBaseEntity / MpBaseIdEntity 基类） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-jdbc</artifactId>
        </dependency>
        <!-- mapstruct (provided): 注入 domain 层 @Mapper 接口时编译期需解析 ReportingPolicy 枚举值 -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <scope>provided</scope>
        </dependency>
            <!-- 单元测试基础设施：JUnit 5 + AssertJ + Mockito（云顶编码规范 §14.1） -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- JUnit Jupiter Params（@ParameterizedTest 支持，修复 TemplateInvocationValidationException） -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency></dependencies>
</project>
