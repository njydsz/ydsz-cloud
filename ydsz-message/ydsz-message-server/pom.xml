<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.njydsz</groupId>
        <artifactId>ydsz-message</artifactId>
        <version>26.09.01-SNAPSHOT</version>
    </parent>
    <artifactId>ydsz-message-server</artifactId>
    <name>ydsz-message-server</name>
    <description>DDD Module</description>

    <!-- P2-5 冗余 DM 已移除：fastjson2 版本统一由根 pom dependencyManagement 管理
         （${fastjson2.version}=2.0.62，解决 rocketmq 传递依赖的版本收敛），子模块无需重复声明 -->

    <dependencies>
        <!-- P1-2: 遵循 DDD 分层，server 层不直接依赖 infra 层；infra 实现由 web/app 层通过组件扫描注入 -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-message-domain</artifactId>
        </dependency>
        <!-- P2-3: 显式声明 common-util（多渠道发送使用 FileTypeUtils/DateUtils 等工具类） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-util</artifactId>
        </dependency>
        <!-- common-web 传递引入: common-base(→core/util/exception), common-auth, common-safe, common-redis -->
        <!-- common-jdbc 传递引入: common-domain -->
        <!-- P1-A1: 显式声明 common-auth（使用 @AuthApiPermission / AuthContextUtils 等能力） -->
        <!-- ydsz-common-domain: explicit declaration for direct usage (PageQuery/BaseStatusEnum, was transitive via common-jdbc) -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-domain</artifactId>
        </dependency>
        <!-- common-feign 传递引入: spring-cloud-starter-openfeign -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-lock</artifactId>
        </dependency>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-feign</artifactId>
        </dependency>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-notify</artifactId>
        </dependency>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-queue</artifactId>
        </dependency>
        <!-- P0-5: TCP 推送通道依赖 common-netty -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-netty</artifactId>
        </dependency>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-web</artifactId>
        </dependency>
        <!-- ydsz-common-core: explicit declaration for direct usage (was transitive via common-web) -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-core</artifactId>
        </dependency>
        <!-- P1-FIX: 显式声明 common-json（OutboxDomainEventPublisher/MessageTransactionListener 使用 JsonMapper） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-json</artifactId>
        </dependency>

        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-thread</artifactId>
        </dependency>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-message-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-spring-boot-starter</artifactId>
            <exclusions>
                <!-- rocketmq-acl 传递依赖 commons-validator→commons-beanutils→commons-collections:3.2.2（已禁止） -->
                <exclusion>
                    <groupId>commons-validator</groupId>
                    <artifactId>commons-validator</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- spring-boot-starter-websocket -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <!-- ydsz-common-socket -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-socket</artifactId>
        </dependency>
        <!-- Redisson 分布式锁/限流（ydsz-common-lock 声明为 optional，此处显式引入） -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
        </dependency>

        <!-- P0-1: 统一监控告警（Sentry SPI：ELK/Loki 日志推送 + 告警收敛 + SLA） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-sentry</artifactId>
        </dependency>
        <!-- 通道熔断：ydsz-common-safe + Resilience4j（ChannelRouter 直接 import Resilience4j） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-safe</artifactId>
        </dependency>
        <!-- Resilience4j 核心熔断能力（ChannelRouter 直接 import） -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-circuitbreaker</artifactId>
        </dependency>
        <!-- P1-3: 事务性 Outbox 事件模式 -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-event</artifactId>
        </dependency>
        <!-- P1-3: 搜索 Provider SPI（消息搜索） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-search</artifactId>
        </dependency>
        <!-- P2: JdbcHealthIndicator 自动注册（需要 actuator 在 classpath 上） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- P1-1: FreeMarker 模板引擎（替代自研引擎作为默认实现） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-freemarker</artifactId>
        </dependency>
        <!-- ydzs-common-cache：模板 AST 缓存（CachedTemplateEngine 使用 YdszCache） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-cache</artifactId>
        </dependency>
    </dependencies>
</project>
