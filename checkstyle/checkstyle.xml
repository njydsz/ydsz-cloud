<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
    ydsz-cloud 构建期编码规范检查（Checkstyle）

    核心目标：禁止业务代码（src/main）直接 import/使用第三方 JSON 库，
    强制统一使用 ydsz-common-json（com.njydsz.common.json.*）。

    说明：
    - 本配置刻意保持最小化，仅做 JSON 生态红线检查，不做风格/格式检查，
      避免与现有代码风格冲突。
    - 只扫描 src/main（插件配置 includeTestSourceDirectory=false），
      ydsz-common-json 模块自身的 JMH 基准测试（src/test）不受影响。
    - 第三方依赖内部使用 Jackson 不受影响（传递依赖不在检查范围）。
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <!-- 全项目统一错误级别 -->
    <property name="severity" value="error"/>

    <module name="TreeWalker">
        <!--
            禁止 import 第三方 JSON 库：
            - com.fasterxml.jackson.*        (Jackson 全家桶)
            - com.alibaba.fastjson.*         (Fastjson 1.x，有安全漏洞)
            - com.alibaba.fastjson2.*        (Fastjson2)
            - com.google.gson.*              (Gson)
            - org.json.*                     (org.json JSONObject/JSONArray)
        -->
        <module name="IllegalImport">
            <property name="illegalPkgs"
                      value="com.fasterxml.jackson,com.alibaba.fastjson,com.alibaba.fastjson2,com.google.gson,org.json"/>
        </module>
    </module>
</module>
