<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.njydsz</groupId>
        <artifactId>ydsz-system</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>ydsz-system-server</artifactId>
    <name>ydsz-system-server</name>
    <description>Application Layer - Service + Config + AppInfo</description>
    <dependencies>
        <!-- P1-2: 移除 server 对 infra 的直接依赖，符合 DDD 分层（server 仅依赖 domain，infra 由 web 层引入并通过 Spring 自动装配注入 Repository 实现） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-audit</artifactId>
        </dependency>
        <!-- P0-2: 事务性 Outbox 事件模式 -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-event</artifactId>
        </dependency>
        <!-- P2-3: 配置导入导出（基于 ydsz-common-excel） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-excel</artifactId>
        </dependency>
        <!-- P1-A1: 显式声明 common-auth（使用 @DataScope / @AuthApiPermission 等能力） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-auth</artifactId>
        </dependency>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-web</artifactId>
        </dependency>
        <!-- ydsz-common-core: explicit declaration for direct usage (was transitive via common-web) -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-core</artifactId>
        </dependency>
        <!-- ydsz-common-util: ServletUtils.getClientIp 用于客户端 IP 解析 -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-util</artifactId>
        </dependency>

        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-config</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>dynamic-datasource-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-health</artifactId>
        </dependency>
        <!-- P0-1: 统一监控告警（Sentry SPI：ELK/Loki 日志推送 + 告警收敛 + SLA） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-sentry</artifactId>
        </dependency>
        <!-- P2-2: 通知渠道（配置变更/字典变更通知）—— 预留，待实现时引入 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-redis</artifactId>
        </dependency>
        <!-- P0-3: 统一 IP 访问控制（替代自建 InternalApiIpFilter，获得 CIDR + Redis + 自动封禁能力） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-safe</artifactId>
        </dependency>
        <!-- P0-3: RedisStringOps（IpAccessService 依赖） -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-redis</artifactId>
        </dependency>
        <!-- P0-2: 多租户隔离 -->
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-common-tenant</artifactId>
        </dependency>
        <!-- P1-6: 单元测试（JUnit 5 + Mockito + AssertJ，见《云顶编码规范》第 13 章） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.njydsz</groupId>
            <artifactId>ydsz-system-domain</artifactId>
        </dependency>
    </dependencies>
</project>
