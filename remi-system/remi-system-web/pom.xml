<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.remisoft</groupId>
        <artifactId>remi-system</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>remi-system-web</artifactId>
    <name>remi-system-web</name>
    <description>Web Layer - REST Controller + Bootstrap</description>
    <dependencies>
        <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-system-server</artifactId>
        </dependency>
        <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-common-web</artifactId>
        </dependency>
        <!-- remi-common-core: explicit declaration for direct usage (was transitive via common-web) -->
        <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-common-core</artifactId>
        </dependency>
    
        <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-system-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-system-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.remisoft</groupId>
            <artifactId>remi-common-audit</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bootstrap</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <configuration>
                            <classifier>exec</classifier>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
